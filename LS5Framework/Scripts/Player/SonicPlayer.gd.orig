		_anim_module.request_walk_stop()

# ===========================================================
# DEBUG
# ===========================================================
func _debug_inputs(physics_up: Vector3) -> void:
	if Input.is_action_just_pressed("debug_add_up"):
		var up: Vector3 = physics_up.normalized()
		if up.length() < 0.001 or not debug_add_up_use_physics_up:
			up = Vector3.UP

		var delta_v: Vector3 = up * debug_add_up_speed
		velocity += delta_v

		print("DEBUG: +up velocity ", delta_v, " | new velocity = ", velocity)

func _debug_draw() -> void:
	var up: Vector3 = visual_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	var origin: Vector3 = global_transform.origin + up * 0.5

	#DebugDraw3d.arrow(origin, origin + surface_normal, Color(1.0, 0.0, 0.0, 1.0))
	#DebugDraw3d.arrow(origin, origin + _prev_surface_normal, Color(1.0, 0.5, 0.0, 1.0))
	#DebugDraw3d.arrow(origin, origin + visual_up, Color(0.0, 1.0, 0.0, 1.0))
	#DebugDraw3d.arrow(origin, origin + velocity * 0.1, Color(0.0, 0.5, 1.0, 1.0))

	if _debug_visible and _rail_active and _rail_switch_candidate != null:
		var candidate_color := Color(1.0, 0.8, 0.0, 1.0)
		DebugDraw3d.line(origin, _rail_switch_candidate_point, candidate_color)
		if _rail_switch_candidate_tangent.length() > 0.001:
			var cand_dir := _rail_switch_candidate_tangent.normalized()
			DebugDraw3d.arrow(_rail_switch_candidate_point, _rail_switch_candidate_point + cand_dir, candidate_color)

	if _debug_visible:
		_debug_draw_drift_guides(origin, up)
		_debug_draw_wall_input_projection(origin, up)
	
	if not control_anchor:
		return

	var f = -control_anchor.global_transform.basis.z
	var u = control_anchor.global_transform.basis.y

	var forward_angle = rad_to_deg(atan2(f.x, f.z))
	var up_pitch = rad_to_deg(acos(Vector3.UP.dot(u)))

	var msg = "ForwardYaw = %.2f°\nUpTilt = %.2f°" % [forward_angle, up_pitch]

	if camera != null:
		var cam_forward: Vector3 = -camera.global_transform.basis.z
		#DebugDraw3d.arrow(origin, origin + cam_forward, Color(1.0, 1.0, 0.0, 1.0))

	if model_root != null:
		var model_basis: Basis = model_root.global_transform.basis
		var model_forward: Vector3 = -model_basis.z
		var model_origin: Vector3 = model_root.global_transform.origin + up * 0.5
		#DebugDraw3d.arrow(model_origin, model_origin + model_forward, Color(1.0, 0.0, 1.0, 1.0))

	#if _follow_ray_origin != _follow_ray_target:
		#DebugDraw3d.line(_follow_ray_origin, _follow_ray_target, Color(0.0, 1.0, 1.0, 1.0))

	if _debug_label != null and _debug_visible:
		var state_str: String = "ATTACHED"
		if not attached:
			state_str = "AIRBORNE"
		elif _is_skidding:
			state_str = "SKID"

		var spd: float = velocity.length()

		# Show “YES” only while the timer > 0
		var radial_str: String = "YES" if _dbg_radial_hit_timer > 0.0 else "no"

		# Detach info only while timer > 0
		var detach_str: String = "RECENT" if _dbg_detach_timer > 0.0 else "none"
		var filtered_str: String = "YES" if _dbg_last_detach_used_filtered else "no"
		var from_floor_str: String = "YES" if _dbg_last_detach_from_floor_like else "no"
		var coyote_eligible_str: String = "YES" if _dbg_last_detach_coyote_eligible else "no"
		var surf_kind_str: String = "FLOOR" if _dbg_surface_is_floor_like else "NON-FLOOR"

		_debug_label.text = ""
		_debug_label.text += "STATE: %s\n" % state_str
		var ability_str: String = "none"
		if _current_action_id != &"":
			ability_str = String(_current_action_id)
		var attacking_str: String = "YES" if is_attack_active() else "no"
		_debug_label.text += "ABILITY: %s  ATTACKING: %s\n" % [ability_str, attacking_str]
		_debug_label.text += "SPD:   %.1f\n" % spd
		_debug_label.text += "NΔ:    %.1f°\n" % _normal_delta_angle_deg
		_debug_label.text += "\n"

		_debug_label.text += "SURF ANGLE: %.1f°  (%s)\n" % [
			_dbg_surface_angle_deg,
			surf_kind_str
		]
		
		_debug_label.text += "\n"

		_debug_label.text += "--- RADIAL ---\n"
		_debug_label.text += "Hit:   %s\n" % radial_str
		_debug_label.text += "Angle: %.1f°\n" % _dbg_radial_angle
		_debug_label.text += "Into:  %.1f\n" % _dbg_radial_into_speed
		_debug_label.text += "Tang:  %.1f\n" % _dbg_radial_tangent_speed
		_debug_label.text += "\n"
		
		_debug_label.text += "Adhesion: tan=%.1f  req=%.1f\n" % [
			_dbg_current_adhesion_speed,
			_dbg_required_adhesion_speed
		]

		_debug_label.text += "\n"

		_debug_label.text += "--- DETACH ---\n"
		_debug_label.text += "Recent:   %s\n" % detach_str
		_debug_label.text += "FromFloor:%s\n" % from_floor_str
		_debug_label.text += "Coyote:   %s\n" % coyote_eligible_str
		_debug_label.text += "WorldAng: %.1f°\n" % _dbg_last_detach_world_angle
		_debug_label.text += "StepAng:  %.1f°\n" % _dbg_last_detach_step_angle
		_debug_label.text += "Filtered: %s\n" % filtered_str

		_debug_label.text += "\n"
		_debug_label.text += "--- DETACH CTRL ---\n"
		var lock_str: String = "YES" if _directional_influence_lock_strength > 0.0 else "no"
		_debug_label.text += "Active: %s  SpdT: %.2f\n" % [
			lock_str,
			_directional_influence_lock_speed_t
		]
		_debug_label.text += "Str: A %.2f  T %.2f  P %.2f\n" % [
			_directional_influence_lock_accel_strength,
			_directional_influence_lock_turn_strength,
			_directional_influence_lock_air_turn_penalty_strength
		]
		_debug_label.text += "Mul: A %.2f  T %.2f  P %.2f\n" % [
			_directional_influence_lock_accel_multiplier,
			_directional_influence_lock_turn_multiplier,
			_directional_influence_lock_air_turn_penalty_multiplier
		]
		_debug_label.text += "Delay: A %.2f  T %.2f  P %.2f\n" % [
			_directional_influence_lock_accel_delay_timer,
			_directional_influence_lock_turn_delay_timer,
			_directional_influence_lock_air_turn_penalty_delay_timer
		]

		_debug_label.text += "\n"

		_debug_label.text += "--- VISUAL ROT ---\n"
		var vis_up: Vector3 = visual_up.normalized()
		if vis_up.length() < 0.001:
			vis_up = Vector3.UP
		_debug_label.text += "VisUp:   (%.2f, %.2f, %.2f)\n" % [vis_up.x, vis_up.y, vis_up.z]

		var model_fwd: Vector3 = _model_forward
		_debug_label.text += "ModelF:  (%.2f, %.2f, %.2f)\n" % [model_fwd.x, model_fwd.y, model_fwd.z]

		var yaw_ref: Vector3 = _air_torque_yaw_forward
		_debug_label.text += "YawRef:  (%.2f, %.2f, %.2f)\n" % [yaw_ref.x, yaw_ref.y, yaw_ref.z]

		var yaw_vis: Vector3 = _air_torque_visual_forward
		_debug_label.text += "YawVis:  (%.2f, %.2f, %.2f)\n" % [yaw_vis.x, yaw_vis.y, yaw_vis.z]

		var land_align_str: String = "no"
		if _air_landing_align_active:
			land_align_str = "YES"
		_debug_label.text += "LandAlign: %s  ramp=%.2f  t=%.2f\n" % [
			land_align_str,
			_air_landing_align_ramp,
			_air_landing_align_time_to_impact
		]
		if _air_landing_align_active:
			var land_n: Vector3 = _air_landing_align_normal
			_debug_label.text += "LandN:  (%.2f, %.2f, %.2f)\n" % [
				land_n.x,
				land_n.y,
				land_n.z
			]

		_debug_label.text += "\n"
		_debug_label.text += "--- AIR TORQUE ---\n"
		_debug_label.text += "NΔ: %.2f°  Mem: %.3f\n" % [
			_dbg_air_torque_normal_angle_deg,
			_airborne_torque_yaw_turn_speed_memory_timer
		]
		_debug_label.text += "Axis: (%.2f, %.2f, %.2f)\n" % [
			_dbg_air_torque_axis.x,
			_dbg_air_torque_axis.y,
			_dbg_air_torque_axis.z
		]
		_debug_label.text += "Move: (%.2f, %.2f, %.2f)\n" % [
			_dbg_air_torque_move_dir.x,
			_dbg_air_torque_move_dir.y,
			_dbg_air_torque_move_dir.z
		]
		_debug_label.text += "SurfΩ: %.1f  YawΩ: %.1f  AvgΩ: %.1f\n" % [
			rad_to_deg(_dbg_air_torque_surface_omega.length()),
			rad_to_deg(_dbg_air_torque_yaw_omega.length()),
			rad_to_deg(_dbg_air_torque_avg_omega.length())
		]
		_debug_label.text += "SeedΩ: %.1f  LiveΩ: %.1f\n" % [
			rad_to_deg(_dbg_air_torque_seed_omega.length()),
			rad_to_deg(_air_torque_angular_velocity.length())
		]

		if model_root != null:
			var model_basis: Basis = model_root.global_transform.basis
			var model_up: Vector3 = model_basis.y
			var model_euler: Vector3 = model_basis.get_euler()
			var model_pitch_deg: float = rad_to_deg(model_euler.x)
			var model_yaw_deg: float = rad_to_deg(model_euler.y)
			var model_roll_deg: float = rad_to_deg(model_euler.z)
			_debug_label.text += "ModelUp: (%.2f, %.2f, %.2f)\n" % [
				model_up.x,
				model_up.y,
				model_up.z
			]
			_debug_label.text += "Euler(P/Y/R): %.1f / %.1f / %.1f\n" % [
				model_pitch_deg,
				model_yaw_deg,
				model_roll_deg
			]
		
		_debug_label.text += "Attached: " + str(attached)

		_debug_label.text += "\n--- WATER ---\n"
		var water_state_str: String = "none"
		if _running_on_water_surface:
			water_state_str = "SURFACE"
		elif _fully_submerged:
			water_state_str = "SUBMERGED"
		elif _in_water_volume:
			water_state_str = "PARTIAL"
		_debug_label.text += "State:  %s (body:%s head:%s)\n" % [water_state_str, _in_water_volume, _head_in_water_volume]
		_debug_label.text += "FullSub: %s  Cooldown: %.2f\n" % [_fully_submerged, _water_reattach_cooldown_timer]
		_debug_label.text += "FootstepTimer: %.2f / %.2f\n" % [_water_footstep_timer, water_footstep_max_time]
		_debug_label.text += "Enabled: %s\n" % water_physics_enabled

		_debug_label.text += "\n--- FOOTSTEP ---\n"
		if _audio_module != null:
			_debug_surface_probe_timer = max(_debug_surface_probe_timer - get_process_delta_time(), 0.0)
			if _debug_surface_probe_timer <= 0.0:
				_audio_module.debug_update_surface_probe(ground_ray)
				_debug_surface_probe_timer = 0.2
			_debug_label.text += "Surface: %s\n" % _audio_module._dbg_last_surface_type
			_debug_label.text += "Name:    %s\n" % (_audio_module._dbg_last_surface_name if _audio_module._dbg_last_surface_name != "" else "(none)")
			_debug_label.text += "Checked: %s\n" % (_audio_module._dbg_last_surface_candidates if _audio_module._dbg_last_surface_candidates != "" else "(none)")
		else:
			_debug_label.text += "Audio module missing\n"

		if anim_state != null:
			_debug_label.text += "\nANIM STATE: %s\n" % str(anim_state.get_current_node())
			_debug_label.text += "ANIM POS:   %.3f / %.3f\n" % [
				anim_state.get_current_play_position(),
				anim_state.get_current_length()
			]
			if anim_tree != null:
				_debug_label.text += "ANIM SCALE:%s\n" % str(anim_tree.get("parameters/MoveTimeScale/scale"))
				if _rail_active and _anim_param_exists("parameters/StateMachine/RAIL/blend_position"):
					_debug_label.text += "RAIL BLEND:%s\n" % str(
						anim_tree.get("parameters/StateMachine/RAIL/blend_position")
					)
		_debug_label.text = _format_debug_columns(_debug_label.text)
			
func _debug_draw_drift_guides(origin: Vector3, up: Vector3) -> void:
	if not drift_debug_guides_enabled:
		return
	if not _drift_active:
		return
	var guide_length: float = max(drift_debug_guide_length, 0.1)
	var guide_up: Vector3 = up.normalized()
	if guide_up.length() < 0.001:
		guide_up = Vector3.UP

	var lateral: Vector3 = velocity - guide_up * velocity.dot(guide_up)
	if lateral.length() < 0.001:
		lateral = _model_forward - guide_up * _model_forward.dot(guide_up)
	if lateral.length() < 0.001:
		return
	var forward_dir: Vector3 = lateral.normalized()
	var side_value: float = clamp(_drift_direction_value, -1.0, 1.0)
	var committed_dir: Vector3 = forward_dir.rotated(guide_up, deg_to_rad(35.0) * side_value).normalized()
	var counter_side: int = -_drift_direction
	var counter_dir: Vector3 = forward_dir
	if counter_side != 0:
		counter_dir = forward_dir.rotated(guide_up, deg_to_rad(35.0) * float(counter_side)).normalized()

	DebugDraw3d.arrow(origin, origin + forward_dir * guide_length, Color(0.0, 0.8, 1.0, 1.0))
	DebugDraw3d.arrow(origin + guide_up * 0.2, origin + guide_up * 0.2 + committed_dir * guide_length * 0.85, Color(0.2, 1.0, 0.25, 1.0))
	DebugDraw3d.arrow(origin + guide_up * 0.4, origin + guide_up * 0.4 + counter_dir * guide_length * 0.65, Color(1.0, 0.45, 0.1, 1.0))

	var preview_turn_deg: float = _drift_turn_deg_per_sec_current
	if abs(preview_turn_deg) < 0.001:
		preview_turn_deg = drift_base_turn_deg_per_sec * side_value
	var total_rad: float = deg_to_rad(preview_turn_deg) * 0.75
	var segments: int = max(drift_debug_arc_segments, 1)
	var previous_point: Vector3 = origin + forward_dir * guide_length * 0.75
	for i in range(1, segments + 1):
		var t: float = float(i) / float(segments)
		var arc_dir: Vector3 = forward_dir.rotated(guide_up, total_rad * t).normalized()
		var next_point: Vector3 = origin + arc_dir * guide_length * 0.75
		DebugDraw3d.line(previous_point, next_point, Color(1.0, 0.9, 0.1, 1.0))
		previous_point = next_point

	var right_dir: Vector3 = forward_dir.cross(guide_up)
	if right_dir.length() < 0.001:
		return
	right_dir = right_dir.normalized()
	var reward_t: float = clamp(_drift_reward_progress, 0.0, 1.0)
	var reward_origin: Vector3 = origin - right_dir * guide_length * 0.5 + guide_up * 0.6
	var reward_end: Vector3 = reward_origin + right_dir * guide_length * reward_t
	DebugDraw3d.line(reward_origin, reward_origin + right_dir * guide_length, Color(0.25, 0.25, 0.25, 1.0))
	DebugDraw3d.line(reward_origin, reward_end, Color(1.0, 0.85, 0.05, 1.0))


func _debug_draw_wall_input_projection(origin: Vector3, up: Vector3) -> void:
	if not _wall_input_projection_active and not _wall_input_push_active:
		return
	if _wall_input_debug_normal.length() < 0.001:
		return

	var guide_up: Vector3 = up.normalized()
	if guide_up.length() < 0.001:
		guide_up = Vector3.UP

	var guide_origin: Vector3 = origin + guide_up * 0.35
	var guide_length: float = 1.25
	var raw_dir: Vector3 = _wall_input_debug_raw_dir
	var projected_dir: Vector3 = _wall_input_debug_projected_dir
	var normal_dir: Vector3 = _wall_input_debug_normal

	if raw_dir.length() > 0.001:
		raw_dir = raw_dir.normalized()
		DebugDraw3d.arrow(guide_origin, guide_origin + raw_dir * guide_length, Color(1.0, 0.35, 0.1, 1.0))
	if projected_dir.length() > 0.001:
		projected_dir = projected_dir.normalized()
		var projected_origin: Vector3 = guide_origin + guide_up * 0.18
		DebugDraw3d.arrow(projected_origin, projected_origin + projected_dir * guide_length, Color(0.1, 0.9, 1.0, 1.0))
	if normal_dir.length() > 0.001:
		normal_dir = normal_dir.normalized()
		var normal_origin: Vector3 = guide_origin + guide_up * 0.36
		DebugDraw3d.arrow(normal_origin, normal_origin + normal_dir * 0.75, Color(1.0, 0.1, 0.25, 1.0))


func _format_debug_columns(raw_text: String) -> String:
	var viewport_size: Vector2 = get_viewport().get_visible_rect().size
	var font_size: int = _debug_label.get_theme_font_size("font_size")
	if font_size <= 0:
		font_size = 14
	var line_height: int = max(font_size + 2, 10)
	var max_lines: int = max(int((viewport_size.y - 20.0) / float(line_height)), 8)
	var raw_lines: PackedStringArray = raw_text.split("\n")
	if raw_lines.size() <= max_lines:
		return raw_text

	var columns: Array[PackedStringArray] = []
	var index: int = 0
	while index < raw_lines.size():
		var column: PackedStringArray = PackedStringArray()
		for _i in range(max_lines):
			if index >= raw_lines.size():
				break
			column.append(raw_lines[index])
			index += 1
		columns.append(column)

	var widths: Array[int] = []
	for column in columns:
		var width: int = 0
		for line in column:
			width = max(width, line.length())
		widths.append(width)

	var formatted_lines: PackedStringArray = PackedStringArray()
	for row in range(max_lines):
		var line_parts: PackedStringArray = PackedStringArray()
		for col in range(columns.size()):
			var text: String = ""
			if row < columns[col].size():
				text = columns[col][row]
			if col < columns.size() - 1:
				text = text.rpad(widths[col] + 6)
			line_parts.append(text)
		formatted_lines.append("".join(line_parts).rstrip(" "))

	return "\n".join(formatted_lines)

func _debug_draw_control_anchor() -> void:
	if not _debug_visible or _debug_label == null:
		return
	if not control_anchor:
		return

	var origin = control_anchor.global_position

	# Forward (-Z)  → BLUE
	var f = -control_anchor.global_transform.basis.z * 1.5
	# Right (+X)    → RED
	var r = control_anchor.global_transform.basis.x * 1.5
	# Up (+Y)       → GREEN
	var u = control_anchor.global_transform.basis.y * 1.5

	DebugDraw3d.arrow(origin, origin + f, Color.CORAL)
	DebugDraw3d.arrow(origin, origin + r, Color.RED)
	DebugDraw3d.arrow(origin, origin + u, Color.GREEN)

