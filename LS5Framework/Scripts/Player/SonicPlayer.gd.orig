# Ability system

# ===========================================================
# BARRIER BLAST
# ===========================================================
var _barrier_blast_gauge: float = 0.0
var _barrier_blast_active: bool = false
var _barrier_blast_was_full: bool = false
var _barrier_blast_deplete_grace_timer: float = 0.0
var _barrier_blast_full_land_exit_grace_timer: float = 0.0

func is_barrier_blast_active() -> bool:
	return _barrier_blast_active


func _get_hud_node() -> Node:
	_ensure_modules()
	if _ui_module != null:
		return _ui_module._get_hud_node()
	return null

func _set_special_gauge_ui(fraction: float) -> void:
	if _ui_module != null:
		_ui_module._set_special_gauge_ui(fraction)

func _set_flight_gauge_ui(current: float, max_value: float, visible: bool) -> void:
	if _ui_module != null:
		_ui_module._set_flight_gauge_ui(current, max_value, visible)

func _set_coyote_available_ui(available: bool) -> void:
	if _ui_module != null:
		_ui_module._set_coyote_available_ui(available)

func _cancel_barrier_blast() -> void:
	_barrier_blast_active = false
	_barrier_blast_gauge = 0.0
	_barrier_blast_was_full = false
	_barrier_blast_deplete_grace_timer = 0.0
	_barrier_blast_full_land_exit_grace_timer = 0.0
	_stop_barrier_blast_wind_sfx()
	_set_special_gauge_ui(0.0)

func _update_barrier_blast(delta: float, world_up: Vector3, is_attached_for_movement: bool) -> void:
	if not barrier_blast_enabled:
		if _barrier_blast_active or _barrier_blast_gauge > 0.0:
			_cancel_barrier_blast()
		else:
			_barrier_blast_was_full = false
			_barrier_blast_deplete_grace_timer = 0.0
			_barrier_blast_full_land_exit_grace_timer = 0.0
			_stop_barrier_blast_wind_sfx()
		return

	# Count down the "full gauge landing" exit grace timer every frame to avoid
	# cross-state bleed (for example, landing on a ramp then immediately leaving it).
	if _barrier_blast_full_land_exit_grace_timer > 0.0:
		_barrier_blast_full_land_exit_grace_timer = max(_barrier_blast_full_land_exit_grace_timer - delta, 0.0)

	var speed: float = velocity.length()
	var full_land_exit_grace_active: bool = false
	if is_attached_for_movement and _barrier_blast_gauge >= 1.0:
		full_land_exit_grace_active = _barrier_blast_full_land_exit_grace_timer > 0.0

	if _barrier_blast_active:
		# Only allow exit-speed logic while attached for movement.
		# In air, speed can briefly dip near the apex of a jump, which can
		# cause a full -> not-full -> full flicker on the next landing.
		var allow_exit_speed_check: bool = is_attached_for_movement
		# Do not force the gauge below full immediately after a full-gauge landing.
		# This prevents a full -> not-full -> full flicker on ramp landings where
		# vertical impact speed is high but tangential speed is briefly low.
		if allow_exit_speed_check and not full_land_exit_grace_active and barrier_blast_exit_speed > 0.0 and speed <= barrier_blast_exit_speed:
			_barrier_blast_active = false
			# Avoid immediately re-triggering if the gauge is still full this frame.
			if _barrier_blast_gauge >= 1.0:
				_barrier_blast_gauge = 0.999
		# While active, keep updating the UI from the actual gauge value so depletion is visible.
		_set_special_gauge_ui(_barrier_blast_gauge)
		# Continue into drain logic below so speed-based depletion can happen.

	# Rapidly drain the gauge while below the minimum speed threshold (with grace time).
	var pause_deplete: bool = barrier_blast_pause_deplete_while_spindash and _spindash_charging
	if is_attached_for_movement and barrier_blast_fill_min_speed > 0.0:
		if pause_deplete:
			_barrier_blast_deplete_grace_timer = max(barrier_blast_deplete_grace_time, 0.0)
		elif speed >= barrier_blast_fill_min_speed or _barrier_blast_gauge <= 0.0:
			_barrier_blast_deplete_grace_timer = max(barrier_blast_deplete_grace_time, 0.0)
		elif _barrier_blast_gauge > 0.0:
			_barrier_blast_deplete_grace_timer = max(_barrier_blast_deplete_grace_timer - delta, 0.0)
			if _barrier_blast_deplete_grace_timer <= 0.0:
				_barrier_blast_gauge -= max(barrier_blast_drain_rate_under_min_speed, 0.0) * delta

	# Fill only while grounded/attached-for-movement.
	if is_attached_for_movement and barrier_blast_fill_min_speed > 0.0:
		if speed >= barrier_blast_fill_min_speed:
			var t: float = 1.0
			if barrier_blast_fill_max_speed > barrier_blast_fill_min_speed:
				t = clamp(
					(speed - barrier_blast_fill_min_speed) / (barrier_blast_fill_max_speed - barrier_blast_fill_min_speed),
					0.0,
					1.0
				)

			var fill_rate: float = lerp(barrier_blast_fill_rate_min, barrier_blast_fill_rate_max, t)
			fill_rate = max(fill_rate, 0.0)
			_barrier_blast_gauge += fill_rate * delta

	_barrier_blast_gauge = clamp(_barrier_blast_gauge, 0.0, 1.0)

	var gauge_full: bool = _barrier_blast_gauge >= 1.0
	if gauge_full:
		_barrier_blast_active = true
		_barrier_blast_gauge = 1.0
		_set_special_gauge_ui(1.0)
	else:
		_set_special_gauge_ui(_barrier_blast_gauge)

	var reached_full: bool = gauge_full and not _barrier_blast_was_full
	var is_building: bool = is_attached_for_movement and barrier_blast_fill_min_speed > 0.0
	is_building = is_building and speed >= barrier_blast_fill_min_speed and not gauge_full
	_update_barrier_blast_sfx(speed, is_building, reached_full)
	_barrier_blast_was_full = gauge_full


func _update_barrier_blast_sfx(speed: float, is_building: bool, reached_full: bool) -> void:
	_ensure_modules()
	if _audio_module != null:
		_audio_module.update_barrier_blast_audio(speed, _barrier_blast_gauge, is_building, reached_full)


func _stop_barrier_blast_wind_sfx() -> void:
	_ensure_modules()
	if _audio_module != null:
		_audio_module.stop_barrier_blast_wind()


func _update_puppet_barrier_blast_fx(delta: float) -> void:
	if not barrier_blast_enabled:
		if _barrier_blast_gauge > 0.0 or _barrier_blast_active:
			_barrier_blast_gauge = 0.0
			_barrier_blast_active = false
			_barrier_blast_was_full = false
			_barrier_blast_deplete_grace_timer = 0.0
			_barrier_blast_full_land_exit_grace_timer = 0.0
		_sonic_boom_active = false
		_sonic_boom_was_full = false
		_sonic_boom_timer = 0.0
		_sonic_boom_visible = 0.0
		_stop_barrier_blast_wind_sfx()
		_set_sonic_boom_visibility(0.0, 1.0)
		return

	_barrier_blast_gauge = clamp(_net_target_barrier_blast_gauge, 0.0, 1.0)
	_barrier_blast_active = bool(state_flags & STATE_BARRIER_BLAST)

	var speed: float = velocity.length()
	var gauge_full: bool = _barrier_blast_gauge >= 1.0
	var reached_full: bool = gauge_full and not _barrier_blast_was_full

	var is_building: bool = attached and barrier_blast_fill_min_speed > 0.0
	if is_building:
		is_building = speed >= barrier_blast_fill_min_speed and not gauge_full

	_update_barrier_blast_sfx(speed, is_building, reached_full)
	_barrier_blast_was_full = gauge_full
	_update_sonic_boom_fx(delta)


func _update_speed_wind_sfx() -> void:
	_ensure_modules()
	if _audio_module != null:
		var speed: float = velocity.length()
		_audio_module.update_speed_wind(speed)


func _ensure_sonic_boom_fx() -> void:
	if _sonic_boom_fx_node != null and is_instance_valid(_sonic_boom_fx_node):
		return
	var found: Node = get_node_or_null("SonicBoomFX")
	if found is Node3D:
		_sonic_boom_fx_node = found
		_apply_sonic_boom_materials()
		if _sonic_boom_fx_node.has_method("set_boom_state"):
			_sonic_boom_fx_node.call("set_boom_state", 0.0, 0.0, sonic_boom_color)


func _apply_sonic_boom_materials() -> void:
	_sonic_boom_materials.clear()
	if _sonic_boom_fx_node == null or not is_instance_valid(_sonic_boom_fx_node):
		return

	_ensure_modules()
	var meshes: Array = []
	_collect_mesh_instances(_sonic_boom_fx_node, meshes)

	var shader: Shader = sonic_boom_shader
	if shader == null:
		var loaded: Resource = load("res://LS5Framework/Shaders/SonicBoomFX.gdshader")
		if loaded is Shader:
			shader = loaded
	if shader == null:
		return

	for m in meshes:
		if not (m is MeshInstance3D):
			continue
		var mi: MeshInstance3D = m
		var added_any: bool = false
		var override_mat: Material = mi.material_override
		if override_mat != null:
			if override_mat is ShaderMaterial:
				var shader_override: ShaderMaterial = override_mat
				if shader_override.shader == shader:
					var unique_override: ShaderMaterial = _duplicate_sonic_boom_material(shader_override, shader)
					mi.material_override = unique_override
					_sonic_boom_materials.append(unique_override)
					added_any = true
				else:
					continue
			else:
				continue

		if not added_any:
			var mesh: Mesh = mi.mesh
			if mesh != null:
				var surface_count: int = mesh.get_surface_count()
				for i in range(surface_count):
					var surface_mat: Material = mi.get_surface_override_material(i)
					if surface_mat == null:
						surface_mat = mesh.surface_get_material(i)
					if surface_mat is ShaderMaterial:
						var shader_mat: ShaderMaterial = surface_mat
						if shader_mat.shader == shader:
							var unique_surface: ShaderMaterial = _duplicate_sonic_boom_material(shader_mat, shader)
							mi.set_surface_override_material(i, unique_surface)
							_sonic_boom_materials.append(unique_surface)
							added_any = true

		if not added_any:
			var mat: ShaderMaterial = ShaderMaterial.new()
			mat.shader = shader
			mat.set_shader_parameter("boom_alpha", 0.0)
			mat.set_shader_parameter("boom_progress", 1.0)
			mat.set_shader_parameter("boom_color", sonic_boom_color)
			if sonic_boom_override_material_params:
				mat.set_shader_parameter("boom_max_alpha", sonic_boom_max_alpha)
			mi.material_override = mat
			_sonic_boom_materials.append(mat)

	_sonic_boom_fx_node.visible = false


func _update_sonic_boom_fx(delta: float) -> void:
	if not sonic_boom_enabled:
		_set_sonic_boom_visibility(0.0, 1.0)
		return

	_ensure_sonic_boom_fx()
	if _sonic_boom_fx_node == null or not is_instance_valid(_sonic_boom_fx_node):
		return

	var gauge_full: bool = _barrier_blast_gauge >= 1.0
	if gauge_full and not _sonic_boom_was_full:
		_sonic_boom_active = true
		_sonic_boom_timer = 0.0
	if not gauge_full and _sonic_boom_active:
		_sonic_boom_active = false

	if _sonic_boom_active:
		_sonic_boom_timer += delta
		if _sonic_boom_timer >= sonic_boom_duration:
			_sonic_boom_active = false
			_sonic_boom_timer = sonic_boom_duration

	_sonic_boom_was_full = gauge_full

	var target_visible: float = 0.0
	if _sonic_boom_active and gauge_full:
		target_visible = 1.0

	var fade_speed: float = sonic_boom_fade_out_speed
	if target_visible > _sonic_boom_visible:
		fade_speed = sonic_boom_fade_in_speed
	_sonic_boom_visible = move_toward(_sonic_boom_visible, target_visible, fade_speed * delta)

	var progress: float = 1.0
	if sonic_boom_duration > 0.0:
		var delay: float = max(sonic_boom_progress_delay, 0.0)
		if _sonic_boom_timer <= delay:
			progress = 0.0
		else:
			var denom: float = max(sonic_boom_duration - delay, 0.001)
			progress = clamp((_sonic_boom_timer - delay) / denom, 0.0, 1.0)

	_set_sonic_boom_visibility(_sonic_boom_visible, progress)
	if _sonic_boom_visible > 0.01:
		_update_sonic_boom_orientation(delta)


func _update_jump_dash_trail(delta: float) -> void:
	if jump_dash_trail == null:
		return
	if not jump_dash_trail.has_method("update_trail"):
		return
	if not _network_is_local_authority():
		if jump_dash_trail.has_method("stop_and_clear"):
			jump_dash_trail.call("stop_and_clear")
		return

	var active: bool = rolling
	active = active or _jump_dash_recent_timer > 0.0
	active = active or _homing_active or _homing_post_attack_timer > 0.0
	active = active or _bounce_state != BounceState.NONE

	var head_pos: Vector3 = global_transform.origin
	if model_root != null:
		head_pos = model_root.global_transform.origin
	jump_dash_trail.call("update_trail", delta, head_pos, active, velocity.length())


func _update_jump_ball(delta: float) -> void:
	if jump_ball == null:
		return
	if not jump_ball.has_method("set_jump_ball_active"):
		return
	var ball_pos: Vector3 = global_position
	if model_root != null:
		ball_pos = model_root.global_position
	if not _network_is_local_authority():
		jump_ball.call("set_jump_ball_active", delta, false, ball_pos, Vector3.FORWARD, Vector3.UP)
		return

	var active: bool = not attached and is_attack_active() and _current_action_allows_jump_ball()
	if _hurt_active or _is_dead or _player_state_locked:
		active = false

	var heading: Vector3 = velocity
	if heading.length() <= 0.001:
		heading = _model_forward
	if heading.length() <= 0.001:
		heading = -global_transform.basis.z

	var up: Vector3 = gravity_up
	if up.length() <= 0.001:
		up = Vector3.UP

	if jump_ball.has_method("set_speed_for_full_extrusion"):
		jump_ball.call("set_speed_for_full_extrusion", jump_ball_speed_for_full_extrusion)
	jump_ball.call("set_jump_ball_active", delta, active, ball_pos, heading, up)


func _current_action_allows_jump_ball() -> bool:
	if _active_action == null or not is_instance_valid(_active_action):
		return true
	var allows: Variant = _active_action.get("shows_jump_ball")
	if allows is bool:
		return bool(allows)
	return true


func _set_sonic_boom_visibility(alpha: float, progress: float) -> void:
	if _sonic_boom_fx_node != null and is_instance_valid(_sonic_boom_fx_node):
		_sonic_boom_fx_node.visible = alpha > 0.01
		if _sonic_boom_fx_node.has_method("set_boom_state"):
			_sonic_boom_fx_node.call("set_boom_state", alpha, progress, sonic_boom_color)

	var clamped_alpha: float = clamp(alpha, 0.0, 1.0)
	var clamped_progress: float = clamp(progress, 0.0, 1.0)
	for mat in _sonic_boom_materials:
		if mat is ShaderMaterial:
			var sm: ShaderMaterial = mat
			sm.set_shader_parameter("boom_alpha", clamped_alpha)
			sm.set_shader_parameter("boom_progress", clamped_progress)
			sm.set_shader_parameter("boom_color", sonic_boom_color)
			if sonic_boom_override_material_params:
				sm.set_shader_parameter("boom_max_alpha", sonic_boom_max_alpha)


func _duplicate_sonic_boom_material(source: ShaderMaterial, shader: Shader) -> ShaderMaterial:
	var mat: ShaderMaterial = source.duplicate(true)
	mat.shader = shader
	mat.set_shader_parameter("boom_alpha", 0.0)
	mat.set_shader_parameter("boom_progress", 1.0)
	mat.set_shader_parameter("boom_color", sonic_boom_color)
	if sonic_boom_override_material_params:
		mat.set_shader_parameter("boom_max_alpha", sonic_boom_max_alpha)
	return mat


func _update_sonic_boom_orientation(delta: float) -> void:
	if _sonic_boom_fx_node == null or not is_instance_valid(_sonic_boom_fx_node):
		return

	var speed: float = velocity.length()
	if speed > 0.01:
		_sonic_boom_dir = velocity / speed
	if _sonic_boom_dir.length() < 0.001:
		return

	var up: Vector3 = gravity_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	var forward_dir: Vector3 = -_sonic_boom_dir.normalized()
	var target_basis: Basis = Basis().looking_at(forward_dir, up)
	var scale: Vector3 = _sonic_boom_fx_node.scale
	var new_basis: Basis = target_basis.scaled(scale)
	_sonic_boom_fx_node.global_transform = Transform3D(new_basis, _sonic_boom_fx_node.global_position)

# ===========================================================
# NETWORKING
# ===========================================================

func _network_is_active() -> bool:
	return multiplayer != null and multiplayer.has_multiplayer_peer()

func _network_is_local_authority() -> bool:
	if not _network_is_active():
		return true
	return is_multiplayer_authority()

func _network_configure_for_role() -> void:
	if not _network_is_active() or not network_replication_enabled:
		if _net_saved_collision:
			collision_layer = _net_initial_collision_layer
			collision_mask = _net_initial_collision_mask
		return

	var puppet = not is_multiplayer_authority()
	if puppet:
		collision_layer = 0
		collision_mask = 0
		lock_cursor_to_game = false
		if jump_dash_trail != null and jump_dash_trail.has_method("stop_and_clear"):
			jump_dash_trail.call("stop_and_clear")
		if jump_ball != null and jump_ball.has_method("set_jump_ball_active"):
			jump_ball.call("set_jump_ball_active", 0.0, false, global_position, Vector3.FORWARD, Vector3.UP)
		if sfx_barrier_blast_wind != null:
			sfx_barrier_blast_wind.stop()
			sfx_barrier_blast_wind.volume_db = barrier_blast_wind_volume_min_db
			sfx_barrier_blast_wind.pitch_scale = barrier_blast_wind_pitch_min
	else:
		if _net_saved_collision:
			collision_layer = _net_initial_collision_layer
			collision_mask = _net_initial_collision_mask

func _network_puppet_tick(delta: float) -> void:
	if not network_replication_enabled:
		return

	if _net_has_state:
		var use_exact_pos: bool = (_net_target_state_flags & (STATE_RAIL | STATE_SPLINE | STATE_SPRING)) != 0
		if use_exact_pos:
			global_transform = _net_target_transform
		else:
			var t = 1.0 - exp(-network_interp_strength * delta)
			global_transform = global_transform.interpolate_with(_net_target_transform, t)
		velocity = _net_target_velocity
		attached = _net_target_attached
		state_flags = _net_target_state_flags
		main_state = _net_target_main_state
		visual_up = _net_target_visual_up
		_physics_up_last = _net_target_visual_up
		_move_direction = _net_target_move_direction
		_current_action_id = _net_target_action_id
		var rail_flagged: bool = (_net_target_state_flags & STATE_RAIL) != 0
		_rail_active = rail_flagged
		if rail_flagged:
			var travel_sign: float = 1.0
			if (_net_target_state_flags & STATE_RAIL_BACKWARD) != 0:
				travel_sign = -1.0
			elif (_net_target_state_flags & STATE_RAIL_FORWARD) != 0:
				travel_sign = 1.0
			_rail_travel_sign = travel_sign
			var speed_mag: float = _net_target_velocity.length()
			_rail_speed = speed_mag * travel_sign
		else:
			_rail_travel_sign = 1.0
			_rail_speed = 0.0

		if model_root != null:
			var mt = model_root.global_transform
			mt.basis = _net_target_model_basis
			model_root.global_transform = mt

		_update_animation(delta)
		_update_skid_sfx(delta, _get_lateral_speed_for_anim())
		_update_puppet_barrier_blast_fx(delta)
		_prev_attached = attached
		if _spring_align_timer > 0.0 or _spline_active or _rail_active:
			_air_torque_prev_attached = false
		else:
			_air_torque_prev_attached = attached

func _network_send_state(delta: float) -> void:
	if not _network_is_active() or not network_replication_enabled:
		return
	if not is_multiplayer_authority():
		return

	var send_interval = 0.0
	if network_send_rate_hz > 0.0:
		send_interval = 1.0 / network_send_rate_hz

	_net_send_accum += delta
	if send_interval > 0.0 and _net_send_accum < send_interval:
		return
	_net_send_accum = 0.0

	var mb = Basis.IDENTITY
	if model_root != null:
		mb = model_root.global_transform.basis

	rpc(
		"_net_recv_state",
		global_transform,
		velocity,
		attached,
		state_flags,
		main_state,
		visual_up,
		mb,
		_move_direction,
		clamp(_barrier_blast_gauge, 0.0, 1.0),
		_current_action_id
	)

@rpc("any_peer", "unreliable")
func _net_recv_state(
		t,
		v,
		is_attached_value,
		flags_value,
		main_state_value,
		visual_up_value,
		model_basis_value,
		move_dir_value,
		barrier_blast_gauge_value = 0.0,
		action_id_value: StringName = &""
	) -> void:
	if not _network_is_active() or not network_replication_enabled:
		return

	var sender = multiplayer.get_remote_sender_id()
	if sender != get_multiplayer_authority():
		return

	_net_target_transform = t
	_net_target_velocity = v
	_net_target_attached = is_attached_value
	_net_target_state_flags = flags_value
	_net_target_main_state = main_state_value
	_net_target_visual_up = visual_up_value
	_net_target_model_basis = model_basis_value
	_net_target_move_direction = move_dir_value
	_net_target_barrier_blast_gauge = float(barrier_blast_gauge_value)
	_net_target_action_id = action_id_value
	_net_has_state = true

@rpc("any_peer", "reliable")
func _net_anim_command(cmd: StringName) -> void:
	if not _network_is_active() or not network_replication_enabled:
		return
	var sender = multiplayer.get_remote_sender_id()
	if sender != get_multiplayer_authority():
		return
	_trigger_anim_command(cmd, false)

func apply_debug_puppet_state(
		t: Transform3D,
		v: Vector3,
		is_attached_value: bool,
		flags_value: int,
		main_state_value: int,
		visual_up_value: Vector3,
		model_basis_value: Basis,
		move_dir_value: Vector3,
		barrier_blast_gauge_value: float = 0.0,
		action_id_value: StringName = &""
) -> void:
	_net_target_transform = t
	_net_target_velocity = v
	_net_target_attached = is_attached_value
	_net_target_state_flags = flags_value
	_net_target_main_state = main_state_value
	_net_target_visual_up = visual_up_value
	_net_target_model_basis = model_basis_value
	_net_target_move_direction = move_dir_value
	_net_target_barrier_blast_gauge = barrier_blast_gauge_value
	_net_target_action_id = action_id_value
	_net_has_state = true

@rpc("any_peer", "unreliable")
func _net_play_action_sfx(tag, idx) -> void:
	if not _network_is_active() or not network_replication_enabled:
		return

	if tag == "jump":
		if sfx_player == null:
			return
		var i = int(idx)
		if i < 0 or i >= jump_sounds.size():
			return
		sfx_player.volume_db = linear_to_db(jump_volume)
		sfx_player.stream = jump_sounds[i]
		sfx_player.play()
		return

	if tag == "jumpdash":
		if sfx_player == null:
			return
		var j = int(idx)
		if j < 0 or j >= jumpdash_sounds.size():
			return
		sfx_player.volume_db = linear_to_db(jumpdash_volume)
		sfx_player.stream = jumpdash_sounds[j]
		sfx_player.play()
		return

	if tag == "bounce_start":
		_play_sfx(sfx_bounce_start)
	elif tag == "bounce_land":
		_play_sfx(sfx_bounce_land)
	elif tag == "stomp_start":
		_play_sfx(sfx_stomp_start)
	elif tag == "stomp_land":
		_play_sfx(sfx_stomp_land)
	elif tag == "spindash_start":
		_play_spindash_charge_start_sfx(false)
	elif tag == "spindash_loop":
		_start_spindash_loop_sfx(false)
	elif tag == "spindash_loop_stop":
		_stop_spindash_loop_sfx(false)
	elif tag == "spindash_full":
		_play_spindash_charge_full_sfx(false)
	elif tag == "spindash_release":
		_play_spindash_release_sfx(false)

@rpc("any_peer", "unreliable")
func _net_play_footstep_sfx(surface: int, idx: int, volume_linear: float, foot: String, emit_dust: bool, water_idx: int, water_volume: float) -> void:
	if not _network_is_active() or not network_replication_enabled:
		return
	var sender: int = multiplayer.get_remote_sender_id()
	if sender != get_multiplayer_authority():
		return
	_ensure_modules()
	if _audio_module == null:
		return
	_audio_module.play_remote_footstep(
		int(surface),
		int(idx),
		float(volume_linear),
		StringName(foot),
		bool(emit_dust),
		int(water_idx),
		float(water_volume)
	)
