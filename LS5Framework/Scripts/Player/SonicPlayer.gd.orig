@export var beacon_beam_radius: float = 7.0
@export var beacon_label_pixel_size: float = 0.09
@export var beacon_label_height_offset: float = 4.0

@export_group("Homing Reticle")
@export var homing_reticle_enabled: bool = true
@export var homing_reticle_texture: Texture2D
@export var homing_reticle_pixel_size: float = 0.01
@export var homing_reticle_height_offset: float = 0.0
@export var homing_reticle_scale_base: float = 0.1
@export var homing_reticle_scale_per_unit: float = 0.01
@export var homing_reticle_scale_max: float = 3.0
@export var homing_reticle_sound_enabled: bool = true
@export var homing_reticle_sound: AudioStream
@export var homing_reticle_sound_bus: StringName = &"SFX"
@export var homing_reticle_sound_volume_db: float = -4.0

@export_group("Speed Lines")
@export var speed_lines_enabled: bool = true
@export var speed_lines_follow_speed_scale: float = 0.7
@export var speed_lines_spawn_rate_min: float = 15.0
@export var speed_lines_spawn_rate_max: float = 99.0
@export var speed_lines_lifetime: float = 0.3
@export var speed_lines_lifetime_variance: float = 0.09
@export var speed_lines_length: float = 0.9
@export var speed_lines_length_scale_max: float = 3.0
@export var speed_lines_width: float = 0.013
@export var speed_lines_spawn_radius: float = 0.9
@export var speed_lines_spawn_radius_vertical: float = 1.2
@export var speed_lines_spawn_back_offset: float = 0.4
@export var speed_lines_grow_time: float = 0.08
@export_range(0.0, 1.0) var speed_lines_grow_start_scale: float = 0.04
@export var speed_lines_alpha_min: float = 0.05
@export var speed_lines_alpha_max: float = 0.7
@export var speed_lines_color: Color = Color(1, 1, 1, 1)

@export_group("Speed Boom FX")
@export var sonic_boom_enabled: bool = true
@export var sonic_boom_duration: float = 2.585
@export var sonic_boom_progress_delay: float = 1.48
@export var sonic_boom_fade_in_speed: float = 6.0
@export var sonic_boom_fade_out_speed: float = 3.765
@export_range(0.0, 5.0) var sonic_boom_max_alpha: float = 1.6
@export var sonic_boom_color: Color = Color(0.28651586, 1.2117599, 4.681993, 0.549)
@export var sonic_boom_override_material_params: bool = false
@export var sonic_boom_shader: Shader
@export_group("Character colors")
@export var character_tint_enabled: bool = true
@export var character_primary_mask: Texture2D
@export var character_secondary_mask: Texture2D
## If non-empty, tint shader is only applied to surfaces whose *material* matches one of these.
@export var character_tint_allowed_materials: Array[Material] = []
## If non-empty, tint shader is only applied when the *material* resource path contains any of these substrings.
@export var character_tint_allowed_material_path_substrings: PackedStringArray = PackedStringArray()
## If non-empty, tint shader is NOT applied when the *material* path contains any of these substrings.
@export var character_tint_blocked_material_path_substrings: PackedStringArray = PackedStringArray()
## If non-empty, tint shader is only applied to surfaces whose albedo texture matches one of these.
@export var character_tint_allowed_textures: Array[Texture2D] = []
## If non-empty, tint shader is only applied when the albedo texture resource path contains any of these substrings.
@export var character_tint_allowed_texture_path_substrings: PackedStringArray = PackedStringArray()
## If non-empty, tint shader is NOT applied when the albedo texture path contains any of these substrings.
@export var character_tint_blocked_texture_path_substrings: PackedStringArray = PackedStringArray()
## If provided, the primary mask/color only affects these materials (others get primary_strength = 0).
@export var character_tint_primary_materials: Array[Material] = []
## If provided, the secondary mask/color only affects these materials (others get secondary_strength = 0).
@export var character_tint_secondary_materials: Array[Material] = []
## Optional path substring matching for primary mask targeting (material path).
@export var character_tint_primary_material_path_substrings: PackedStringArray = PackedStringArray()
## Optional path substring matching for secondary mask targeting (material path).
@export var character_tint_secondary_material_path_substrings: PackedStringArray = PackedStringArray()
## If provided, the primary mask/color only affects these textures (others get primary_strength = 0).
@export var character_tint_primary_textures: Array[Texture2D] = []
## If provided, the secondary mask/color only affects these textures (others get secondary_strength = 0).
@export var character_tint_secondary_textures: Array[Texture2D] = []
## Optional path substring matching for primary mask targeting.
@export var character_tint_primary_texture_path_substrings: PackedStringArray = PackedStringArray()
## Optional path substring matching for secondary mask targeting.
@export var character_tint_secondary_texture_path_substrings: PackedStringArray = PackedStringArray()
@export var character_hue_fallback_color: Color = Color(0.18, 0.52, 1.0, 1.0) ## Hue used when the selected color has too little saturation.
@export_range(0.0, 1.0, 0.01) var character_hue_overlay_strength: float = 1.0 ## Multiplier applied to the hue overlay intensity.
@export_range(0.0, 1.0, 0.01) var character_hue_saturation_threshold: float = 0.2 ## Minimum saturation required before hue shifting begins.
@export_range(0.0, 1.0, 0.01) var character_hue_saturation_softness: float = 0.25 ## Width of the saturation ramp for hue shifting.
@export_range(0.01, 8.0, 0.01) var character_hue_saturation_exponent: float = 1.0 ## Power applied to the saturation ramp mask.

@export_subgroup("Jump Ball")
@export var jump_ball_default_color: Color = Color(0.2, 0.8, 1.0, 0.72) ## Fallback jump ball color used by this character scene.
@export var jump_ball_speed_for_full_extrusion: float = 140.0 ## Speed where the jump ball reaches full extrusion.

