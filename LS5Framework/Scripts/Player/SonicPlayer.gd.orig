func _update_skid_sfx(delta: float, lateral_speed: float) -> void:
	_ensure_modules()
	var skid_active: bool = _is_skidding or (state_flags & STATE_SKIDDING) != 0
	if _audio_module != null:
		_audio_module.update_skid_audio(skid_active, lateral_speed, delta)
	_update_skid_dust(skid_active, lateral_speed, delta)

func _stop_skid_sfx() -> void:
	_ensure_modules()
	if _audio_module != null:
		_audio_module.stop_skid_audio()
	_reset_skid_dust()

func _update_skid_dust(skid_active: bool, lateral_speed: float, delta: float) -> void:
	if not skid_active or lateral_speed < max(skid_dust_min_speed, 0.0):
		_reset_skid_dust()
		return
	var interval: float = max(skid_dust_interval, 0.001)
	_skid_dust_timer = max(_skid_dust_timer - delta, 0.0)
	while _skid_dust_timer <= 0.0:
		var foot: StringName = &"left" if _skid_dust_emit_left else &"right"
		_emit_footstep_dust(foot)
		_skid_dust_emit_left = not _skid_dust_emit_left
		_skid_dust_timer += interval

func _reset_skid_dust() -> void:
	_skid_dust_timer = 0.0
	_skid_dust_emit_left = true


# ===========================================================
# EXTERNAL IMPULSES / OBJECT INTERACTION (SPRINGS, ETC)
# ===========================================================
func apply_spring_impulse(
	spring_position: Vector3,
	spring_direction: Vector3,
	spring_strength: float,
	snap_to_center: bool,
	stop_momentum: bool,
	additive_mode: int,
	min_additive_launch_speed: float,
	movement_lock_time: float,
	action_lock_time: float,
	align_time: float,
	spring_basis: Basis,
	clear_move_on_ground: bool,
	clear_action_on_ground: bool,
	lock_horizontal_during_align: bool,
	sideways_gravity_scale: float,
	detach_from_ground: bool,
	align_model_during_spring: bool,
	preserve_active_flight: bool = false,
	flight_time_bonus: float = 0.0
	) -> void:
	if _dbg_tp_trace > 0:
		print("[TP] SPRING_IMPULSE called: dir=%v strength=%s vel=%v" % [spring_direction, spring_strength, velocity])
	if _spring_action != null:
		_sync_spring_state_to_action()
		_spring_action.apply_impulse(
			spring_position,
			spring_direction,
			spring_strength,
			snap_to_center,
			stop_momentum,
			additive_mode,
			min_additive_launch_speed,
			movement_lock_time,
			action_lock_time,
			align_time,
			spring_basis,
			clear_move_on_ground,
			clear_action_on_ground,
			lock_horizontal_during_align,
			sideways_gravity_scale,
			detach_from_ground,
			align_model_during_spring,
			preserve_active_flight,
			flight_time_bonus
		)
		_sync_spring_state_from_action()
		return
	var preserve_flight: bool = preserve_active_flight and is_current_action_flight()
	var effective_align_time: float = align_time
	var effective_align_model: bool = align_model_during_spring
	var effective_lock_horizontal: bool = lock_horizontal_during_align
	if preserve_flight:
		effective_align_time = 0.0
		effective_align_model = false
		effective_lock_horizontal = false
		add_flight_time(flight_time_bonus)
	cancel_spline_spring()
	cancel_homing_attack(false)
	
	_spring_align_timer = 0
	reset_trick_staleness()
	_bounce_state = BounceState.NONE
	_is_jumping = false
	_jump_variable = false
	_jump_hang_allowed = false
	_jump_time = 0.0
	# Springs should refresh jump-dash availability (treat as a new airborne "segment").
	_jump_dash_used_this_air = false
	_tornado_kick_used_this_air = false
	_jump_dash_requested = false
	_jump_dash_recent_timer = 0.0
	
	_spring_align_model = effective_align_model
	if _spring_align_model and spring_model_snap_time > 0.0:
		_spring_model_snap_timer = max(_spring_model_snap_timer, spring_model_snap_time)
	else:
		_spring_model_snap_timer = 0.0
	var dir: Vector3 = spring_direction.normalized()
	if dir.length() < 0.001:
		dir = Vector3.UP

	_spring_detached = detach_from_ground

	# --- Detach only if the spring wants it ---
	if detach_from_ground:
		_record_spring_detach_state(Vector3.UP)
		attached = false
		_attachment_immunity = launch_immunity_time
		_airborne_time = 0.0
	else:
		# NO detachment — stay grounded & preserve surface_normal
		# But still apply impulse
		_airborne_time = 0.0

	# Optionally snap player to spring center.
	if snap_to_center:
		global_position = spring_position
		surface_point = spring_position

	var v: Vector3 = velocity
	var impulse_up: Vector3 = Vector3.UP
	if preserve_flight:
		impulse_up = gravity_up.normalized()
		if impulse_up.length() < 0.001:
			impulse_up = Vector3.UP

	if stop_momentum:
		# Pure spring velocity, overriding previous motion.
		velocity = dir * spring_strength
	else:
		# --- ADDITIVE MODES ---
		match additive_mode:
			0: # IgnorePriorVertical
				var vert: float = v.dot(impulse_up)
				var lateral: Vector3 = v - impulse_up * vert
				var launch: Vector3 = dir * spring_strength
				velocity = lateral + launch

			1: # FullyAdditiveWithMinLaunch
				v += dir * spring_strength

				var along: float = v.dot(dir)
				if along < min_additive_launch_speed:
					var delta_along: float = min_additive_launch_speed - along
					v += dir * delta_along

				velocity = v
			_:
				var vert: float = v.dot(impulse_up)
				var lateral: Vector3 = v - impulse_up * vert
				var launch: Vector3 = dir * spring_strength
				velocity = lateral + launch

	# --- Apply locks / alignment timers ---
	if movement_lock_time > 0.0:
		_spring_movement_lock_timer = max(_spring_movement_lock_timer, movement_lock_time)

	if action_lock_time > 0.0:
		_spring_action_lock_timer = max(_spring_action_lock_timer, action_lock_time)

	if effective_align_time > 0.0:
		_spring_align_timer = max(_spring_align_timer, effective_align_time)
		_spring_align_up = spring_basis.y.normalized()
		_spring_align_forward = (-spring_basis.z).normalized()
		_spring_align_dir = dir
		_spring_lock_sideways = effective_lock_horizontal
		_spring_sideways_gravity_scale = sideways_gravity_scale
		_spring_cancel_on_ground = true

	# Remember whether to clear locks on next landing.
	_spring_clear_move_on_ground = clear_move_on_ground
	_spring_clear_action_on_ground = clear_action_on_ground
	
	if _spring_align_timer <= 0.0:
		_spring_align_model = false

	if not preserve_flight:
		reset_flight_eligibility()
		end_active_flight_for_external_impulse({"reason": &"spring_impulse"})

	if not preserve_flight:
		_trigger_anim_command(&"CMD_SPRING")


func apply_dash_panel_impulse(
	panel_origin: Vector3,
	panel_dir: Vector3,
	strength: float,
	stop_momentum: bool,
	additive_mode: int,
	min_additive_launch_speed: float,
	movement_lock_time: float,
	action_lock_time: float,
	align_camera: bool,
	panel_basis: Basis,
	lock_speed_enabled: bool,
	lock_speed_value: float,
	lock_speed_duration: float,
	override_max_speed: bool = false,
	max_speed_override: float = 0.0,
	max_speed_override_duration: float = 0.0
) -> void:
	_bounce_state = BounceState.NONE
	cancel_spline_spring()
	cancel_rail_grind(false)

	_automation_active = false
	_automation_timer = 0.0
	_automation_lock_movement = false
	_automation_lock_actions = false
	_automation_lock_drift = false
	_automation_tangent_dir = Vector3.ZERO
	_automation_toward_dir = Vector3.ZERO
	_automation_toward_strength = 0.0
	_automation_max_turn_deg_per_sec = 0.0
	_automation_along_target_speed = 0.0
	_automation_along_accel = 0.0
	_automation_continuous_force = true
	_automation_align_rotation = true
	_automation_grounded_only = true
	_automation_force_surface_adhesion = false
	_automation_tangent_snap_strength = 0.0
	_automation_along_assist_enabled = true
	_automation_ignore_water_physics = false
	_automation_expired_this_frame = false
	_automation_priority_current = -9999
	_automation_priority_frame = -1

	var up: Vector3 = panel_basis.y.normalized()
	if up.length() < 0.001:
		up = surface_normal.normalized()
	if up.length() < 0.001:
		up = up_direction.normalized()
	if up.length() < 0.001:
		up = gravity_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	surface_normal = up
	_prev_surface_normal = up
	_smoothed_surface_normal = up
	surface_point = panel_origin
	up_direction = up
	_attachment_immunity = 0.0
	_record_attach_state(surface_normal, gravity_up)

	var t: Transform3D = global_transform
	t.origin = panel_origin + up * collision_ground_distance
	global_transform = t

	var v: Vector3 = velocity
	var vertical: float = v.dot(up)
	var lateral: Vector3 = v - up * vertical

	var dash_dir: Vector3 = panel_dir - up * panel_dir.dot(up)
	if dash_dir.length() < 0.001:
		if lateral.length() > 0.001:
			dash_dir = lateral.normalized()
		else:
			dash_dir = (-Vector3.FORWARD - up * (-Vector3.FORWARD).dot(up))
	if dash_dir.length() < 0.001:
		dash_dir = Vector3.FORWARD
	dash_dir = dash_dir.normalized()

	if stop_momentum:
		vertical = 0.0
		lateral = dash_dir * strength
	else:
		match additive_mode:
			0: # IgnorePriorVertical
				vertical = 0.0
				lateral += dash_dir * strength
			1: # FullyAdditiveWithMinLaunch
				var new_v: Vector3 = v + dash_dir * strength

				var new_vert: float = new_v.dot(up)
				new_v -= up * new_vert

				var along: float = new_v.dot(dash_dir)
				if along < min_additive_launch_speed:
					new_v += dash_dir * (min_additive_launch_speed - along)

				vertical = 0.0
				lateral = new_v

	velocity = lateral
	attached = true
	_prev_attached = true
	_is_jumping = false
	_is_falling = false

	if movement_lock_time > 0.0:
		_spring_movement_lock_timer = max(_spring_movement_lock_timer, movement_lock_time)
		_spring_clear_move_on_ground = true

	if action_lock_time > 0.0:
		_spring_action_lock_timer = max(_spring_action_lock_timer, action_lock_time)
		_spring_clear_action_on_ground = true

	# Camera align
	if align_camera and camera_rig != null and camera_rig.has_method("align_to_direction"):
		if not (camera_rig.has_method("is_constraint_active") and camera_rig.is_constraint_active()):
			camera_rig.align_to_direction(dash_dir, up)

	if lock_speed_enabled and lock_speed_duration > 0.0 and lock_speed_value > 0.0:
		_dash_speed_lock_timer = lock_speed_duration
		_dash_speed_lock_speed = lock_speed_value
	if override_max_speed:
		set_timed_max_speed_override(max_speed_override, max_speed_override_duration)
	reset_flight_timer_to_max()
	end_active_flight_for_external_impulse({"reason": &"dash_panel_impulse"})

func apply_ramp_impulse(
	ramp_origin: Vector3,
	ramp_forward: Vector3,
	ramp_up: Vector3,
	forward_speed: float,
	up_speed: float,
	additive_launch: bool,
	additive_min_forward_speed: float,
	movement_lock_time: float,
	action_lock_time: float,
	align_camera: bool,
	hold_forward_time: float,
	hold_up_time: float
) -> void:
	cancel_spline_spring()
	cancel_homing_attack(false)
	_bounce_state = BounceState.NONE

	# Always detach.
	if attached:
		_record_detach_state(surface_normal, Vector3.UP)
	attached = false
	_attachment_immunity = launch_immunity_time
	_airborne_time = 0.0
	_is_skidding = false

	# This ramp does not use spring alignment/splines.
	_spring_align_timer = 0.0
	_spring_align_model = false
	_spring_lock_sideways = false

	var up: Vector3 = ramp_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	var fwd: Vector3 = ramp_forward - up * ramp_forward.dot(up)
	if fwd.length() < 0.001:
		fwd = -Vector3.FORWARD - up * (-Vector3.FORWARD).dot(up)
	if fwd.length() < 0.001:
		fwd = Vector3.FORWARD
	fwd = fwd.normalized()

	var forward_speed_used: float = max(forward_speed, 0.0)
	var up_speed_used: float = up_speed

	# Choose between absolute launch and additive launch.
	if additive_launch:
		# Only keep existing speed along the ramp's forward direction.
		var forward_along: float = velocity.dot(fwd)
		if forward_along < 0.0:
			forward_along = 0.0
		var final_forward_speed: float = forward_along + forward_speed_used
		var min_forward: float = max(additive_min_forward_speed, 0.0)
		if min_forward > 0.0 and final_forward_speed < min_forward:
			final_forward_speed = min_forward
		velocity = fwd * final_forward_speed + up * up_speed_used
	else:
		# Absolute impulse (not additive).
		velocity = fwd * forward_speed_used + up * up_speed_used

	# Encourage immediate facing toward the ramp direction.
	_model_forward = fwd

	# Reuse spring timers for locking behavior.
	if movement_lock_time > 0.0:
		_spring_movement_lock_timer = max(_spring_movement_lock_timer, movement_lock_time)
		_spring_clear_move_on_ground = true
	if action_lock_time > 0.0:
		_spring_action_lock_timer = max(_spring_action_lock_timer, action_lock_time)
		_spring_clear_action_on_ground = true

	# Camera align
	if align_camera and camera_rig != null and camera_rig.has_method("align_to_direction"):
		if not (camera_rig.has_method("is_constraint_active") and camera_rig.is_constraint_active()):
			camera_rig.align_to_direction(fwd, up)

	# Optional continuous impulse holds.
	_ramp_hold_forward_timer = max(hold_forward_time, 0.0)
	_ramp_hold_up_timer = max(hold_up_time, 0.0)
	_ramp_hold_forward_speed = max(velocity.dot(fwd), 0.0)
	_ramp_hold_up_speed = up_speed_used
	_ramp_hold_forward_dir = fwd
	_ramp_hold_up_dir = up
	reset_flight_eligibility()
	if not _spindash_charging:
		_force_neutral_air_action({"reason": &"ramp_impulse"})
		_skydive_anim_phase = SKYDIVE_ANIM_NONE
		_skydive_anim_exit_timer = 0.0
		if anim_state != null:
			anim_state.travel(&"FallBlend")

func start_spline_spring(
	spline_path: Path3D,
	speed: float,
	align_model: bool,
	detach_from_ground: bool,
	allow_input_cancel: bool,
	action_lock_time: float = 0.0
) -> void:
	cancel_spline_spring()
	cancel_homing_attack(false)
	if spline_path == null or spline_path.curve == null:
		return

	var curve := spline_path.curve
	var length := curve.get_baked_length()
	if length <= 0.001:
		return

	_spline_path = spline_path
	_spline_total_length = length
	_spline_speed = speed
	_spline_align_model = align_model
	_spline_detach_from_ground = detach_from_ground
	_spline_allow_input_cancel = allow_input_cancel
	_spline_active = true
	_is_jumping = false
	_jump_variable = false
	_jump_hang_allowed = false
	_jump_time = 0.0
	# Treat spline springs like normal springs for jump-dash/anim resets.
	_jump_dash_used_this_air = false
	_tornado_kick_used_this_air = false
	_jump_dash_requested = false
	_jump_dash_recent_timer = 0.0

	# Start at beginning of the path (offset 0). 
	# Closest-point start not implemented (uses path origin).
	_spline_distance = 0.0
	# Snap model orientation immediately to the spline direction.
	if _spline_align_model and model_root:
		var local_pos: Vector3 = curve.sample_baked(_spline_distance)
		var ahead_dist: float = min(_spline_distance + 0.1, _spline_total_length)
		var local_pos_ahead: Vector3 = curve.sample_baked(ahead_dist)
		var world_pos: Vector3 = _spline_path.to_global(local_pos)
		var world_pos_ahead: Vector3 = _spline_path.to_global(local_pos_ahead)
		var tangent: Vector3 = (world_pos_ahead - world_pos).normalized()
		if tangent.length() < 0.001:
			tangent = Vector3.FORWARD

		var travel_dir: Vector3 = tangent * _spline_speed
		if travel_dir.length() < 0.001:
			travel_dir = tangent
		var model_forward: Vector3 = travel_dir.normalized()
		var basis: Basis = _build_spline_model_basis(model_forward, model_root.global_transform.basis.y)
		model_root.global_transform = Transform3D(basis, model_root.global_transform.origin)
		_model_forward = model_forward

	# Optional: detach from ground so adhesion doesn't fight the spline
	if detach_from_ground and attached:
		var world_up: Vector3 = Vector3.UP
		_record_detach_state(surface_normal, world_up, false)
		attached = false
		_attachment_immunity = launch_immunity_time
		_airborne_time = 0.0

	# Clear spring / skid state so nothing competes
	_spring_align_timer = 0.0
	_bounce_state = BounceState.NONE
	_is_skidding = false

	if action_lock_time > 0.0:
		_spring_action_lock_timer = max(_spring_action_lock_timer, action_lock_time)
		_spring_clear_action_on_ground = true
	reset_flight_eligibility()
	end_active_flight_for_external_impulse({"reason": &"spline_spring"})

	_trigger_anim_command(&"CMD_SPRING")


func _update_spline_spring(delta: float) -> void:
	if not _spline_active or _spline_path == null or _spline_path.curve == null:
		_spline_active = false
		return

	var curve := _spline_path.curve

	# Optional: allow cancelling with input
	if _spline_allow_input_cancel and _move_input.length() > 0.2:
		_spline_active = false
		return

	# Advance along the spline
	_spline_distance += _spline_speed * delta

	# End of spline → stop and hand control back
	if _spline_distance >= _spline_total_length:
		_spline_active = false
		return

	# Sample *local* positions on the curve
	var local_pos: Vector3 = curve.sample_baked(_spline_distance)
	var ahead_dist : float = min(_spline_distance + 0.1, _spline_total_length)
	var local_pos_ahead: Vector3 = curve.sample_baked(ahead_dist)

	# Convert to world space using the Path3D transform
	var world_pos: Vector3 = _spline_path.to_global(local_pos)
	var world_pos_ahead: Vector3 = _spline_path.to_global(local_pos_ahead)

	var tangent: Vector3 = (world_pos_ahead - world_pos).normalized()
	if tangent.length() < 0.001:
		tangent = Vector3.FORWARD

	# Velocity in world space for collisions
	velocity = tangent * _spline_speed

	# Place the player in world space
	global_position = world_pos

	# Optional: align model forward to travel direction so the head faces the trajectory.
	if _spline_align_model and model_root:
		var travel_dir: Vector3 = velocity
		if travel_dir.length() < 0.001:
			travel_dir = tangent
		var model_forward: Vector3 = travel_dir.normalized()

		var basis := _build_spline_model_basis(model_forward, model_root.global_transform.basis.y)
		model_root.global_transform = Transform3D(basis, model_root.global_transform.origin)
		_model_forward = model_forward
	_refresh_carried_object_target_after_external_motion()


func _build_spline_model_basis(forward_dir: Vector3, up_hint: Vector3) -> Basis:
	# SUMMARY: Build a stable model basis for spline alignment (prevents mirrored lighting).
	# STEPS:
	# - Step 1: Normalize the forward direction.
	# - Step 2: Project the up hint off the forward direction.
	# - Step 3: Build a right-handed, orthonormal basis.
	var forward: Vector3 = forward_dir.normalized()
	if forward.length() < 0.001:
		forward = Vector3.FORWARD

	var up_ref: Vector3 = up_hint
	if up_ref.length() < 0.001:
		up_ref = Vector3.UP
	up_ref = up_ref - forward * up_ref.dot(forward)
	if up_ref.length() < 0.001:
		up_ref = Vector3.UP - forward * forward.dot(Vector3.UP)
		if up_ref.length() < 0.001:
			up_ref = Vector3.RIGHT - forward * forward.dot(Vector3.RIGHT)
	if up_ref.length() > 0.001:
		up_ref = up_ref.normalized()
	else:
		up_ref = Vector3.UP

	var right: Vector3 = up_ref.cross(forward)
	if right.length() < 0.001:
		right = Vector3.RIGHT
	right = right.normalized()
	var up_vec: Vector3 = forward.cross(right).normalized()

	var basis: Basis = Basis(right, up_vec, -forward).orthonormalized()
	if basis.determinant() < 0.0:
		basis.x = -basis.x
	var pitch_rad: float = deg_to_rad(spline_model_pitch_deg)
	if abs(pitch_rad) > 0.0001:
		# Rotate around model-right so positive values pitch forward.
		basis = basis.rotated(basis.x, -pitch_rad).orthonormalized()
		if basis.determinant() < 0.0:
			basis.x = -basis.x
	return basis


func _get_rail_tangent_world(curve: Curve3D, distance: float, total_length: float) -> Vector3:
	if curve == null or _rail_path == null:
		return Vector3.FORWARD
	var step: float = 0.08
	var before: float = clamp(distance - step, 0.0, total_length)
	var after: float = clamp(distance + step, 0.0, total_length)
	if abs(after - before) < 0.0001:
		after = min(before + step, total_length)
		before = max(before - step, 0.0)
	var p0_local: Vector3 = curve.sample_baked(before)
	var p1_local: Vector3 = curve.sample_baked(after)
	var p0_world: Vector3 = _rail_path.to_global(p0_local)
	var p1_world: Vector3 = _rail_path.to_global(p1_local)
	return p1_world - p0_world


func _get_rail_tilt(curve: Curve3D, distance: float) -> float:
	if curve == null:
		return 0.0
	if curve.has_method("sample_baked_tilt"):
		var v = curve.call("sample_baked_tilt", distance)
		if v is float:
			return float(v)
	if curve.has_method("interpolate_baked_tilt"):
		var v2 = curve.call("interpolate_baked_tilt", distance)
		if v2 is float:
			return float(v2)
	if curve.has_method("get_baked_tilts"):
		var tilts = curve.call("get_baked_tilts")
		if tilts is PackedFloat32Array and tilts.size() > 0:
			var interval: float = 0.0
			if curve.has_method("get_bake_interval"):
				var bi = curve.call("get_bake_interval")
				if bi is float:
					interval = float(bi)
			if interval <= 0.0:
				var bi2 = curve.get("bake_interval")
				if bi2 is float:
					interval = float(bi2)
			if interval <= 0.0:
				interval = 1.0
			var idx := int(round(distance / interval))
			idx = clamp(idx, 0, tilts.size() - 1)
			return float(tilts[idx])
	return 0.0


func _get_rail_up_vector(curve: Curve3D, rail_dir: Vector3, distance: float) -> Vector3:
	var up := Vector3.ZERO
	var candidates : Array = []
	if _rail_path != null:
		candidates.append(_rail_path.global_transform.basis.y)
		candidates.append(_rail_path.global_transform.basis.x)
		candidates.append(-_rail_path.global_transform.basis.z)
	candidates.append(Vector3.UP)
	candidates.append(Vector3.RIGHT)
	candidates.append(Vector3.FORWARD)

	for candidate in candidates:
		if not (candidate is Vector3):
			continue
		var c_vec: Vector3 = candidate
		if c_vec.length() < 0.001:
			continue
		var projected := c_vec - rail_dir * c_vec.dot(rail_dir)
		if projected.length() > 0.001:
			up = projected.normalized()
			break

	if up.length() < 0.001:
		up = Vector3.UP

	var tilt := _get_rail_tilt(curve, distance)
	if abs(tilt) > 0.0001:
		up = (Basis(rail_dir, tilt) * up).normalized()
	return up


func _get_rail_input_direction(world_up: Vector3) -> Vector3:
	if _move_input.length() < 0.001:
		return Vector3.ZERO
	var up := world_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	var forward: Vector3 = _get_camera_forward_world_up(up)
	if forward.length() < 0.001:
		forward = -Vector3.FORWARD
	forward = forward.normalized()

	var right: Vector3 = forward.cross(up)
	if right.length() < 0.001:
		right = Vector3.RIGHT - up * Vector3.RIGHT.dot(up)
	if right.length() < 0.001:
		right = Vector3.RIGHT
	right = right.normalized()

	var dir := forward * _move_input.y + right * _move_input.x
	if dir.length() < 0.001:
		return Vector3.ZERO
	return dir.normalized()


func _get_rail_spindash_input_direction(world_up: Vector3) -> Vector3:
	var x: float = Input.get_action_strength("move_right") - Input.get_action_strength("move_left")
	var z: float = Input.get_action_strength("move_forward") - Input.get_action_strength("move_back")
	var input := Vector2(x, z)
	if input.length() < 0.001:
		return Vector3.ZERO
	if input.length() > 1.0:
		input = input.normalized()

	var up := world_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	var forward: Vector3 = _get_camera_forward_world_up(up)
	if forward.length() < 0.001:
		forward = -Vector3.FORWARD
	forward = forward.normalized()

	var right: Vector3 = forward.cross(up)
	if right.length() < 0.001:
		right = Vector3.RIGHT - up * Vector3.RIGHT.dot(up)
	if right.length() < 0.001:
		right = Vector3.RIGHT
	right = right.normalized()

	var dir := forward * input.y + right * input.x
	if dir.length() < 0.001:
		return Vector3.ZERO
	return dir.normalized()


func _get_rail_spindash_release_sign(rail_dir: Vector3, world_up: Vector3) -> float:
	var desired_sign: float = 0.0
	var input_dir := _get_rail_spindash_input_direction(world_up)
	if input_dir.length() > 0.001:
		var dot := rail_dir.dot(input_dir)
		if dot >= rail_reverse_input_dot_threshold:
			desired_sign = 1.0
		elif dot <= -rail_reverse_input_dot_threshold:
			desired_sign = -1.0
		if desired_sign < 0.0 and not _rail_allow_reverse:
			desired_sign = 0.0

	if abs(desired_sign) < 0.001:
		var movement_dir := _rail_last_motion_dir
		if movement_dir.length() < 0.001:
			var base_sign := -1.0 if _rail_speed < 0.0 else 1.0
			movement_dir = rail_dir * base_sign
		desired_sign = 1.0 if rail_dir.dot(movement_dir) >= 0.0 else -1.0

	if not _rail_allow_reverse and desired_sign < 0.0:
		desired_sign = 1.0

	return desired_sign


func _get_rail_switch_side_input() -> float:
	var x: float = Input.get_action_strength("move_right") - Input.get_action_strength("move_left")
	if abs(x) < rail_switch_side_input_min:
		return 0.0
	return 1.0 if x > 0.0 else -1.0


func _rail_sample_path_tangent(path: Path3D, curve: Curve3D, offset: float, lookahead: float) -> Vector3:
	if path == null or curve == null:
		return Vector3.FORWARD
	var total_len := curve.get_baked_length()
	if total_len <= 0.01:
		return Vector3.FORWARD
	var ahead : float = clamp(offset + lookahead, 0.0, total_len)
	var here_local := curve.sample_baked(offset)
	var there_local := curve.sample_baked(ahead)
	var here := path.to_global(here_local)
	var there := path.to_global(there_local)
	return there - here


func _rail_find_closest_offset(path: Path3D, curve: Curve3D, world_point: Vector3) -> float:
	if path == null or curve == null:
		return 0.0

	var total_length := curve.get_baked_length()
	if total_length <= 0.01:
		return 0.0

	var local_point = path.to_local(world_point)
	var closest_local = curve.get_closest_point(local_point)

	var steps = int(clamp(total_length / 0.5, 32.0, 2048.0))
	if steps <= 0:
		steps = 1
	var step = total_length / float(steps)
	var best_offset = 0.0
	var best_dist = INF
	var current_offset = 0.0

	for i in range(steps + 1):
		var clamped_offset = clamp(current_offset, 0.0, total_length)
		var sample = curve.sample_baked(clamped_offset)
		var dist = sample.distance_squared_to(closest_local)
		if dist < best_dist:
			best_dist = dist
			best_offset = clamped_offset
		current_offset += step

	var prev_offset = max(best_offset - step, 0.0)
	var next_offset = min(best_offset + step, total_length)
	var prev_point = curve.sample_baked(prev_offset)
	var next_point = curve.sample_baked(next_offset)
	var segment = next_point - prev_point
	var seg_len_sq = segment.length_squared()
	if seg_len_sq > 0.0001:
		var rel = closest_local - prev_point
		var t = clamp(rel.dot(segment) / seg_len_sq, 0.0, 1.0)
		best_offset = lerp(prev_offset, next_offset, t)

	return best_offset


func _find_rail_switch_candidate(desired_side: float, world_up: Vector3) -> Dictionary:
	var result := {}
	if DEBUG_SKIP_RAIL_SHAPE:
		return result
	if abs(desired_side) < 0.001:
		return result

	var rails: Array = get_tree().get_nodes_in_group("Rail")
	if rails.is_empty():
		return result

	# Left/right relative to camera around world up.
	var side_up := world_up.normalized()
	if side_up.length() < 0.001:
		side_up = Vector3.UP
	var cam_forward := _get_camera_forward_world_up(side_up)
	if cam_forward.length() < 0.001:
		cam_forward = -Vector3.FORWARD
	cam_forward = cam_forward.normalized()
	var right := cam_forward.cross(side_up)
	if right.length() < 0.001:
		right = Vector3.RIGHT - side_up * Vector3.RIGHT.dot(side_up)
	if right.length() < 0.001:
		right = Vector3.RIGHT
	right = right.normalized()

	var travel_dir := _rail_last_motion_dir
	if travel_dir.length() < 0.001:
		travel_dir = _model_forward
	if travel_dir.length() < 0.001:
		travel_dir = -global_transform.basis.z
	travel_dir = travel_dir.normalized()
	var best_dist_sq := INF
	var best_forward := -INF
	var best_side := -INF

	var max_switch_dist_sq: float = rail_switch_query_radius * rail_switch_query_radius
	for rail_entry in rails:
		if rail_entry == null or not is_instance_valid(rail_entry):
			continue
		var rail_node: Node = rail_entry as Node
		if rail_node == null:
			continue
		if not rail_node.has_method("try_start_with_body"):
			continue
		if _object_has_property(rail_node, "active") and not bool(rail_node.get("active")):
			continue

		if not _object_has_property(rail_node, "path"):
			continue
		var rail_path_variant: Variant = rail_node.get("path")
		if not (rail_path_variant is Path3D):
			continue
		var rail_path: Path3D = rail_path_variant
		if rail_path == null or rail_path.curve == null:
			continue
		if _rail_path != null and rail_path == _rail_path:
			continue

		var curve := rail_path.curve
		var total_length := curve.get_baked_length()
		if total_length <= 0.01:
			continue

		var offset := _rail_find_closest_offset(rail_path, curve, global_position)
		if rail_switch_min_end_distance > 0.0:
			if offset <= rail_switch_min_end_distance or offset >= total_length - rail_switch_min_end_distance:
				continue

		var point := rail_path.to_global(curve.sample_baked(offset))
		var to_point := point - global_position
		var to_flat := to_point - side_up * to_point.dot(side_up)
		var flat_len := to_flat.length()
		if flat_len < 0.001:
			continue

		var side_dot := to_flat.normalized().dot(right)
		if side_dot == 0.0:
			continue
		if sign(side_dot) != desired_side or abs(side_dot) < rail_switch_side_dot_min:
			continue

		var tangent := _rail_sample_path_tangent(rail_path, curve, offset, rail_switch_tangent_lookahead)
		if tangent.length() < 0.001:
			continue
		tangent = tangent.normalized()

		var forward_dot := travel_dir.dot(tangent)
		if abs(forward_dot) < rail_switch_forward_dot_min:
			continue

		var dist_sq := to_point.length_squared()
		if dist_sq > max_switch_dist_sq:
			continue
		var side_score : float = abs(side_dot)
		var pick := false
		if dist_sq < best_dist_sq - 0.001:
			pick = true
		elif abs(dist_sq - best_dist_sq) <= 0.001:
			if forward_dot > best_forward + 0.001 or (abs(forward_dot - best_forward) <= 0.001 and side_score > best_side + 0.001):
				pick = true
		if pick:
			best_dist_sq = dist_sq
			best_forward = forward_dot
			best_side = side_score
			result = {
				"rail": rail_node,
				"path": rail_path,
				"offset": offset,
				"point": point,
				"tangent": tangent,
				"side_dot": side_dot
			}

	return result


func _update_rail_switch_candidate(world_up: Vector3) -> void:
	_rail_switch_candidate = null
	_rail_switch_candidate_point = Vector3.ZERO
	_rail_switch_candidate_tangent = Vector3.ZERO
	_rail_switch_candidate_side = 0.0

	var side := _get_rail_switch_side_input()
	if side == 0.0:
		return

	var candidate := _find_rail_switch_candidate(side, world_up)
	if candidate.is_empty():
		return

	_rail_switch_candidate = candidate.get("rail")
	_rail_switch_candidate_point = candidate.get("point", Vector3.ZERO)
	_rail_switch_candidate_tangent = candidate.get("tangent", Vector3.ZERO)
	_rail_switch_candidate_side = side


func _start_rail_switch(candidate: Dictionary, world_up: Vector3) -> void:
	var rail_node: Node3D = candidate.get("rail")
	if rail_node == null:
		return

	_rail_switch_inherited_speed = abs(_rail_speed)
	_rail_switch_inherited_dir = _rail_last_motion_dir
	if _rail_switch_inherited_dir.length() < 0.001:
		_rail_switch_inherited_dir = _model_forward
	if _rail_switch_inherited_dir.length() < 0.001:
		_rail_switch_inherited_dir = -global_transform.basis.z
	_rail_switch_inherited_dir = _rail_switch_inherited_dir.normalized()

	_rail_switch_active = true
	_rail_switch_timer = max(rail_switch_max_duration, 0.0)
	_rail_switch_target = rail_node
	_rail_switch_target_path = candidate.get("path")
	_rail_switch_target_offset = float(candidate.get("offset", 0.0))
	_rail_switch_target_point = candidate.get("point", Vector3.ZERO)
	_rail_switch_target_tangent = candidate.get("tangent", Vector3.ZERO)

	_end_rail(true, world_up)
	_jump_requested = false
	_jump_dash_requested = false
	_jump_variable = false
	_jump_hang_allowed = false
	_jump_time = 0.0

	var homing_speed: float = max(rail_switch_lateral_speed, 0.0)
	_rail_switch_homing_speed = homing_speed

	var v := _rail_switch_inherited_dir * homing_speed
	velocity = v
	_last_air_velocity = v


func _try_start_rail_switch(world_up: Vector3) -> bool:
	if not rail_switch_enabled:
		return false
	if _rail_switch_active:
		return false

	var side := _get_rail_switch_side_input()
	if side == 0.0:
		return false

	var candidate := _find_rail_switch_candidate(side, world_up)
	if candidate.is_empty():
		return false

	_start_rail_switch(candidate, world_up)
	return true


func _cancel_rail_switch() -> void:
	_rail_switch_active = false
	if _rail_switch_inherited_speed <= 0.0:
		return

	var dir := _rail_switch_inherited_dir
	if dir.length() < 0.001:
		dir = _model_forward
	if dir.length() < 0.001:
		dir = -global_transform.basis.z
	if dir.length() < 0.001:
		return

	velocity = dir.normalized() * _rail_switch_inherited_speed
	_last_air_velocity = velocity


func _update_rail_switch(delta: float) -> void:
	if not _rail_switch_active:
		return
	if _rail_active or attached:
		_cancel_rail_switch()
		return

	_rail_switch_timer = max(_rail_switch_timer - delta, 0.0)

	if _rail_switch_target == null or not is_instance_valid(_rail_switch_target):
		_cancel_rail_switch()
		return

	var rail_path: Path3D = _rail_switch_target_path
	if rail_path == null:
		rail_path = _rail_switch_target.path
	if rail_path == null or rail_path.curve == null:
		_cancel_rail_switch()
		return

	var curve := rail_path.curve
	var total_length := curve.get_baked_length()
	if total_length <= 0.01:
		_cancel_rail_switch()
		return

	var offset: float = _rail_find_closest_offset(rail_path, curve, global_position)
	if rail_switch_min_end_distance > 0.0:
		if offset <= rail_switch_min_end_distance or offset >= total_length - rail_switch_min_end_distance:
			_cancel_rail_switch()
			return

	var point: Vector3 = rail_path.to_global(curve.sample_baked(offset))
	_rail_switch_target_point = point
	_rail_switch_target_offset = offset

	var dist: float = global_position.distance_to(point)
	var tangent: Vector3 = _rail_sample_path_tangent(rail_path, curve, offset, rail_switch_tangent_lookahead)
	if tangent.length() < 0.001:
		tangent = _rail_switch_target_tangent
	if tangent.length() < 0.001:
		tangent = -rail_path.global_transform.basis.z
	if tangent.length() < 0.001:
		tangent = Vector3.FORWARD
	tangent = tangent.normalized()

	var inherit_dir: Vector3 = _rail_switch_inherited_dir
	if inherit_dir.length() < 0.001:
		inherit_dir = _model_forward
	if inherit_dir.length() < 0.001:
		inherit_dir = -global_transform.basis.z
	inherit_dir = inherit_dir.normalized()

	var travel_sign: float = 1.0
	if tangent.dot(inherit_dir) < 0.0:
		travel_sign = -1.0
	var tangent_dir: Vector3 = tangent * travel_sign

	if dist <= rail_switch_snap_distance or _rail_switch_timer <= 0.0:
		var inherit_speed: float = max(_rail_switch_inherited_speed, 0.0)
		var entry_velocity: Vector3 = tangent_dir * inherit_speed
		var entry_forward: Vector3 = inherit_dir

		if _rail_switch_target.has_method("build_session_params_for_entry"):
			var params: Dictionary = _rail_switch_target.call(
				"build_session_params_for_entry",
				point,
				entry_velocity,
				entry_forward
			)
			if not params.is_empty():
				start_rail_grind(params)

		if _rail_active:
			_rail_switch_active = false
			return

		_cancel_rail_switch()
		return

	var forward_speed: float = max(_rail_switch_inherited_speed * rail_switch_forward_speed_scale, rail_switch_forward_speed_min)
	if forward_speed <= 0.01:
		forward_speed = max(_rail_switch_inherited_speed, 0.01)

	var lateral_speed: float = max(_rail_switch_homing_speed, 0.0)
	var to_target: Vector3 = point - global_position
	var lateral_to_target: Vector3 = to_target - tangent_dir * to_target.dot(tangent_dir)
	var lateral_dist: float = lateral_to_target.length()
	var lateral_vel: float = 0.0
	var lateral_dir: Vector3 = Vector3.ZERO
	var lateral_step: float = 0.0

	if lateral_dist > 0.001 and lateral_speed > 0.0:
		lateral_dir = lateral_to_target / lateral_dist
		lateral_step = min(lateral_dist, lateral_speed * delta)
		lateral_vel = lateral_step / max(delta, 0.001)

	var step: Vector3 = tangent_dir * (forward_speed * delta) + lateral_dir * lateral_step
	global_position += step
	velocity = tangent_dir * forward_speed + lateral_dir * lateral_vel
	_last_air_velocity = velocity


func start_rail_grind(params: Dictionary) -> void:
	if not can_start_rail_grind():
		can_grind_rails = false
		return
	can_grind_rails = true
	if _rail_active:
		_end_rail(false, gravity_up.normalized())

	if _homing_active:
		cancel_homing_attack(false)

	# Keep barrier blast gauge while on rails; rails don't consume it but can build it.

	var path: Path3D = params.get("path")
	if path == null or path.curve == null:
		return

	var curve := path.curve
	var length := curve.get_baked_length()
	if length <= 0.01:
		return

	_rail_path = path
	_rail_node = params.get("rail_node")
	_rail_total_length = length
	_rail_distance = clamp(params.get("start_offset", 0.0), 0.0, _rail_total_length)
	_rail_speed = params.get("initial_speed", 0.0)
	if abs(_rail_speed) < 0.01:
		_rail_speed = params.get("min_speed", 0.0)

	if abs(_rail_speed) < 0.01:
		var fallback : float = max(params.get("lock_speed_value", 0.0), params.get("min_speed", 0.0))
		if fallback <= 0.0:
			fallback = 5.0
		_rail_speed = fallback

	_rail_align_model = params.get("align_model", true)
	_rail_align_to_path_tilt = params.get("align_to_path_tilt", rail_align_to_path_tilt)
	_rail_allow_jump_exit = params.get("allow_jump_exit", true)
	_rail_allow_reverse = params.get("allow_reverse", true)
	_rail_input_reverse_enabled = params.get("allow_input_reverse", rail_allow_input_reverse)
	_rail_end_detach_distance = max(float(params.get("end_detach_distance", rail_end_detach_distance)), 0.0)
	_rail_min_speed = params.get("min_speed", 0.0)
	_rail_locked_speed = params.get("lock_speed_enabled", false)
	_rail_lock_speed_value = params.get("lock_speed_value", 0.0)
	if _rail_locked_speed and _rail_lock_speed_value <= 0.0:
		_rail_locked_speed = false
	_rail_gravity_scale = params.get("gravity_scale", 1.0)
	_rail_reverse_speed_threshold = max(float(params.get("reverse_speed_threshold", rail_reverse_speed_threshold)), 0.0)
	_rail_reverse_boost_speed = max(float(params.get("reverse_boost_speed", rail_reverse_boost_speed)), 0.0)
	_rail_attach_height = params.get("player_height_offset", rail_default_attach_height)
	if _rail_attach_height <= 0.0:
		_rail_attach_height = rail_default_attach_height
	_rail_last_tangent = Vector3.FORWARD

	if not _rail_allow_reverse and _rail_speed < 0.0:
		_rail_speed = abs(_rail_speed)

	var start_travel_sign := float(params.get("start_travel_sign", 0.0))
	if abs(start_travel_sign) > 0.001:
		_rail_travel_sign = -1.0 if start_travel_sign < 0.0 else 1.0
	else:
		_rail_travel_sign = -1.0 if _rail_speed < 0.0 else 1.0
	if not _rail_allow_reverse and _rail_travel_sign < 0.0:
		_rail_travel_sign = 1.0
	var start_tangent := _get_rail_tangent_world(curve, _rail_distance, _rail_total_length)
	if start_tangent.length() > 0.001:
		_rail_last_tangent = start_tangent.normalized()
	_rail_last_motion_dir = _rail_last_tangent * _rail_travel_sign
	var dir_den : float = max(rail_anim_dir_speed_for_full, 0.001)
	_rail_anim_dir_smoothed = clamp(_rail_speed / dir_den, -1.0, 1.0)
	_rail_anim_speed_smoothed = 0.0

	_rail_active = true
	attached = true
	_prev_attached = true
	_clear_attack_state_for_rail_landing()
	_jump_dash_requested = false
	_spline_active = false
	_spring_align_timer = 0.0
	_bounce_state = BounceState.NONE
	_is_jumping = false
	_is_falling = false

	_spring_movement_lock_timer = max(_spring_movement_lock_timer, params.get("movement_lock_time", 0.0))
	_spring_action_lock_timer = max(_spring_action_lock_timer, params.get("action_lock_time", 0.0))
	_play_rail_land_sfx()


func can_start_rail_grind() -> bool:
	if _is_dead:
		return false
	if _rail_grind_action == null:
		return false
	return _rail_grind_action.can_grind()


func _clear_attack_state_for_rail_landing() -> void:
	if _active_action != null and is_instance_valid(_active_action):
		clear_active_action()
	_attack_sources = 0
	_jumped_from_ground = false
	_jump_dash_recent_timer = 0.0
	_homing_post_attack_timer = 0.0
	_enemy_attack_chain_active = false
	_bounce_state = BounceState.NONE
	rolling = false
	_reset_spindash_state()
	_set_attack_source(AttackSource.MANUAL, false)


func _update_rail_motion(delta: float, world_up: Vector3) -> void:
	if not _rail_active or _rail_path == null or _rail_path.curve == null:
		_rail_active = false
		_rail_crouching = false
		_stop_rail_grind_sfx()
		return

	# Ignore movement input while rail grinding unless explicitly enabled.
	if not _rail_input_reverse_enabled:
		_move_input = Vector2.ZERO

	if _debug_visible:
		_update_rail_switch_candidate(world_up)

	var curve := _rail_path.curve

	if _rail_allow_jump_exit and _spring_movement_lock_timer <= 0.0:
		if Input.is_action_just_pressed("action_0"):
			if _try_start_rail_switch(world_up):
				return
			_end_rail(true, world_up)
			return

	_rail_crouching = false
	if rail_crouch_enabled and roll_enabled and not _local_pause_enabled and not _ui_input_blocked and not _debug_mode:
		_rail_crouching = Input.is_action_pressed("action_7")

	var spindash_on_rail: bool = _spindash_charging and spindash_enabled
	var signed_speed := _rail_speed
	var prev_travel_sign := _rail_travel_sign
	var travel_sign := _rail_travel_sign
	if abs(signed_speed) > 0.0001:
		travel_sign = -1.0 if signed_speed < 0.0 else 1.0

	var rail_dir := _get_rail_tangent_world(curve, _rail_distance, _rail_total_length)
	if rail_dir.length() < 0.001:
		rail_dir = _rail_last_tangent
	if rail_dir.length() < 0.001:
		rail_dir = -_rail_path.global_transform.basis.z
	if rail_dir.length() < 0.001:
		rail_dir = Vector3.FORWARD
	rail_dir = rail_dir.normalized()

	if _rail_allow_reverse and _rail_input_reverse_enabled and _rail_reverse_speed_threshold > 0.0 and abs(signed_speed) <= _rail_reverse_speed_threshold:
		var input_dir := _get_rail_input_direction(Vector3.UP)
		if input_dir.length() > 0.001:
			var input_dot := rail_dir.dot(input_dir)
			if input_dot >= rail_reverse_input_dot_threshold:
				travel_sign = 1.0
			elif input_dot <= -rail_reverse_input_dot_threshold:
				travel_sign = -1.0

			if travel_sign != 0.0 and abs(signed_speed) < _rail_reverse_boost_speed:
				signed_speed = _rail_reverse_boost_speed * travel_sign
			elif abs(signed_speed) > 0.0001:
				signed_speed = abs(signed_speed) * travel_sign

	if not _rail_allow_reverse and travel_sign < 0.0:
		travel_sign = 1.0

	_rail_travel_sign = travel_sign

	if _rail_locked_speed and _rail_lock_speed_value > 0.0 and not spindash_on_rail and not _spindash_release_requested:
		signed_speed = _rail_lock_speed_value * travel_sign
	else:
		if spindash_on_rail:
			var gravity_up := Vector3.UP
			var accel = -gravity_strength * _rail_gravity_scale * rail_dir.dot(gravity_up)
			signed_speed += accel * delta

			var speed_mag : float = abs(signed_speed)
			var charge_decel : float = max(spindash_charge_decel, 0.0)
			speed_mag = max(speed_mag - charge_decel * delta, 0.0)
			if speed_mag <= 0.0:
				signed_speed = 0.0
			else:
				var sign := travel_sign
				if abs(sign) < 0.001:
					sign = -1.0 if signed_speed < 0.0 else 1.0
				if abs(sign) < 0.001:
					sign = 1.0
				signed_speed = speed_mag * sign
		else:
			var gravity_up := Vector3.UP
			var accel = -gravity_strength * _rail_gravity_scale * rail_dir.dot(gravity_up)
			signed_speed += accel * delta

			if _rail_crouching:
				var motion_sign := travel_sign
				if signed_speed < -0.0001:
					motion_sign = -1.0
				elif signed_speed > 0.0001:
					motion_sign = 1.0
				var motion_dir := rail_dir * motion_sign
				var gravity_up_dir := gravity_up.normalized()
				if gravity_up_dir.length() < 0.001:
					gravity_up_dir = world_up
				if gravity_up_dir.length() < 0.001:
					gravity_up_dir = Vector3.UP
				var slope_dot := motion_dir.dot(gravity_up_dir)
				var speed_mag : float = abs(signed_speed)
				if slope_dot > 0.0001:
					speed_mag = max(speed_mag - rail_crouch_uphill_decel * slope_dot * delta, 0.0)
				elif slope_dot < -0.0001:
					speed_mag += rail_crouch_downhill_accel * (-slope_dot) * delta
				var sign := motion_sign
				if abs(signed_speed) <= 0.0001:
					sign = travel_sign if abs(travel_sign) > 0.001 else 1.0
				signed_speed = speed_mag * sign

			if _rail_allow_reverse and _rail_input_reverse_enabled and prev_travel_sign != travel_sign:
				if _rail_reverse_boost_speed > 0.0 and abs(signed_speed) < _rail_reverse_boost_speed:
					signed_speed = _rail_reverse_boost_speed * travel_sign

			var apply_min_speed := _rail_min_speed > 0.0
			if _rail_crouching and _rail_allow_reverse and _rail_input_reverse_enabled:
				apply_min_speed = false
			if apply_min_speed:
				var dir := travel_sign
				if signed_speed < -0.0001:
					dir = -1.0
				elif signed_speed > 0.0001:
					dir = 1.0
				signed_speed = max(abs(signed_speed), _rail_min_speed) * dir
			elif not _rail_allow_reverse and signed_speed < 0.0:
				signed_speed = 0.0

	if _spindash_release_requested:
		var release_sign := _get_rail_spindash_release_sign(rail_dir, world_up)
		var target_speed: float = max(_spindash_entry_speed, max(_spindash_release_speed, 0.0))
		signed_speed = target_speed * release_sign
		travel_sign = release_sign
		_spindash_turn_free_timer = max(spindash_turn_penalty_disable_time, 0.0)
		_spindash_release_requested = false
		_spindash_release_with_jump = false
		_spindash_release_speed = 0.0
		_trigger_anim_command(&"CMD_RAIL")

	_rail_speed = signed_speed
	if abs(_rail_speed) > 0.0001:
		_rail_travel_sign = -1.0 if _rail_speed < 0.0 else 1.0

	var end_buffer : float = clamp(_rail_end_detach_distance, 0.0, _rail_total_length * 0.5)
	if end_buffer > 0.0:
		if prev_travel_sign > 0.0 and _rail_distance >= _rail_total_length - end_buffer:
			var exit_distance := _rail_total_length
			var exit_tangent := _get_rail_tangent_world(curve, exit_distance, _rail_total_length)
			if exit_tangent.length() < 0.001:
				exit_tangent = _rail_last_tangent
			if exit_tangent.length() < 0.001 and _rail_path != null:
				exit_tangent = -_rail_path.global_transform.basis.z
			if exit_tangent.length() < 0.001:
				exit_tangent = Vector3.FORWARD
			exit_tangent = exit_tangent.normalized()
			_rail_last_tangent = exit_tangent
			_rail_last_motion_dir = exit_tangent
			_end_rail(false, world_up)
			return
		if prev_travel_sign < 0.0 and _rail_distance <= end_buffer:
			var exit_distance := 0.0
			var exit_tangent := _get_rail_tangent_world(curve, exit_distance, _rail_total_length)
			if exit_tangent.length() < 0.001:
				exit_tangent = _rail_last_tangent
			if exit_tangent.length() < 0.001 and _rail_path != null:
				exit_tangent = -_rail_path.global_transform.basis.z
			if exit_tangent.length() < 0.001:
				exit_tangent = Vector3.FORWARD
			exit_tangent = exit_tangent.normalized()
			_rail_last_tangent = exit_tangent
			_rail_last_motion_dir = exit_tangent * -1.0
			_end_rail(false, world_up)
			return

	var next_distance := _rail_distance + _rail_speed * delta
	if next_distance < 0.0 or next_distance > _rail_total_length:
		_rail_distance = clamp(next_distance, 0.0, _rail_total_length)
		var exit_sign := _rail_travel_sign
		if abs(exit_sign) < 0.001:
			exit_sign = prev_travel_sign
			if abs(exit_sign) < 0.001:
				exit_sign = -1.0 if _rail_speed < 0.0 else 1.0
		var exit_tangent := _get_rail_tangent_world(curve, _rail_distance, _rail_total_length)
		if exit_tangent.length() < 0.001:
			exit_tangent = _rail_last_tangent
		if exit_tangent.length() < 0.001 and _rail_path != null:
			exit_tangent = -_rail_path.global_transform.basis.z
		if exit_tangent.length() < 0.001:
			exit_tangent = Vector3.FORWARD
		exit_tangent = exit_tangent.normalized()
		_rail_last_tangent = exit_tangent
		_rail_last_motion_dir = exit_tangent * exit_sign
		_end_rail(false, world_up)
		return

	_rail_distance = next_distance

	var xf_local := curve.sample_baked_with_rotation(_rail_distance)
	var xf_world := _rail_path.global_transform * xf_local

	var path_dir := Vector3.ZERO
	var up_vec := world_up
	var sample_up_valid := false
	var tilt_was_applied := false
	if _rail_align_to_path_tilt:
		var basis_forward := -xf_world.basis.z
		if basis_forward.length() > 0.001:
			path_dir = basis_forward.normalized()
		var basis_up := xf_world.basis.y
		if basis_up.length() > 0.001:
			var up_candidate := basis_up.normalized()
			var dot_limit := 0.0
			if path_dir.length() > 0.001:
				dot_limit = abs(path_dir.normalized().dot(up_candidate))
			if dot_limit < 0.999:
				up_vec = up_candidate
				sample_up_valid = true

	if path_dir.length() < 0.001:
		var tangent_vec = _get_rail_tangent_world(curve, _rail_distance, _rail_total_length)
		if tangent_vec.length() < 0.001:
			tangent_vec = _rail_last_tangent
		if tangent_vec.length() < 0.001:
			tangent_vec = Vector3.FORWARD
		path_dir = tangent_vec.normalized()
	var motion_dir = path_dir * travel_sign
	_rail_last_tangent = path_dir
	_rail_last_motion_dir = motion_dir.normalized()

	if _rail_align_to_path_tilt and not sample_up_valid:
		var tilt_up := _get_rail_up_vector(curve, path_dir, _rail_distance)
		if tilt_up.length() > 0.001:
			up_vec = tilt_up
			tilt_was_applied = true

	if _rail_align_to_path_tilt and not tilt_was_applied:
		var tilt_angle := _get_rail_tilt(curve, _rail_distance)
		if abs(tilt_angle) > 0.0001 and path_dir.length() > 0.001 and up_vec.length() > 0.001:
			var tilt_axis := path_dir.normalized()
			up_vec = (Basis(tilt_axis, tilt_angle) * up_vec).normalized()

	if up_vec.length() < 0.001:
		up_vec = world_up
	up_vec -= path_dir * up_vec.dot(path_dir)
	if up_vec.length() < 0.001:
		up_vec = world_up - path_dir * world_up.dot(path_dir)
	if up_vec.length() < 0.001:
		up_vec = world_up
	up_vec = up_vec.normalized()
	visual_up = up_vec
	up_direction = visual_up

	var attach_offset := visual_up * _rail_attach_height
	global_position = xf_world.origin + attach_offset
	velocity = motion_dir * abs(_rail_speed)
	attached = true

	if _rail_align_model:
		# Keep visual forward aligned to the rail path, not travel direction.
		var face_dir := path_dir
		if spindash_on_rail:
			var desired_sign := _get_rail_spindash_release_sign(path_dir, world_up)
			face_dir = path_dir * desired_sign
		var f : Vector3 = face_dir - visual_up * face_dir.dot(visual_up)
		if f.length() > 0.001:
			_model_forward = f.normalized()
		var right := _model_forward.cross(visual_up)
		if right.length() < 0.001:
			right = Vector3.RIGHT - visual_up * Vector3.RIGHT.dot(visual_up)
		if right.length() < 0.001:
			right = Vector3.RIGHT
		right = right.normalized()
		var forward := visual_up.cross(right).normalized()
		_rail_model_basis = Basis(right, visual_up, -forward).orthonormalized()
		_rail_model_basis_valid = true
	else:
		_rail_model_basis_valid = false
	_refresh_carried_object_target_after_external_motion()


func _end_rail(jumped: bool, world_up: Vector3) -> void:
	if not _rail_active:
		return

	if _rail_node != null and _rail_node.has_method("refresh_cooldown"):
		_rail_node.refresh_cooldown(self)
	_rail_node = null

	_stop_rail_grind_sfx()
	_rail_active = false
	_rail_anim_speed_smoothed = 0.0
	_rail_crouching = false

	var exit_dir := _rail_last_motion_dir.normalized()
	if exit_dir.length() < 0.001:
		exit_dir = -Vector3.FORWARD

	velocity = exit_dir * abs(_rail_speed)
	attached = false
	if exit_dir.length() > 0.001:
		_model_forward = exit_dir.normalized()

	if jumped:
		remove_coyote_jump_eligibility()
		var jump_dir := visual_up.normalized()
		if jump_dir.length() < 0.001:
			jump_dir = world_up.normalized()
		velocity += jump_dir * rail_jump_vertical_speed
		_is_jumping = true
		_jump_variable = true
		_jump_time = 0.0
		_jump_hang_allowed = true
		_just_jumped = true
		_jump_dash_used_this_air = false
		_tornado_kick_used_this_air = false
		_jumped_from_ground = true
		_falling_without_jump = false
		play_jump_sfx()
		_trigger_anim_command(&"CMD_JUMP")
	else:
		_is_jumping = false
		_jump_variable = false
		_jump_time = 0.0
		_jump_dash_used_this_air = false
		_tornado_kick_used_this_air = false
		_jumped_from_ground = false
		_falling_without_jump = true

	visual_up = world_up

	if _trick_detector != null:
		_trick_detector.reset()


# ===========================================================
# WATER PHYSICS
# ===========================================================

func _on_water_body_entered(body: Node3D) -> void:
	_register_water_volume_entry(body)

func _on_water_body_exited(body: Node3D) -> void:
	_register_water_volume_exit(body)

func _is_water_collider(collider: Node) -> bool:
	if collider == null:
		return false
	return collider.is_in_group("water") or collider.is_in_group("water_surface")

func _can_land_on_water_surface(velocity_before: Vector3, normal: Vector3) -> bool:
	if not water_physics_enabled:
		return false
	if _water_reattach_cooldown_timer > 0.0:
		return false
	if velocity_before.length() < water_surface_landing_min_tangential_speed:
		return false

	var metrics := PlayerMath.compute_radial_landing_metrics(velocity_before, normal)
	var radial_angle: float = metrics.angle
	var tangential_speed: float = metrics.tangent_speed

	if tangential_speed < water_surface_landing_min_tangential_speed:
		return false
	if radial_angle > water_surface_landing_max_angle_deg:
		return false

	return true


func _apply_water_vertical_speed_slowdown(vertical: float, delta: float) -> float:
	var max_up: float = jump_speed * water_max_up_speed_mult
	var max_down: float = max_fall_speed * water_max_down_speed_mult
	var rate: float = max(water_vertical_speed_slowdown_rate, 0.0)
	if vertical > max_up:
		if rate <= 0.0:
			return vertical
		return max(vertical - rate * delta, max_up)
	if vertical < -max_down:
		if rate <= 0.0:
			return vertical
		return min(vertical + rate * delta, -max_down)
	return vertical


func _update_water_physics_state(delta: float) -> void:
	if not water_physics_enabled:
		return

	_water_reattach_cooldown_timer = max(_water_reattach_cooldown_timer - delta, 0.0)

	# Determine full submersion based on grounded state and head position
	var was_fully_submerged: bool = _fully_submerged
	if attached:
		# When grounded, require head to be underwater for full submersion (neck-deep)
		_fully_submerged = _in_water_volume and _head_in_water_volume
	else:
		# When airborne, body in water is enough for full submersion
		_fully_submerged = _in_water_volume

	# Detect state transitions for splash sounds
	if _in_water_volume and not was_fully_submerged and _fully_submerged:
		_was_airborne_before_water_entry = not attached
		_play_water_entry_splash()
	elif not _in_water_volume and _was_in_water_volume:
		_play_water_exit_splash()
		_was_airborne_before_water_entry = false

	_was_in_water_volume = _in_water_volume

	# Update water footstep timer
	if _in_water_volume:
		# Enforce minimum wetness when entering/being in water
		if _water_footstep_timer < water_footstep_min_time:
			_water_footstep_timer = water_footstep_min_time
		# Accumulate additional wetness (capped at max)
		_water_footstep_timer = min(_water_footstep_timer + delta, water_footstep_max_time)
	else:
		# Count down when dry
		_water_footstep_timer = max(_water_footstep_timer - delta, 0.0)

	# Update water surface running (if enabled)
	if _running_on_water_surface and attached:
		_check_water_surface_min_speed()


func _get_water_surface_run_normal() -> Vector3:
	var normal: Vector3 = _water_surface_normal.normalized()
	if normal.length() < 0.001:
		normal = surface_normal.normalized()
	if normal.length() < 0.001:
		normal = Vector3.UP
	return normal


func _check_water_surface_min_speed() -> void:
	if not _running_on_water_surface or not attached:
		return
	var normal: Vector3 = _get_water_surface_run_normal()
	var lateral_speed: float = velocity.slide(normal).length()
	if lateral_speed < water_surface_min_speed:
		_drop_from_water_surface(normal)


func _can_start_water_surface_running(normal: Vector3) -> bool:
	if not water_physics_enabled:
		return false
	if _water_reattach_cooldown_timer > 0.0:
		return false
	var water_normal: Vector3 = normal.normalized()
	if water_normal.length() < 0.001:
		water_normal = Vector3.UP
	var lateral_speed: float = velocity.slide(water_normal).length()
	return lateral_speed >= water_surface_min_speed


func _start_water_surface_running(normal: Vector3) -> void:
	var water_normal: Vector3 = normal.normalized()
	if water_normal.length() < 0.001:
		water_normal = Vector3.UP
	_running_on_water_surface = true
	_in_water_volume = false
	_fully_submerged = false
	_water_surface_normal = water_normal


func _drop_from_water_surface(normal: Vector3) -> void:
	var surface_normal_for_drop: Vector3 = normal.normalized()
	if surface_normal_for_drop.length() < 0.001:
		surface_normal_for_drop = Vector3.UP
	attached = false
	_running_on_water_surface = false
	_in_water_volume = true
	_fully_submerged = true
	_water_reattach_cooldown_timer = water_reattach_cooldown
	_attachment_immunity = max(_attachment_immunity, water_reattach_cooldown)
	_clear_coyote_jump_window()
	var sink_depth: float = max(water_surface_sink_depth, 0.0)
	if sink_depth > 0.0:
		global_position -= surface_normal_for_drop * sink_depth
	var down_speed: float = max(water_surface_sink_down_speed, 0.0)
	if down_speed > 0.0:
		var normal_speed: float = velocity.dot(surface_normal_for_drop)
		if normal_speed > -down_speed:
			velocity -= surface_normal_for_drop * (normal_speed + down_speed)

func _get_water_surface_normal(area: Area3D) -> Vector3:
	if area != null and is_instance_valid(area):
		return area.global_transform.basis.y.normalized()
	return Vector3.UP


func _get_splash_tier(vel: Vector3, surface_normal: Vector3) -> int:
	# Returns 0 = none, 1 = soft, 2 = medium, 3 = hard
	if vel.length() < 0.001:
		return 0
	var incidence_angle_deg: float = rad_to_deg(acos(clamp(abs(vel.normalized().dot(surface_normal)), 0.0, 1.0)))
	# Incidence angle is measured from the normal, so 0 = head-on, 90 = glancing
	var entry_angle_deg: float = 90.0 - incidence_angle_deg
	if entry_angle_deg < water_splash_min_angle_deg:
		return 0
	if entry_angle_deg < water_splash_soft_angle_deg:
		return 1
	if entry_angle_deg < water_splash_hard_angle_deg:
		return 2
	return 3


func _play_water_entry_splash() -> void:
	var normal: Vector3 = _get_water_surface_normal(_water_last_entry_area)
	var tier: int = _get_splash_tier(velocity, normal)
	var sounds: Array[AudioStream]
	match tier:
		1: sounds = sfx_water_enter_soft
		2: sounds = sfx_water_enter_medium
		3: sounds = sfx_water_enter_hard
	_last_splash_index = _play_water_sfx_from_array(sounds, _last_splash_index)


func _play_water_exit_splash() -> void:
	var normal: Vector3 = _get_water_surface_normal(_water_last_entry_area)
	var tier: int = _get_splash_tier(velocity, normal)
	var sounds: Array[AudioStream]
	match tier:
		1: sounds = sfx_water_exit_soft
		2: sounds = sfx_water_exit_medium
		3: sounds = sfx_water_exit_hard
	_last_splash_index = _play_water_sfx_from_array(sounds, _last_splash_index)


func _play_water_sfx_from_array(sounds: Array[AudioStream], last_index: int) -> int:
	if sounds.is_empty():
		return last_index
	var player: AudioStreamPlayer3D = get_node_or_null(water_sounds_player)
	if player == null or not is_instance_valid(player):
		return last_index
	var idx: int
	if sounds.size() > 1 and last_index >= 0:
		idx = randi_range(0, sounds.size() - 2)
		if idx >= last_index:
			idx += 1
	else:
		idx = randi_range(0, sounds.size() - 1)
	player.stream = sounds[idx]
	player.play()
	return idx
