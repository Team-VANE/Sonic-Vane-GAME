# ===========================================================
# HIGH-LEVEL PLAYER STATE
# ===========================================================

enum MainState {
	GROUNDED,
	AIRBORNE,
	SPRING,
	SPLINE,
	RAIL,
}

var main_state: int = MainState.AIRBORNE
var main_state_time: float = 0.0  # time spent in current main state

# Bit flags for sub-states / tags.
const STATE_GROUNDED: int = 1 << 0
const STATE_MOVING: int = 1 << 1
const STATE_SKIDDING: int = 1 << 2
const STATE_JUMPING: int = 1 << 3
const STATE_FALLING: int = 1 << 4
const STATE_LOOPING: int = 1 << 5
const STATE_JUMP_DASH: int = 1 << 6
const STATE_SPRING: int = 1 << 7
const STATE_SPLINE: int = 1 << 8
const STATE_LANDING_HARD: int = 1 << 9
const STATE_RAIL: int = 1 << 10
const STATE_BARRIER_BLAST: int = 1 << 11
const STATE_ROLL: int = 1 << 12
const STATE_SPINDASH: int = 1 << 13
const STATE_RAIL_FORWARD: int = 1 << 14
const STATE_RAIL_BACKWARD: int = 1 << 15
const STATE_SPINDASHRAIL: int = 1 << 16
const STATE_DRIFT: int = 1 << 17
const STATE_LIGHTSPEED_DASH: int = 1 << 18
const STATE_SKYDIVE: int = 1 << 19
const ENEMY_BOUNCE_COOLDOWN_SEC: float = 0.12
const SKYDIVE_ANIM_NONE: int = 0
const SKYDIVE_ANIM_DIVE: int = 1
const SKYDIVE_ANIM_GLIDE: int = 2
const SKYDIVE_ANIM_CANCEL: int = 3
const SKYDIVE_ANIM_EXIT: int = 4

enum AttackSource {
	JUMP = 1 << 0,
	ROLL = 1 << 1,
	SPINDASH = 1 << 2,
	JUMP_DASH = 1 << 3,
	BOUNCE = 1 << 4,
	HOMING = 1 << 5,
	LIGHTSPEED = 1 << 6,
	MANUAL = 1 << 7,
	ENEMY_CHAIN = 1 << 8,
	SPIN_KICK = 1 << 9,
	AIR_UNCURL = 1 << 10,
}

enum CombatClass {
	NEUTRAL  = 0,
	ROCK     = 1,
	PAPER    = 2,
	SCISSORS = 3,
}

enum CombatOutcome {
	WIN  =  1,
	DRAW =  0,
	LOSE = -1,
}

var state_flags: int = 0  # current frame tags
var _attack_sources: int = 0
var _is_dead: bool = false

# Usage examples:

# if player.has_state(SonicPlayer.STATE_SKIDDING):
	# do skid-specific VFX

# if player.main_state == SonicPlayer.MainState.SPRING:
	# camera rail behavior, etc.

# ===========================================================
# LIFECYCLE
# ===========================================================
func _ready() -> void:
	_functional_max_speed = max(max_speed, 0.0)
	randomize()
	_cache_hurt_flash_renderers()
	# Let the custom adhesion system handle what is 'walkable'.
	floor_max_angle = deg_to_rad(40.0)
	floor_block_on_wall = false
	floor_stop_on_slope = false
	# Disable built-in platform leave velocity. Godot's get_platform_velocity()
	# includes angular surface velocity (omega x r) from rotating RigidBody3D
	# contacts, which causes velocity spikes on spinning physics objects.
	# The custom platform carry system handles leave velocity for intentional platforms.
	platform_on_leave = PLATFORM_ON_LEAVE_DO_NOTHING

	# Optionally make walls more “slidey” instead of sticky
	wall_min_slide_angle = 0.0
	floor_snap_length = 0.0

	# If unset, tie full-volume speed to run_top_speed
	if footstep_full_volume_speed <= 0.0:
		footstep_full_volume_speed = run_top_speed

	if ground_ray != null:
		ground_ray.exclude_parent = true
		ground_ray.collide_with_areas = false
		ground_ray.collision_mask = ground_ray.collision_mask | WATER_SURFACE_RAY_LAYER
		ground_ray.add_exception(self)

	_initial_transform = global_transform

	if not _net_saved_collision:
		_net_initial_collision_layer = collision_layer
		_net_initial_collision_mask = collision_mask
		_net_saved_collision = true

	_network_configure_for_role()
	_ensure_modules()
	_apply_character_visual_profile()
	_cache_default_character_effect_colors()
	_set_jump_ball_tint(_default_jump_ball_tint)
	_connect_trick_signals()

	if _network_is_local_authority():
		_ensure_debug_input_actions()
		_update_mouse_lock()
		_create_debug_hud()
		_init_actions()
		_set_special_gauge_ui(_barrier_blast_gauge)
		_update_flight_gauge_ui()
		var h = _get_hud_node()
		if h != null and h.has_method("set_rings"):
			h.call("set_rings", rings)

	_ensure_name_tag()

	if anim_tree:
		# Route AnimationTree advance-expression evaluation to this player.
		# Many state-machine transitions call player methods/properties
		# (has_state, attached, _get_lateral_speed_for_anim, anim_state, etc.).
		# Without this, those expressions evaluate on the AnimationTree node,
		# causing transition stalls (for example trick -> FallBlend, and
		# To_Any_Grounded_State -> LAND/LAND_MOVING).
		anim_tree.advance_expression_base_node = anim_tree.get_path_to(self)
		anim_state = anim_tree.get(PlayerAnimation.SM_BASE + "/playback")
		ground_state = anim_tree.get(PlayerAnimation.SM_GROUND + "/playback")
		_carry_overlay_state = anim_tree.get(carry_overlay_playback_parameter) as AnimationNodeStateMachinePlayback
		_configure_carry_overlay_filter()
		_initialize_carry_overlay_animation()
		anim_tree.active = true
		#_dump_animtree_params()
		if anim_state == null:
			push_error("AnimationTree playback not found - check path '%s/playback'" % PlayerAnimation.SM_BASE)

		
		#_debug_anim_tree_params()

	# Buddy scene fallback (avoid preload-time hard failure if the editor hasn't scanned files yet).
	if buddy_scene == null:
		var s = load("res://LS5Framework/Scenes/Buddy/BuddySonicPlayer.tscn")
		if s is PackedScene:
			buddy_scene = s

	_ensure_modules()
	_setup_water_detection()
	if buddy_enable and SettingsManager.buddy_active:
		call_deferred("spawn_selected_buddy")

func _setup_water_detection() -> void:
	if not water_physics_enabled:
		return
	for child in get_children():
		if child is Area3D and child.name == "WaterDetector":
			child.body_entered.connect(_on_water_body_entered)
			child.body_exited.connect(_on_water_body_exited)
			child.area_entered.connect(_on_water_area_entered)
			child.area_exited.connect(_on_water_area_exited)
		if child is Area3D and child.name == "HeadWaterDetector":
			_head_water_detector_node = child
			child.body_entered.connect(_on_head_water_body_entered)
			child.body_exited.connect(_on_head_water_body_exited)
			child.area_entered.connect(_on_head_water_area_entered)
			child.area_exited.connect(_on_head_water_area_exited)

func _on_water_area_entered(area: Area3D) -> void:
	_register_water_volume_entry(area)

func _on_water_area_exited(area: Area3D) -> void:
	_register_water_volume_exit(area)

func _register_water_volume_entry(collider: Node3D) -> void:
	if not water_physics_enabled:
		return
	if collider == null or not collider.is_in_group("water"):
		return
	_water_volume_count += 1
	if _water_volume_count > 0:
		_in_water_volume = true
	_water_last_collider = collider
	var entry_area: Area3D = collider as Area3D
	if entry_area != null:
		_water_last_entry_area = entry_area

func _register_water_volume_exit(collider: Node3D) -> void:
	if not water_physics_enabled:
		return
	if collider == null or not collider.is_in_group("water"):
		return
	_water_volume_count = max(_water_volume_count - 1, 0)
	if _water_volume_count <= 0:
		_in_water_volume = false
		_running_on_water_surface = false
		_water_reattach_cooldown_timer = water_reattach_cooldown

func _on_head_water_body_entered(body: Node3D) -> void:
	if not water_physics_enabled:
		return
	if body.is_in_group("water"):
		_head_water_volume_count += 1
		if _head_water_volume_count > 0:
			_head_in_water_volume = true
			_notify_head_entered_water()

func _on_head_water_body_exited(body: Node3D) -> void:
	if not water_physics_enabled:
		return
	if body.is_in_group("water"):
		_head_water_volume_count = max(_head_water_volume_count - 1, 0)
		if _head_water_volume_count <= 0:
			_head_in_water_volume = false
			_notify_head_exited_water()

func _on_head_water_area_entered(area: Area3D) -> void:
	if not water_physics_enabled:
		return
	if area.is_in_group("water"):
		_head_water_volume_count += 1
		if _head_water_volume_count > 0:
			_head_in_water_volume = true
			_notify_head_entered_water()

func _on_head_water_area_exited(area: Area3D) -> void:
	if not water_physics_enabled:
		return
	if area.is_in_group("water"):
		_head_water_volume_count = max(_head_water_volume_count - 1, 0)
		if _head_water_volume_count <= 0:
			_head_in_water_volume = false
			_notify_head_exited_water()

func _notify_head_entered_water() -> void:
	if _drowned_action != null and is_instance_valid(_drowned_action):
		if not _drowned_action.is_drowned():
			_drowned_action.start_countdown()

func _notify_head_exited_water() -> void:
	if _drowned_action != null and is_instance_valid(_drowned_action):
		if not _drowned_action.is_drowned():
			_drowned_action.stop_countdown()

func _connect_trick_signals() -> void:
	if _trick_detector != null and _trick_system != null:
		var trick_detected_callable: Callable = Callable(self, "_on_trick_detected")
		if not _trick_detector.trick_detected.is_connected(trick_detected_callable):
			_trick_detector.trick_detected.connect(trick_detected_callable)
	if _trick_system != null and _trick_ui != null:
		var combo_updated_callable: Callable = Callable(self, "_on_combo_updated")
		if not _trick_system.combo_updated.is_connected(combo_updated_callable):
			_trick_system.combo_updated.connect(combo_updated_callable)
		var trick_sequence_callable: Callable = Callable(self, "_on_trick_sequence_updated")
		if not _trick_system.trick_sequence_updated.is_connected(trick_sequence_callable):
			_trick_system.trick_sequence_updated.connect(trick_sequence_callable)
		push_warning("Trick signals connected: detector=%s system=%s ui=%s" % [_trick_detector != null, _trick_system != null, _trick_ui != null])
	if _trick_system != null:
		var trick_performed_callable: Callable = Callable(self, "_on_trick_performed")
		if not _trick_system.trick_performed.is_connected(trick_performed_callable):
			_trick_system.trick_performed.connect(trick_performed_callable)


func _create_debug_hud() -> void:
	var canvas: CanvasLayer = CanvasLayer.new()
	add_child(canvas)
	_debug_label = Label.new()
	canvas.add_child(_debug_label)
	_debug_label.anchor_left = 0.0
	_debug_label.anchor_top = 0.0
	_debug_label.offset_left = 10.0
	_debug_label.offset_top = 10.0
	_debug_label.autowrap_mode = TextServer.AUTOWRAP_OFF
	_debug_label.add_theme_color_override("font_color", Color(1.0, 1.0, 1.0, 1.0))
	_debug_label.visible = _debug_visible

func _update_mouse_lock() -> void:
	if not _network_is_local_authority():
		return
	if lock_cursor_to_game:
		Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	else:
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)


func _handle_debug_enter_press() -> void:
	var in_race: bool = (race_in_countdown or race_active) and not race_finished
	if not in_race:
		_set_debug_mode(not _debug_mode)
		return

	if _race_debug_confirmed:
		_set_debug_mode(not _debug_mode)
		return

	if _debug_mode:
		_race_debug_confirmed = true
		_set_debug_mode(not _debug_mode)
		return

	if _race_debug_confirm_pending and _race_debug_confirm_timer > 0.0:
		_race_debug_confirm_pending = false
		_race_debug_confirm_timer = 0.0
		_race_debug_confirmed = true
		_set_debug_mode(true)
		return

	_race_debug_confirm_pending = true
	_race_debug_confirm_timer = 3.0
	show_prompt("Press again to activate debug (high score will not be saved)", 3.0)

## Sends an explicit interaction request to nearby RaceStart nodes.
## This is a fallback for online sessions where the area node may miss input polling.
func _try_interact_with_race_start() -> bool:
	if _local_pause_enabled:
		return false
	if _ui_input_blocked:
		return false
	if _debug_mode:
		return false
	if get_tree() == null:
		return false
	var starts = get_tree().get_nodes_in_group("RaceStart")
	for start in starts:
		if start == null or not is_instance_valid(start):
			continue
		if not start.has_method("try_open_race_settings_menu_from_player"):
			continue
		var handled = start.call("try_open_race_settings_menu_from_player", self)
		if handled is bool and bool(handled):
			return true
	return false


## Sends an explicit interaction request to nearby Terminal nodes.
## This is a fallback for online sessions where the area node may miss input polling.
func _try_interact_with_terminal() -> bool:
	if _local_pause_enabled:
		return false
	if _ui_input_blocked:
		return false
	if _debug_mode:
		return false
	if get_tree() == null:
		return false
	var terminals = get_tree().get_nodes_in_group("Terminal")
	for terminal in terminals:
		if terminal == null or not is_instance_valid(terminal):
			continue
		if not terminal.has_method("try_open_terminal_menu_from_player"):
			continue
		var handled = terminal.call("try_open_terminal_menu_from_player", self)
		if handled is bool and bool(handled):
			return true
	return false


func is_carrying_object() -> bool:
	return _has_carried_object()


func _has_carried_object() -> bool:
	return _carried_object and is_instance_valid(_carried_object)


func _process_carry_action_inputs() -> bool:
	if not carry_objects_enabled:
		return false
	if _carry_throw_pending_release:
		return false
	if _action_input_locked():
		return false
	if carry_throw_input_action != &"" and _has_carried_object():
		if Input.is_action_just_pressed(String(carry_throw_input_action)):
			_throw_carried_object()
			return true
	if carry_put_down_input_action != &"" and carry_put_down_input_action != &"interact" and _has_carried_object():
		if Input.is_action_just_pressed(String(carry_put_down_input_action)):
			_put_down_carried_object()
			return true
	if carry_pickup_input_action != &"" and carry_pickup_input_action != &"interact" and not _has_carried_object():
		if Input.is_action_just_pressed(String(carry_pickup_input_action)):
			return _try_pick_up_carryable()
	return false


func _try_handle_carry_interact() -> bool:
	if not carry_objects_enabled:
		return false
	if _carry_throw_pending_release:
		return false
	if carry_pickup_input_action != &"interact" and carry_put_down_input_action != &"interact":
		return false
	if _action_input_locked():
		return false
	if _has_carried_object():
		if carry_put_down_input_action != &"interact":
			return false
		if _should_throw_carried_object_from_interact():
			_throw_carried_object()
		else:
			_put_down_carried_object()
		return true
	if carry_pickup_input_action != &"interact":
		return false
	return _try_pick_up_carryable()


func _try_pick_up_carryable() -> bool:
	if not _can_pick_up_carryable_now():
		return false
	var carryable: Node3D = _find_best_carryable_object()
	if not carryable:
		return false
	var target_transform: Transform3D = _get_carry_target_transform()
	if not carryable.has_method("begin_carry"):
		return false
	var handled: Variant = carryable.call("begin_carry", self, target_transform, carry_release_player_collision_lock)
	if handled is bool and not bool(handled):
		return false
	_carried_object = carryable
	_clear_active_action_if_carry_blocked()
	_request_carry_pickup_animation()
	return true


func _put_down_carried_object() -> void:
	if not _has_carried_object():
		_carried_object = null
		return
	var carryable: Node3D = _carried_object
	_carry_put_down_release_transform = _get_safe_carry_put_down_transform(carryable)
	_carry_put_down_release_velocity = velocity * max(carry_release_inherit_velocity_scale, 0.0)
	_carry_put_down_pending_release = true
	_carry_put_down_anim_started = false
	_carry_put_down_release_wait_frames = 2
	_force_carry_overlay_blend_visible()
	if _play_carry_overlay_state(carry_put_down_overlay_state):
		return
	if carry_put_down_anim_command != &"":
		_trigger_anim_command(carry_put_down_anim_command)
		return
	release_carried_object_from_put_down_animation()


func release_carried_object_from_put_down_animation() -> void:
	if not _has_carried_object():
		_clear_pending_carry_put_down()
		return
	var carryable: Node3D = _carried_object
	if not _carry_put_down_pending_release:
		_carry_put_down_release_transform = _get_safe_carry_put_down_transform(carryable)
		_carry_put_down_release_velocity = velocity * max(carry_release_inherit_velocity_scale, 0.0)
		_carry_put_down_pending_release = true
	if carryable.has_method("put_down"):
		carryable.call("put_down", _carry_put_down_release_transform, _carry_put_down_release_velocity, carry_release_player_collision_lock)
	elif carryable.has_method("release_carry"):
		carryable.call("release_carry", _carry_put_down_release_transform, _carry_put_down_release_velocity, carry_release_player_collision_lock)
	_carried_object = null
	_clear_pending_carry_put_down()


func _clear_pending_carry_put_down() -> void:
	_carry_pickup_pending_overlay = false
	_carry_pickup_overlay_started = false
	_carry_put_down_pending_release = false
	_carry_put_down_anim_started = false
	_carry_put_down_release_wait_frames = 0
	_carry_put_down_release_transform = Transform3D.IDENTITY
	_carry_put_down_release_velocity = Vector3.ZERO


func _throw_carried_object() -> void:
	if not _has_carried_object():
		_carried_object = null
		return
	_carry_throw_release_transform = Transform3D.IDENTITY
	_carry_throw_release_velocity = Vector3.ZERO
	_carry_throw_pending_release = true
	_carry_throw_anim_started = false
	_carry_throw_release_wait_frames = 2
	if carry_throw_anim_command != &"":
		_trigger_anim_command(carry_throw_anim_command)
		return
	release_carried_object_from_throw_animation()


func release_carried_object_from_throw_animation() -> void:
	if not _carry_throw_pending_release:
		return
	if not _has_carried_object():
		_clear_pending_carry_throw()
		return
	var carryable: Node3D = _carried_object
	var release_transform: Transform3D = _get_carry_fallback_target_transform()
	var release_velocity: Vector3 = _get_carry_throw_release_velocity()
	if carryable.has_method("throw_from_carry"):
		carryable.call("throw_from_carry", release_transform, release_velocity, carry_release_player_collision_lock)
	elif carryable.has_method("release_carry"):
		carryable.call("release_carry", release_transform, release_velocity, carry_release_player_collision_lock)
	play_voice_event(&"carry_throw")
	_carried_object = null
	_clear_pending_carry_throw()


func _get_carry_throw_release_velocity() -> Vector3:
	var up: Vector3 = _get_carry_up()
	var forward: Vector3 = _get_carry_forward(up)
	var inherited_velocity: Vector3 = velocity * max(carry_release_inherit_velocity_scale, 0.0)
	return inherited_velocity + forward * max(carry_throw_forward_speed, 0.0) + up * carry_throw_up_speed


func _update_carried_object_target() -> void:
	if not _has_carried_object():
		_carried_object = null
		return
	if _carried_object.has_method("is_carried"):
		var carried_state: Variant = _carried_object.call("is_carried")
		if carried_state is bool and not bool(carried_state):
			_carried_object = null
			return
	if _carried_object.has_method("set_carry_target_transform"):
		_carried_object.call("set_carry_target_transform", _get_carry_target_transform())


func _refresh_carried_object_target_after_external_motion() -> void:
	if not _has_carried_object():
		return
	_update_carried_object_target()


func _can_pick_up_carryable_now() -> bool:
	if not carry_objects_enabled:
		return false
	if _has_carried_object():
		return false
	if _local_pause_enabled or _ui_input_blocked or _debug_mode:
		return false
	if get_tree() != null and get_tree().paused:
		return false
	if race_in_countdown and not race_active:
		return false
	if _is_dead or _hurt_active:
		return false
	if not _active_action or not is_instance_valid(_active_action):
		return true
	if not (_active_action is CharacterActionType):
		return true
	var allows_pickup: Variant = _active_action.get("can_pick_up_carryables_while_active")
	return not (allows_pickup is bool) or bool(allows_pickup)


func _can_execute_action_while_carrying(action: Node) -> bool:
	if not _has_carried_object():
		return true
	if not action or not is_instance_valid(action):
		return true
	if not (action is CharacterActionType):
		return true
	var allows_carry: Variant = action.get("can_execute_while_carrying")
	return not (allows_carry is bool) or bool(allows_carry)


func _clear_active_action_if_carry_blocked() -> void:
	if not _active_action or not is_instance_valid(_active_action):
		return
	if _can_execute_action_while_carrying(_active_action):
		return
	clear_active_action()


func _find_best_carryable_object() -> Node3D:
	if get_tree() == null:
		return null
	var up: Vector3 = _get_carry_up()
	var forward: Vector3 = _get_carry_forward(up)
	var pickup_radius: float = _get_carry_pickup_radius(up)
	var best_object: Node3D = null
	var best_score: float = INF
	var carryables: Array = get_tree().get_nodes_in_group(carry_object_group)
	for carryable_variant in carryables:
		if not (carryable_variant is Node3D):
			continue
		var carryable: Node3D = carryable_variant as Node3D
		if not is_instance_valid(carryable):
			continue
		if carryable == _carried_object:
			continue
		if carryable.has_method("can_be_carried_by"):
			var allowed: Variant = carryable.call("can_be_carried_by", self)
			if allowed is bool and not bool(allowed):
				continue
		var to_object: Vector3 = carryable.global_position - global_position
		var distance: float = to_object.length()
		if distance > pickup_radius:
			continue
		var lateral: Vector3 = to_object - up * to_object.dot(up)
		var forward_dot: float = 1.0
		if lateral.length() > 0.001:
			forward_dot = forward.dot(lateral.normalized())
		if forward_dot < carry_pickup_min_forward_dot:
			continue
		if not _can_reach_carryable_without_obstruction(carryable, up):
			continue
		var score: float = distance - forward_dot
		if score < best_score:
			best_score = score
			best_object = carryable
	return best_object


func _can_reach_carryable_without_obstruction(carryable: Node3D, up: Vector3) -> bool:
	if not carry_pickup_requires_clear_path:
		return true
	if carry_pickup_obstruction_mask <= 0:
		return true
	var world: World3D = get_world_3d()
	if world == null:
		return true
	var ray_up: Vector3 = up
	if ray_up.length() < 0.001:
		ray_up = Vector3.UP
	ray_up = ray_up.normalized()
	var from_position: Vector3 = global_position + ray_up * max(carry_pickup_obstruction_start_up_offset, 0.0)
	var to_position: Vector3 = carryable.global_position + ray_up * max(carry_pickup_obstruction_target_up_offset, 0.0)
	var query: PhysicsRayQueryParameters3D = PhysicsRayQueryParameters3D.create(from_position, to_position)
	query.collision_mask = carry_pickup_obstruction_mask
	query.collide_with_areas = false
	query.collide_with_bodies = true
	query.exclude = [self, carryable]
	var hit: Dictionary = world.direct_space_state.intersect_ray(query)
	return hit.is_empty()


func _get_carry_pickup_radius(up: Vector3) -> float:
	var base_radius: float = max(carry_pickup_radius, 0.0)
	var lateral_velocity: Vector3 = velocity - up * velocity.dot(up)
	var speed_extra: float = lateral_velocity.length() * max(carry_pickup_speed_radius_scale, 0.0)
	speed_extra = min(speed_extra, max(carry_pickup_speed_radius_max, 0.0))
	return base_radius + speed_extra


func _should_throw_carried_object_from_interact() -> bool:
	if _move_input.length() >= carry_interact_throw_input_threshold:
		return true
	var up: Vector3 = _get_carry_up()
	var lateral_velocity: Vector3 = velocity - up * velocity.dot(up)
	return lateral_velocity.length() >= max(carry_interact_throw_speed_threshold, 0.0)


func _get_carry_target_transform() -> Transform3D:
	var carry_bone_transform: Variant = _get_carry_bone_transform()
	if carry_bone_transform is Transform3D:
		return carry_bone_transform
	if carry_anchor and is_instance_valid(carry_anchor):
		return _get_unscaled_carry_transform(carry_anchor.global_transform)
	return _get_carry_fallback_target_transform()


func _get_carry_fallback_target_transform() -> Transform3D:
	var up: Vector3 = _get_carry_up()
	var forward: Vector3 = _get_carry_forward(up)
	var right: Vector3 = forward.cross(up)
	if right.length() < 0.001:
		right = global_transform.basis.x
	right = right.normalized()
	var offset: Vector3 = carry_fallback_offset
	var position: Vector3 = global_position + right * offset.x + up * offset.y - forward * offset.z
	var basis: Basis = Basis().looking_at(forward, up)
	return Transform3D(basis, position)


func _get_unscaled_carry_transform(source_transform: Transform3D) -> Transform3D:
	return Transform3D(source_transform.basis.orthonormalized(), source_transform.origin)


func _get_carry_bone_transform() -> Variant:
	if carry_bone_name == &"":
		return null
	var skeleton: Skeleton3D = _get_carry_skeleton()
	if not skeleton:
		return null
	var bone_index: int = skeleton.find_bone(String(carry_bone_name))
	if bone_index < 0:
		return null
	var bone_transform: Transform3D = skeleton.global_transform * skeleton.get_bone_global_pose(bone_index) * carry_bone_offset
	return _get_unscaled_carry_transform(bone_transform)


func _get_carry_skeleton() -> Skeleton3D:
	if carry_skeleton and is_instance_valid(carry_skeleton):
		return carry_skeleton
	if model_root and is_instance_valid(model_root):
		return _find_first_skeleton(model_root)
	return null


func _find_first_skeleton(root: Node) -> Skeleton3D:
	for child: Node in root.get_children():
		if child is Skeleton3D:
			return child as Skeleton3D
		var skeleton: Skeleton3D = _find_first_skeleton(child)
		if skeleton:
			return skeleton
	return null


func _get_carry_put_down_transform() -> Transform3D:
	var up: Vector3 = _get_carry_up()
	var forward: Vector3 = _get_carry_forward(up)
	var position: Vector3 = global_position + forward * max(carry_put_down_forward_distance, 0.0) + up * carry_put_down_up_offset
	var basis: Basis = Basis().looking_at(forward, up)
	return Transform3D(basis, position)


func _get_safe_carry_put_down_transform(carryable: Node3D) -> Transform3D:
	var desired_transform: Transform3D = _get_carry_put_down_transform()
	if not carry_put_down_validate_placement:
		return desired_transform
	if carry_put_down_placement_mask <= 0:
		return desired_transform
	var world: World3D = get_world_3d()
	if world == null:
		return desired_transform
	var up: Vector3 = _get_carry_up()
	var forward: Vector3 = _get_carry_forward(up)
	var right: Vector3 = forward.cross(up)
	if right.length() < 0.001:
		right = global_transform.basis.x
	right = right.normalized()
	var candidate_positions: Array[Vector3] = _get_carry_put_down_candidate_positions(desired_transform.origin, forward, right, up)
	var best_transform: Transform3D = _get_unscaled_carry_transform(carryable.global_transform)
	var best_score: float = INF
	for candidate_position: Vector3 in candidate_positions:
		var candidate_transform: Transform3D = Transform3D(desired_transform.basis, candidate_position)
		if not _is_carry_put_down_transform_safe(candidate_transform, carryable, up, world):
			continue
		var forward_distance: float = max((candidate_position - global_position).dot(forward), 0.0)
		var side_distance: float = abs((candidate_position - desired_transform.origin).dot(right))
		var up_distance: float = abs((candidate_position - desired_transform.origin).dot(up))
		var score: float = desired_transform.origin.distance_to(candidate_position) + side_distance * 0.35 + up_distance * 0.2 + forward_distance * 0.05
		if score < best_score:
			best_score = score
			best_transform = Transform3D(desired_transform.basis, candidate_position)
	return best_transform


func _get_carry_put_down_candidate_positions(origin: Vector3, forward: Vector3, right: Vector3, up: Vector3) -> Array[Vector3]:
	var candidates: Array[Vector3] = [origin]
	var forward_steps: int = maxi(carry_put_down_safe_forward_steps, 0)
	var side_steps: int = maxi(carry_put_down_safe_side_steps, 0)
	var up_steps: int = maxi(carry_put_down_safe_up_steps, 0)
	var forward_extra: float = max(carry_put_down_safe_forward_extra, 0.0)
	var side_distance: float = max(carry_put_down_safe_side_distance, 0.0)
	var up_distance: float = max(carry_put_down_safe_up_distance, 0.0)
	for forward_step: int in range(forward_steps + 1):
		var forward_offset: float = 0.0
		if forward_steps > 0:
			forward_offset = forward_extra * float(forward_step) / float(forward_steps)
		for up_step: int in range(up_steps + 1):
			var up_offset: float = 0.0
			if up_steps > 0:
				up_offset = up_distance * float(up_step) / float(up_steps)
			for side_step: int in range(-side_steps, side_steps + 1):
				var side_offset: float = 0.0
				if side_steps > 0:
					side_offset = side_distance * float(side_step) / float(side_steps)
				var candidate_position: Vector3 = origin + forward * forward_offset + right * side_offset + up * up_offset
				if candidate_position.distance_squared_to(origin) <= 0.0001:
					continue
				candidates.append(candidate_position)
	return candidates


func _is_carry_put_down_transform_safe(candidate_transform: Transform3D, carryable: Node3D, up: Vector3, world: World3D) -> bool:
	if not _is_carry_put_down_body_motion_safe(candidate_transform, carryable, up):
		return false
	var candidate_position: Vector3 = candidate_transform.origin
	var clearance_radius: float = max(carry_put_down_clearance_radius, 0.01)
	var clearance_up: float = max(carry_put_down_clearance_up_offset, 0.0)
	var clearance_offsets: Array[Vector3] = [
		Vector3.ZERO,
		up * clearance_up,
		-up * clearance_radius,
	]
	for clearance_offset: Vector3 in clearance_offsets:
		if _carry_put_down_clearance_overlaps(candidate_position + clearance_offset, clearance_radius, carryable, world):
			return false
	var from_position: Vector3 = global_position + up * max(carry_put_down_obstruction_start_up_offset, 0.0)
	var to_position: Vector3 = candidate_position + up * clearance_up
	var ray_query: PhysicsRayQueryParameters3D = PhysicsRayQueryParameters3D.create(from_position, to_position)
	ray_query.collision_mask = carry_put_down_placement_mask
	ray_query.collide_with_areas = false
	ray_query.collide_with_bodies = true
	ray_query.exclude = _get_carry_put_down_query_excludes(carryable)
	var hit: Dictionary = world.direct_space_state.intersect_ray(ray_query)
	return hit.is_empty()


func _is_carry_put_down_body_motion_safe(candidate_transform: Transform3D, carryable: Node3D, up: Vector3) -> bool:
	if not (carryable is PhysicsBody3D):
		return true
	var body: PhysicsBody3D = carryable as PhysicsBody3D
	var test_parameters: PhysicsTestMotionParameters3D = PhysicsTestMotionParameters3D.new()
	test_parameters.from = candidate_transform
	test_parameters.motion = Vector3.ZERO
	test_parameters.margin = max(carry_put_down_body_test_margin, 0.0)
	test_parameters.recovery_as_collision = true
	test_parameters.exclude_bodies = [get_rid()]
	if PhysicsServer3D.body_test_motion(body.get_rid(), test_parameters):
		return false
	var nudge_parameters: PhysicsTestMotionParameters3D = PhysicsTestMotionParameters3D.new()
	nudge_parameters.from = candidate_transform
	nudge_parameters.motion = -up * max(carry_put_down_body_test_margin, 0.01)
	nudge_parameters.margin = max(carry_put_down_body_test_margin, 0.0)
	nudge_parameters.recovery_as_collision = true
	nudge_parameters.exclude_bodies = [get_rid()]
	return not PhysicsServer3D.body_test_motion(body.get_rid(), nudge_parameters)


func _carry_put_down_clearance_overlaps(position: Vector3, radius: float, carryable: Node3D, world: World3D) -> bool:
	var shape: SphereShape3D = SphereShape3D.new()
	shape.radius = radius
	var shape_query: PhysicsShapeQueryParameters3D = PhysicsShapeQueryParameters3D.new()
	shape_query.shape = shape
	shape_query.transform = Transform3D(Basis.IDENTITY, position)
	shape_query.collision_mask = carry_put_down_placement_mask
	shape_query.collide_with_areas = false
	shape_query.collide_with_bodies = true
	shape_query.exclude = _get_carry_put_down_query_excludes(carryable)
	var overlaps: Array[Dictionary] = world.direct_space_state.intersect_shape(shape_query, 1)
	return not overlaps.is_empty()


func _get_carry_put_down_query_excludes(carryable: Node3D) -> Array[RID]:
	var excludes: Array[RID] = [get_rid()]
	if carryable is CollisionObject3D:
		excludes.append((carryable as CollisionObject3D).get_rid())
	return excludes


func _get_carry_up() -> Vector3:
	var up: Vector3 = visual_up
	if up.length() < 0.001:
		up = gravity_up
	if up.length() < 0.001:
		up = Vector3.UP
	return up.normalized()


func _get_carry_forward(up: Vector3) -> Vector3:
	var forward: Vector3 = -global_transform.basis.z
	if model_root and is_instance_valid(model_root):
		forward = -model_root.global_transform.basis.z
	forward -= up * forward.dot(up)
	if forward.length() < 0.001:
		forward = _move_direction
		forward -= up * forward.dot(up)
	if forward.length() < 0.001:
		forward = _control_forward
		forward -= up * forward.dot(up)
	if forward.length() < 0.001:
		forward = -global_transform.basis.z
	return forward.normalized()


func _unhandled_input(event: InputEvent) -> void:
	if not _network_is_local_authority():
		return
	if _ui_input_blocked:
		return
	if _post_ui_unblock_action_suppress_timer > 0.0:
		return
	if _local_pause_enabled:
		return
	if get_tree() != null and get_tree().paused:
		return
	# --- DEBUG HUD TOGGLE ---
	# Option A: F12 (no echo, so it only fires once per key press)
	#if event is InputEventKey and not event.echo and event.keycode == Key.KEY_F12:
	#	_debug_visible = !_debug_visible
	#	if _debug_label:
	#		_debug_label.visible = _debug_visible
	#	return

	# Option B: custom input action "debug_toggle" (set in Input Map)
	if event.is_action_pressed("debug_toggle"):
		_debug_visible = !_debug_visible
		if _debug_label:
			_debug_label.visible = _debug_visible
		return

	# --- DEBUG MODE TOGGLE / ANIM CYCLE ---
	if debug_mode_enabled and _debug_inputs_allowed():
		if event.is_action_pressed("debug_enter"):
			_handle_debug_enter_press()
			return
		if _debug_mode:
			if event.is_action_pressed("debug_next_anim"):
				_debug_cycle_animation(1)
				return
			if event.is_action_pressed("debug_prev_anim"):
				_debug_cycle_animation(-1)
				return

	# --- BUDDY SPAWN / DESPAWN ---
	if buddy_enable and _debug_inputs_allowed():
		if event.is_action_pressed("buddy_spawn"):
			_toggle_buddy()
			return

	# --- ONLINE / UI DEBUG ---
	if _debug_visible:
		var session_active: bool = false
		var session_id: int = 0
		if multiplayer != null and multiplayer.has_multiplayer_peer():
			session_active = true
			session_id = multiplayer.get_unique_id()
		
		_debug_label.text += "\n[ONLINE / UI]\n"
		_debug_label.text += "Session Active: %s (ID: %d)\n" % [session_active, session_id]
		_debug_label.text += "Local Auth: %s\n" % [_network_is_local_authority()]
		_debug_label.text += "UI Blocked: %s\n" % [_ui_input_blocked]
		_debug_label.text += "Camera Rig: %s\n" % [camera_rig != null]
		if camera_rig != null and camera_rig.has_method("is_constraint_active"):
			_debug_label.text += "Cam Constraint: %s\n" % [camera_rig.is_constraint_active()]

	# --- RACE INTERACT ---
	if event.is_action_pressed("interact"):
		_gracefully_end_airborne_torque()
		if _has_carried_object() and _try_handle_carry_interact():
			return
		if _try_interact_with_race_start():
			return
		if _try_interact_with_terminal():
			return
		_try_handle_carry_interact()
		return

	# --- OTHER HOTKEYS ---
	if event.is_action_pressed("toggle_mouse_lock"):
		lock_cursor_to_game = !lock_cursor_to_game
		_update_mouse_lock()
	elif event.is_action_pressed("spawn_online_debug_puppet") and _debug_inputs_allowed():
		_toggle_online_debug_puppet()
	elif event.is_action_pressed("unstuck"):
		unstuck_now()
	elif event.is_action_pressed("respawn") and not (event is InputEventJoypadButton or event is InputEventJoypadMotion):
		respawn_now()
	elif event.is_action_pressed("respawn_checkpoint") and not (event is InputEventJoypadButton or event is InputEventJoypadMotion) and _debug_inputs_allowed():
		respawn_checkpoint_now()

	if event is InputEventMouseMotion:
		_manual_airborne_mouse_delta += event.relative



func _respawn() -> void:
	_is_dead = false
	_on_player_hurt()
	# Default respawn: PlayerSpawn (preferred), otherwise initial spawn.
	var target_transform: Transform3D = _initial_transform
	var resolved_respawn: Node3D = _resolve_respawn_point()
	var downwarp_hit: bool = false
	var downwarp_point: Vector3 = Vector3.ZERO
	var downwarp_normal: Vector3 = Vector3.UP
	if resolved_respawn != null:
		target_transform = resolved_respawn.global_transform
		var downwarp_info: Dictionary = DownwarpUtil.apply_downwarp_from_node_with_hit(
			resolved_respawn,
			target_transform,
			[self]
		)
		if downwarp_info.has("xform") and downwarp_info["xform"] is Transform3D:
			target_transform = downwarp_info["xform"]
		if downwarp_info.has("hit"):
			downwarp_hit = bool(downwarp_info["hit"])
		if downwarp_info.has("point") and downwarp_info["point"] is Vector3:
			downwarp_point = downwarp_info["point"]
		if downwarp_info.has("normal") and downwarp_info["normal"] is Vector3:
			downwarp_normal = downwarp_info["normal"]
	_apply_respawn_transform(target_transform, false, downwarp_hit, downwarp_point, downwarp_normal)


func _respawn_to_checkpoint() -> void:
	_is_dead = false
	_on_player_hurt()
	# Checkpoint respawn: last checkpoint, otherwise fallback to default respawn.
	var using_checkpoint: bool = checkpoint_enabled and _checkpoint_active
	if using_checkpoint:
		_apply_respawn_transform(_checkpoint_transform, true)
	else:
		_respawn()


func _apply_respawn_transform(
	target_transform: Transform3D,
	use_checkpoint_velocity: bool,
	force_grounded: bool = false,
	grounded_point: Vector3 = Vector3.ZERO,
	grounded_normal: Vector3 = Vector3.UP
) -> void:
	clear_max_speed_overrides()
	cancel_rail_grind()
	cancel_spline_spring()
	global_transform = target_transform

	velocity = Vector3.ZERO
	var has_checkpoint_vel: bool = false
	if use_checkpoint_velocity and _checkpoint_respawn_speed > 0.0 and _checkpoint_respawn_dir.length() > 0.001:
		var d: Vector3 = _checkpoint_respawn_dir.normalized()
		velocity = d * _checkpoint_respawn_speed
		has_checkpoint_vel = true

	# Reset floor/adhesion state to avoid snapping back to stale surface normals.
	_airborne_time = 0.0
	_physics_up_last = Vector3.UP
	up_direction = Vector3.UP
	surface_normal = Vector3.UP
	surface_point = global_position
	_is_falling = false
	_is_jumping = false
	_jumped_from_ground = false
	_falling_without_jump = false
	_reset_directional_influence_lock()
	_reset_stable_attach_normal()
	_homing_post_attack_timer = 0.0
	_attack_sources = 0

	# Checkpoint respawns treat the player as attached only if they have a saved velocity/direction.
	attached = has_checkpoint_vel
	_prev_attached = has_checkpoint_vel
	if attached:
		_record_attach_state(surface_normal, Vector3.UP)

	_reset_spindash_state()
	_cancel_barrier_blast()
	rolling = false
	_unlock_local_camera_constraints()
	_notify_camera_teleport()
	_sync_buddy_after_leader_teleport()

	if force_grounded:
		_apply_grounded_from_downwarp(grounded_point, grounded_normal)
	if _hurt_action != null and _hurt_action.has_method("clear_death_grounded_respawn_hold"):
		_hurt_action.call("clear_death_grounded_respawn_hold")
	_restart_animation_state_machine_for_respawn()


func _restart_animation_state_machine_for_respawn() -> void:
	_pending_anim_command = &""
	_pending_anim_crossfade = -1.0
	var start_node: StringName = _get_respawn_animation_start_node()
	if anim_state != null and anim_state.has_method("start"):
		anim_state.start(start_node)
	elif anim_state != null:
		anim_state.travel(start_node)
	var ground_start_node: StringName = _get_respawn_ground_animation_start_node()
	if ground_state != null and ground_state.has_method("start"):
		ground_state.start(ground_start_node)
	elif ground_state != null:
		ground_state.travel(ground_start_node)


func _get_respawn_animation_start_node() -> StringName:
	if attached:
		return &"GROUND_MACHINE"
	var sm: AnimationNodeStateMachine = _get_main_animation_state_machine()
	if sm != null:
		if sm.has_node(&"FallBlend"):
			return &"FallBlend"
		if sm.has_node(&"FALL"):
			return &"FALL"
		if sm.has_node(&"GAME_Fall"):
			return &"GAME_Fall"
	return &"FallBlend"


func _get_main_animation_state_machine() -> AnimationNodeStateMachine:
	if anim_tree == null:
		return null
	var root = anim_tree.tree_root
	if root is AnimationNodeStateMachine:
		return root
	if root is AnimationNodeBlendTree:
		var bt: AnimationNodeBlendTree = root
		var sm_node_name: String = PlayerAnimation.SM_BASE.replace("parameters/", "")
		if bt.has_node(sm_node_name):
			return bt.get_node(sm_node_name) as AnimationNodeStateMachine
	return null


func _get_respawn_ground_animation_start_node() -> StringName:
	var sm: AnimationNodeStateMachine = _get_ground_animation_state_machine()
	if sm != null:
		if sm.has_node(&"IDLE"):
			return &"IDLE"
		if sm.has_node(&"IDLE_ANIMATION"):
			return &"IDLE_ANIMATION"
		if sm.has_node(&"GAME_Idle"):
			return &"GAME_Idle"
	return &"IDLE"


func _get_ground_animation_state_machine() -> AnimationNodeStateMachine:
	var sm: AnimationNodeStateMachine = _get_main_animation_state_machine()
	if sm == null or not sm.has_node(&"GROUND_MACHINE"):
		return null
	return sm.get_node(&"GROUND_MACHINE") as AnimationNodeStateMachine


func _resolve_respawn_point() -> Node3D:
	var level_manager = _get_level_manager()
	if level_manager != null:
		if level_manager.has_method("resolve_node_in_current_level"):
			var n = level_manager.call("resolve_node_in_current_level", NodePath("PlayerSpawn"))
			if n is Node3D:
				respawn_point = n
				return n
		if level_manager.has_method("get_current_level"):
			var level = level_manager.call("get_current_level")
			if level is Node:
				var n2 = level.get_node_or_null("PlayerSpawn")
				if n2 is Node3D:
					respawn_point = n2
					return n2

	if get_tree() != null:
		var cs = get_tree().current_scene
		if cs != null:
			var n3 = cs.get_node_or_null("PlayerSpawn")
			if n3 is Node3D:
				respawn_point = n3
				return n3
	if respawn_point != null and is_instance_valid(respawn_point):
		return respawn_point
	return null


func _get_level_manager() -> Node:
	if get_tree() == null:
		return null
	var list = get_tree().get_nodes_in_group("LevelManager")
	if list != null and list.size() > 0:
		return list[0]
	return get_tree().root.find_child("LevelManager", true, false)


func activate_checkpoint(respawn_transform: Transform3D, respawn_speed: float, respawn_dir: Vector3) -> void:
	if not _network_is_local_authority():
		return
	if not checkpoint_enabled:
		return
	_checkpoint_active = true
	_checkpoint_transform = respawn_transform
	_checkpoint_respawn_speed = max(respawn_speed, 0.0)
	_checkpoint_respawn_dir = respawn_dir


func activate_checkpoint_from(source: Node, respawn_transform: Transform3D, respawn_speed: float, respawn_dir: Vector3) -> void:
	if not _network_is_local_authority():
		return
	if not checkpoint_enabled:
		return
	if source != null and is_instance_valid(source):
		var sid: int = int(source.get_instance_id())
		if sid != 0 and sid == _checkpoint_last_source_id:
			return
		_checkpoint_last_source_id = sid
	activate_checkpoint(respawn_transform, respawn_speed, respawn_dir)


func can_activate_checkpoint_source(source: Node) -> bool:
	if not checkpoint_enabled:
		return false
	if source == null or not is_instance_valid(source):
		return true
	var sid: int = int(source.get_instance_id())
	if sid != 0 and sid == _checkpoint_last_source_id:
		return false
	return true


func respawn_now() -> void:
	if not _network_is_local_authority():
		return
	if not _is_dead and race_in_countdown:
		return
	if race_active:
		_respawn_to_checkpoint()
		return
	_respawn()


func respawn_checkpoint_now() -> void:
	if not _network_is_local_authority():
		return
	if not _is_dead and race_in_countdown:
		return
	_respawn_to_checkpoint()


func clear_checkpoint_data() -> void:
	_checkpoint_active = false
	_checkpoint_transform = Transform3D.IDENTITY
	_checkpoint_respawn_speed = 0.0
	_checkpoint_respawn_dir = Vector3.ZERO
	_checkpoint_last_source_id = 0


func reset_race_debug_usage() -> void:
	race_debug_used = _debug_mode
	_race_debug_confirm_pending = false
	_race_debug_confirm_timer = 0.0
	_race_debug_confirmed = _debug_mode


func unstuck_now() -> void:
	_ui_input_blocked = false # Failsafe
	if not _network_is_local_authority():
		return
	if _ui_input_blocked:
		return
	_is_dead = false
	_perform_unstuck_nudge()
	stop_all_momentum_and_special_movement()
	if has_method("cancel_spline_spring"):
		call("cancel_spline_spring")
	if has_method("cancel_rail_grind"):
		call("cancel_rail_grind")
	if has_method("cancel_homing_attack"):
		call("cancel_homing_attack", false)
	_bounce_state = BounceState.NONE
	_jump_dash_recent_timer = 0.0
	_jump_dash_requested = false
	_jump_dashing = false
	_jump_dash_used_this_air = false
	_spindash_pending_release = false
	_spindash_pending_release_speed = 0.0
	_spindash_release_requested = false
	_spindash_release_with_jump = false
	_spindash_release_speed = 0.0
	_spindash_entry_speed = 0.0
	_spindash_turn_free_timer = 0.0
	_dash_speed_lock_timer = 0.0
	_dash_speed_lock_speed = 0.0
	_automation_active = false
	_automation_timer = 0.0
	_automation_lock_movement = false
	_automation_lock_actions = false
	_automation_lock_drift = false
	_automation_tangent_dir = Vector3.ZERO
	_automation_toward_dir = Vector3.ZERO
	_automation_toward_strength = 0.0
	_automation_max_turn_deg_per_sec = 0.0
	_automation_along_target_speed = 0.0
	_automation_along_accel = 0.0
	_automation_continuous_force = true
	_automation_align_rotation = true
	_automation_grounded_only = true
	_automation_force_surface_adhesion = false
	_automation_tangent_snap_strength = 0.0
	_automation_along_assist_enabled = true
	_automation_priority_current = -9999
	_automation_priority_frame = -1
	attached = false
	_prev_attached = false
	_move_input = Vector2.ZERO
	_move_direction = Vector3.ZERO
	_spring_movement_lock_timer = 0.0
	_spring_action_lock_timer = 0.0
	_spring_align_timer = 0.0
	_spring_detached = false
	_spring_lock_sideways = false
	_spring_sideways_gravity_scale = 0.0
	_spring_clear_move_on_ground = false
	_spring_clear_action_on_ground = false
	_apply_grounded_after_debug_exit()


func _get_unstuck_nudge_dir() -> Vector3:
	var x: float = Input.get_action_strength("move_right") - Input.get_action_strength("move_left")
	var z: float = Input.get_action_strength("move_forward") - Input.get_action_strength("move_back")
	var input: Vector2 = Vector2(x, z)
	if input.length() > 1.0:
		input = input.normalized()
	if input.length() < 0.001:
		return Vector3.ZERO

	var forward: Vector3 = _control_forward
	var right: Vector3 = _control_right
	var dir: Vector3 = forward * input.y + right * input.x
	if dir.length() < 0.001:
		return Vector3.ZERO
	return dir.normalized()


func _perform_unstuck_nudge() -> void:
	var nudge_dir: Vector3 = _get_unstuck_nudge_dir()
	if nudge_dir.length() < 0.001:
		nudge_dir = _control_forward
		if nudge_dir.length() < 0.001:
			nudge_dir = -global_transform.basis.z
	if nudge_dir.length() < 0.001:
		return

	var nudge_dist: float = max(unstuck_nudge_distance, 0.0)
	if nudge_dist < 0.001:
		return
	var nudge := nudge_dir.normalized() * nudge_dist

	var safe_nudge := Vector3.ZERO
	var step_count : float = clamp(unstuck_nudge_steps, 1, 8)
	var scale: float = 1.0
	for _i in range(step_count):
		var candidate := nudge * scale
		if candidate.length() < 0.001:
			break
		if not test_move(global_transform, candidate):
			safe_nudge = candidate
			break
		scale *= 0.5

	var prev_layer := collision_layer
	var prev_mask := collision_mask
	collision_layer = 0
	collision_mask = 0
	if safe_nudge.length() > 0.001:
		global_position += safe_nudge
	elif nudge.length() > 0.001:
		var fallback_scale: float = clamp(unstuck_force_nudge_scale, 0.0, 1.0)
		global_position += nudge * fallback_scale
	collision_layer = prev_layer
	collision_mask = prev_mask


	clear_max_speed_overrides()
func stop_all_momentum_and_special_movement() -> void:
	# Used by cutscenes (goal, race start, etc.) to ensure no leftover impulses/states.
	_stop_lightspeed_dash_if_active(false)
	velocity = Vector3.ZERO
	_reset_directional_influence_lock()
	_reset_stable_attach_normal()

	# Clear impulses / locks that can keep overriding velocity after teleport.
	_dash_speed_lock_timer = 0.0
	_ramp_hold_forward_timer = 0.0
	_ramp_hold_up_timer = 0.0
	_ramp_hold_forward_speed = 0.0
	_ramp_hold_up_speed = 0.0
	_ramp_hold_forward_dir = Vector3.ZERO
	_ramp_hold_up_dir = Vector3.ZERO

	# Cancel special movement states.
	if _homing_active or _homing_target != null:
		cancel_homing_attack(false)
	_reset_spindash_state()
	_spline_active = false
	_spline_path = null
	_spline_distance = 0.0
	_spline_speed = 0.0
	_spline_total_length = 0.0
	_rail_active = false
	_rail_crouching = false
	_rail_model_basis_valid = false

	_spring_align_timer = 0.0
	_spring_detached = false
	_spring_movement_lock_timer = 0.0
	_spring_action_lock_timer = 0.0

	# Reset basic airborne flags so grounded actions can resume once controls are unlocked.
	_is_jumping = false
	_jump_variable = false
	_jump_time = 0.0
	_jump_hang_allowed = false
	_just_jumped = false
	_is_falling = false
	_jumped_from_ground = false
	_falling_without_jump = false
	_homing_post_attack_timer = 0.0
	_enemy_bounce_cooldown_timer = 0.0
	_attack_sources = 0
	_jump_dash_requested = false
	_jump_dashing = false
	_jump_dash_used_this_air = false


func _notify_camera_teleport() -> void:
	if not _network_is_local_authority():
		return
	var rig = camera_rig
	if rig == null and camera != null:
		rig = camera.get_parent()
	if rig == null and get_tree() != null:
		var rigs = get_tree().get_nodes_in_group("CameraRig")
		if rigs != null and rigs.size() > 0:
			rig = rigs[0]
	if rig != null and rig.has_method("notify_teleport"):
		rig.call("notify_teleport")


func _update_drift_camera_rig(
	heading_dir: Vector3,
	active: bool,
	turn_speed_deg_per_sec: float,
	influence: float = 1.0
) -> void:
	if not _network_is_local_authority():
		return
	var rig = camera_rig
	if rig == null and camera != null:
		rig = camera.get_parent()
	if rig == null or not rig.has_method("set_drift_camera_state"):
		if get_tree() != null:
			var rigs = get_tree().get_nodes_in_group("CameraRig")
			if rigs != null and rigs.size() > 0:
				rig = rigs[0]
	if rig != null and rig.has_method("set_drift_camera_state"):
		rig.call("set_drift_camera_state", active, heading_dir, turn_speed_deg_per_sec, influence)


func _ensure_debug_input_actions() -> void:
	# Don't require manual project.godot edits; add defaults if missing.
	_add_input_action_key("debug_enter", Key.KEY_F1)
	_add_input_action_key("debug_fast", Key.KEY_SHIFT)
	_add_input_action_key("debug_slow", Key.KEY_CTRL)
	_add_input_action_key("debug_next_anim", Key.KEY_PAGEDOWN)
	_add_input_action_key("debug_prev_anim", Key.KEY_PAGEUP)
	_add_input_action_key("buddy_spawn", Key.KEY_F3)
	_add_input_action_key("respawn_checkpoint", Key.KEY_F2)
	_add_input_action_key("unstuck", Key.KEY_F4)
	_add_input_action_key("spawn_online_debug_puppet", Key.KEY_F6)


func _add_input_action_key(action_name: StringName, keycode_value: int) -> void:
	if InputMap.has_action(action_name):
		return
	InputMap.add_action(action_name)
	var ev: InputEventKey = InputEventKey.new()
	ev.keycode = keycode_value
	InputMap.action_add_event(action_name, ev)


func _toggle_online_debug_puppet() -> void:
	if _debug_online_puppet != null and is_instance_valid(_debug_online_puppet):
		_debug_online_puppet.queue_free()
		_debug_online_puppet = null
		return

	_spawn_online_debug_puppet()


func _spawn_online_debug_puppet() -> void:
	var packed: PackedScene = null
	var session = null
	if get_tree() != null and get_tree().current_scene != null:
		session = get_tree().current_scene.get_node_or_null("NetworkSession")
	if session != null and _object_has_property(session, "player_scene"):
		packed = session.get("player_scene")
	if packed == null and scene_file_path:
		var fallback: Resource = load(scene_file_path)
		if fallback is PackedScene:
			packed = fallback
	if packed == null:
		push_warning("SonicPlayer: no player scene available for debug puppet.")
		return

	var inst = packed.instantiate()
	if inst == null:
		return

	inst.name = "Player_DebugPuppet"
	if inst is Node3D:
		(inst as Node3D).global_transform = global_transform

	if inst.is_in_group("Player"):
		inst.remove_from_group("Player")
	if inst.is_in_group("player"):
		inst.remove_from_group("player")
	inst.add_to_group("RemotePlayer")

	if _object_has_property(inst, "camera"):
		inst.set("camera", null)
	if _object_has_property(inst, "camera_rig"):
		inst.set("camera_rig", null)
	if _object_has_property(inst, "hud"):
		inst.set("hud", null)
	if _object_has_property(inst, "lock_cursor_to_game"):
		inst.set("lock_cursor_to_game", false)
	if _object_has_property(inst, "network_replication_enabled"):
		inst.set("network_replication_enabled", true)
	if _object_has_property(inst, "collision_layer"):
		inst.set("collision_layer", 0)
	if _object_has_property(inst, "collision_mask"):
		inst.set("collision_mask", 0)

	inst.set_physics_process(false)
	inst.set_process(false)
	inst.set_process_unhandled_input(false)

	var parent_node: Node = get_parent()
	if parent_node == null and get_tree() != null:
		parent_node = get_tree().current_scene
	if parent_node == null:
		inst.queue_free()
		return

	parent_node.add_child(inst)

	_debug_online_puppet = inst


func _sync_online_debug_puppet(delta: float) -> void:
	if _debug_online_puppet == null or not is_instance_valid(_debug_online_puppet):
		return
	if not (_debug_online_puppet is Node):
		return
	if not _debug_online_puppet.has_method("apply_debug_puppet_state"):
		return

	var mb: Basis = Basis.IDENTITY
	if model_root != null:
		mb = model_root.global_transform.basis

	_debug_online_puppet.call(
		"apply_debug_puppet_state",
		global_transform,
		velocity,
		attached,
		state_flags,
		main_state,
		visual_up,
		mb,
		_move_direction,
		clamp(_barrier_blast_gauge, 0.0, 1.0)
	)
	if _debug_online_puppet.has_method("_network_puppet_tick"):
		_debug_online_puppet.call("_network_puppet_tick", delta)


func _debug_inputs_allowed() -> bool:
	# Block debug toggles while UI (chat/pause menus) should own inputs.
	if _ui_input_blocked:
		return false
	var vp = get_viewport()
	if vp == null:
		return true
	var focus = vp.gui_get_focus_owner()
	if focus == null:
		return true
	return not (focus is LineEdit or focus is TextEdit)


func _set_debug_mode(enabled: bool) -> void:
	if not debug_mode_enabled:
		return
	if _debug_mode == enabled:
		return

	if enabled and (race_in_countdown or race_active) and not race_finished:
		race_debug_used = true
		_invalidate_race_ghost_recording()
		_report_race_debug_used_to_network_session()

	_debug_mode = enabled

	if _debug_mode:
		# Save + disable collisions so we can freely fly around.
		_debug_saved_collision_layer = collision_layer
		_debug_saved_collision_mask = collision_mask
		collision_layer = 0
		collision_mask = 0

		# Disable AnimationTree so AnimationPlayer cycling is visible/authoritative.
		if anim_tree != null:
			_debug_saved_anim_tree_active = anim_tree.active
			anim_tree.active = false

		# Clear movement/ability state.
		velocity = Vector3.ZERO
		attached = false
		clear_max_speed_overrides()
		_move_input = Vector2.ZERO
		_move_direction = Vector3.ZERO
		_cancel_barrier_blast()
		rolling = false
		if has_method("cancel_homing_attack"):
			call("cancel_homing_attack", false)
		if has_method("cancel_spline_spring"):
			call("cancel_spline_spring")
		if has_method("cancel_rail_grind"):
			call("cancel_rail_grind")
		# Reset spring/action/movement locks and related automation state.
		_spring_movement_lock_timer = 0.0
		_spring_action_lock_timer = 0.0
		_spring_align_timer = 0.0
		_spring_detached = false
		_spring_lock_sideways = false
		_spring_sideways_gravity_scale = 0.0
		_spring_clear_move_on_ground = false
		_spring_clear_action_on_ground = false
		_dash_speed_lock_timer = 0.0
		_dash_speed_lock_speed = 0.0
		_automation_active = false
		_automation_timer = 0.0
		_automation_lock_movement = false
		_automation_lock_actions = false
		_automation_lock_drift = false
		_automation_tangent_dir = Vector3.ZERO
		_automation_toward_dir = Vector3.ZERO
		_automation_toward_strength = 0.0
		_automation_max_turn_deg_per_sec = 0.0
		_automation_along_target_speed = 0.0
		_automation_along_accel = 0.0
		_automation_continuous_force = true
		_automation_align_rotation = true
		_automation_grounded_only = true
		_automation_force_surface_adhesion = false
		_automation_tangent_snap_strength = 0.0
		_automation_priority_current = -9999
		_automation_priority_frame = -1

		_debug_refresh_animation_list()
	else:
		# Restore collisions and animation control.
		collision_layer = _debug_saved_collision_layer
		collision_mask = _debug_saved_collision_mask
		if anim_tree != null:
			anim_tree.active = _debug_saved_anim_tree_active
		_apply_grounded_after_debug_exit()


func _debug_refresh_animation_list() -> void:
	_debug_anim_player = _find_animation_player()
	_debug_anim_names = PackedStringArray()
	_debug_anim_index = 0
	if _debug_anim_player == null:
		return
	var list: PackedStringArray = _debug_anim_player.get_animation_list()
	_debug_anim_names = list


func _invalidate_race_ghost_recording() -> void:
	var tree: SceneTree = get_tree()
	if tree == null:
		return
	var race_starts = tree.get_nodes_in_group("RaceStart")
	for race_start in race_starts:
		if race_start != null and is_instance_valid(race_start) and race_start.has_method("invalidate_ghost_recording_for_player"):
			race_start.call("invalidate_ghost_recording_for_player", self)


func _report_race_debug_used_to_network_session() -> void:
	var tree: SceneTree = get_tree()
	if tree == null:
		return
	var sessions = tree.get_nodes_in_group("NetworkSession")
	for session in sessions:
		if session != null and is_instance_valid(session) and session.has_method("report_race_debug_used"):
			session.call("report_race_debug_used")
			return


func _debug_cycle_animation(step: int) -> void:
	if not _debug_mode:
		return
	if _debug_anim_player == null:
		_debug_refresh_animation_list()
	if _debug_anim_player == null or _debug_anim_names.is_empty():
		return
	var s: int = int(step)
	if s == 0:
		return
	_debug_anim_index = (_debug_anim_index + s) % _debug_anim_names.size()
	if _debug_anim_index < 0:
		_debug_anim_index += _debug_anim_names.size()
	var name: StringName = _debug_anim_names[_debug_anim_index]
	if _debug_anim_player.has_animation(name):
		_debug_anim_player.play(name)


func _find_animation_player() -> AnimationPlayer:
	if model_root != null:
		var n = model_root.find_child("AnimationPlayer", true, false)
		if n is AnimationPlayer:
			return n as AnimationPlayer
	var n2 = find_child("AnimationPlayer", true, false)
	return n2 as AnimationPlayer if n2 is AnimationPlayer else null


func _toggle_buddy() -> void:
	if not _network_is_local_authority():
		return
	if not buddy_enable:
		return
	if _buddy_instance != null and is_instance_valid(_buddy_instance):
		despawn_buddy()
		SettingsManager.set_buddy_active(false)
		SettingsManager.save_now()
		return
	spawn_selected_buddy()


func spawn_selected_buddy() -> bool:
	return set_buddy_character(SettingsManager.chosen_buddy_character_id)


func set_buddy_character(character_id: String) -> bool:
	if not _network_is_local_authority():
		return false
	if not buddy_enable:
		return false
	# Keep buddy local-only for now (avoids networking + authority issues).
	if multiplayer != null and multiplayer.has_multiplayer_peer():
		return false
	var normalized_id: String = character_id.strip_edges()
	if normalized_id == "":
		normalized_id = "sonic"
	var resolved_entry: Dictionary = CharacterCatalog.get_selected_or_default_entry(buddy_character_data_dir, normalized_id)
	if not resolved_entry.is_empty():
		var resolved_id: String = String(resolved_entry.get("id", "")).strip_edges()
		if resolved_id != "":
			normalized_id = resolved_id
	if _buddy_instance != null and is_instance_valid(_buddy_instance):
		var current_id: String = String(_buddy_instance.get_meta("buddy_character_id", ""))
		if current_id.nocasecmp_to(normalized_id) == 0:
			SettingsManager.set_chosen_buddy_character_id(normalized_id)
			SettingsManager.set_buddy_active(true)
			SettingsManager.save_now()
			return true
		despawn_buddy()

	var inst = _instantiate_buddy_character(normalized_id)
	if inst == null:
		return false

	SettingsManager.set_chosen_buddy_character_id(normalized_id)
	SettingsManager.set_buddy_active(true)
	SettingsManager.save_now()
	_spawn_buddy_instance(inst, normalized_id)
	return true


func despawn_buddy() -> void:
	if _buddy_instance == null or not is_instance_valid(_buddy_instance):
		_buddy_instance = null
		_clear_buddy_runtime_state()
		return
	# Defer to avoid "SceneTree is locked" in some input/physics contexts.
	_buddy_instance.call_deferred("queue_free")
	_buddy_instance = null
	_clear_buddy_runtime_state()


func _instantiate_buddy_character(character_id: String) -> Node:
	var entry: Dictionary = CharacterCatalog.get_selected_or_default_entry(buddy_character_data_dir, character_id)
	if not entry.is_empty():
		var scene_path: String = String(entry.get("scene", "")).strip_edges()
		if scene_path != "":
			var packed = load(scene_path)
			if packed is PackedScene:
				var character_inst = (packed as PackedScene).instantiate()
				if character_inst is Node:
					var buddy_script = load("res://LS5Framework/Scripts/AI/BuddySonicPlayer.gd")
					if buddy_script is Script:
						var character_node: Node = character_inst as Node
						var character_properties: Dictionary = _collect_scene_root_properties(character_node)
						character_node.set_script(buddy_script)
						_restore_scene_root_properties(character_node, character_properties)
						_copy_buddy_template_properties_to(character_node)
						return character_node
	if buddy_scene == null:
		return null
	var fallback_inst = buddy_scene.instantiate()
	return fallback_inst as Node if fallback_inst is Node else null


func _collect_scene_root_properties(source: Object) -> Dictionary:
	var values: Dictionary = {}
	if source == null:
		return values
	for property in source.get_property_list():
		var property_name: StringName = StringName(property.get("name", ""))
		if property_name == &"" or property_name == &"script":
			continue
		var usage: int = int(property.get("usage", 0))
		if (usage & PROPERTY_USAGE_STORAGE) == 0:
			continue
		if (usage & PROPERTY_USAGE_SCRIPT_VARIABLE) == 0:
			continue
		if _should_skip_ai_overlay_property(property_name):
			continue
		values[property_name] = source.get(property_name)
	return values


func _restore_scene_root_properties(target: Object, values: Dictionary) -> void:
	if target == null:
		return
	for key in values.keys():
		var property_name: StringName = StringName(key)
		if not _object_has_property(target, property_name):
			continue
		target.set(property_name, values[key])


func _should_skip_ai_overlay_property(property_name: StringName) -> bool:
	var property_text: String = String(property_name)
	if property_text.begins_with("buddy_"):
		return true
	if property_text.begins_with("follow_"):
		return true
	if property_text.begins_with("mimic_"):
		return true
	if property_text.begins_with("obstacle_"):
		return true
	if property_text.begins_with("spawn_sync_"):
		return true
	if property_text.begins_with("catchup_"):
		return true
	if property_text.begins_with("crowd_slow_"):
		return true
	if property_text.begins_with("rival_"):
		return true
	return false


func _copy_buddy_template_properties_to(target: Node) -> void:
	if target == null:
		return
	var template_scene: PackedScene = buddy_scene
	if template_scene == null:
		var loaded_template = load("res://LS5Framework/Scenes/Buddy/BuddySonicPlayer.tscn")
		if loaded_template is PackedScene:
			template_scene = loaded_template as PackedScene
	if template_scene == null:
		return
	var template_inst = template_scene.instantiate()
	if not (template_inst is Node):
		return
	var template_node: Node = template_inst as Node
	for property in template_node.get_property_list():
		var property_name: StringName = StringName(property.get("name", ""))
		if property_name == &"" or property_name == &"script":
			continue
		if not _should_copy_buddy_template_property(property_name):
			continue
		if not _object_has_property(target, property_name):
			continue
		target.set(property_name, template_node.get(property_name))
	template_node.queue_free()


func _should_copy_buddy_template_property(property_name: StringName) -> bool:
	var property_text: String = String(property_name)
	if property_text.begins_with("follow_"):
		return true
	if property_text.begins_with("buddy_"):
		return true
	if property_text.begins_with("mimic_"):
		return true
	if property_text.begins_with("obstacle_"):
		return true
	if property_text.begins_with("spawn_sync_"):
		return true
	if property_text.begins_with("catchup_"):
		return true
	if property_text.begins_with("crowd_slow_"):
		return true
	return false


func _spawn_buddy_instance(inst: Node, character_id: String) -> void:
	if inst == null:
		return
	_buddy_instance = inst
	inst.set_meta("buddy_character_id", character_id)
	inst.name = "Buddy_%s" % character_id
	inst.tree_exited.connect(Callable(self, "_on_buddy_tree_exited").bind(inst))

	# Spawn near the player in world space.
	var spawn_offset: Vector3 = buddy_spawn_offset
	var up: Vector3 = Vector3.UP
	if has_method("get_up_vector"):
		up = get_up_vector().normalized()
	if up.length() < 0.001:
		up = Vector3.UP
	# Interpret X/Z of offset relative to player model forward/right.
	var forward: Vector3 = _model_forward
	forward -= up * forward.dot(up)
	if forward.length() < 0.001:
		forward = -Vector3.FORWARD
	forward = forward.normalized()
	var right: Vector3 = forward.cross(up).normalized()

	var world_offset: Vector3 = right * spawn_offset.x + up * spawn_offset.y + forward * spawn_offset.z
	var spawn_pos: Vector3 = global_position + world_offset
	if inst is Node3D:
		(inst as Node3D).global_position = spawn_pos
	if inst.has_method("set_spawn_position_override"):
		inst.call("set_spawn_position_override", spawn_pos)

	# Assign follow target if supported.
	if inst.has_method("set"):
		if _object_has_property(inst, "follow_target"):
			inst.set("follow_target", self)
		elif _object_has_property(inst, "target"):
			inst.set("target", self)

		# Apply ranges/settings from the leader's exports for centralized tuning.
		if _object_has_property(inst, "mimic_leader_jump_range"):
			inst.set("mimic_leader_jump_range", buddy_mimic_jump_range)
		if _object_has_property(inst, "mimic_leader_roll_range"):
			inst.set("mimic_leader_roll_range", buddy_mimic_roll_range)
		if _object_has_property(inst, "obstacle_jump_leader_range"):
			inst.set("obstacle_jump_leader_range", buddy_obstacle_jump_range)
		if _object_has_property(inst, "buddy_teleport_distance"):
			inst.set("buddy_teleport_distance", buddy_spawn_teleport_distance)
		if _object_has_property(inst, "buddy_teleport_height"):
			inst.set("buddy_teleport_height", buddy_spawn_teleport_height)
		if _object_has_property(inst, "catchup_start_distance"):
			inst.set("catchup_start_distance", buddy_catchup_start_distance)
		if _object_has_property(inst, "catchup_full_distance"):
			inst.set("catchup_full_distance", buddy_catchup_full_distance)
		if _object_has_property(inst, "catchup_multiplier_max"):
			inst.set("catchup_multiplier_max", buddy_catchup_multiplier_max)
		if _object_has_property(inst, "catchup_exponent"):
			inst.set("catchup_exponent", buddy_catchup_exponent)
		if _object_has_property(inst, "crowd_slow_enabled"):
			inst.set("crowd_slow_enabled", buddy_crowd_slow_enabled)
		if _object_has_property(inst, "crowd_slow_start_distance"):
			inst.set("crowd_slow_start_distance", buddy_crowd_slow_start_distance)
		if _object_has_property(inst, "crowd_slow_full_distance"):
			inst.set("crowd_slow_full_distance", buddy_crowd_slow_full_distance)
		if _object_has_property(inst, "crowd_slow_multiplier_min"):
			inst.set("crowd_slow_multiplier_min", buddy_crowd_slow_multiplier_min)
		if _object_has_property(inst, "crowd_slow_leader_speed_threshold"):
			inst.set("crowd_slow_leader_speed_threshold", buddy_crowd_slow_leader_speed_threshold)
		if _object_has_property(inst, "spawn_sync_enabled"):
			inst.set("spawn_sync_enabled", buddy_spawn_sync_enabled)
		if _object_has_property(inst, "spawn_sync_copy_rotation"):
			inst.set("spawn_sync_copy_rotation", buddy_spawn_sync_copy_rotation)
		if _object_has_property(inst, "spawn_sync_copy_velocity"):
			inst.set("spawn_sync_copy_velocity", buddy_spawn_sync_copy_velocity)

	# Match the leader's facing direction + speed so the buddy can keep up immediately.
	if inst.has_method("match_leader_spawn_state"):
		inst.call("match_leader_spawn_state", self)

	# Sync initial leader roll state if supported.
	_notify_buddy_leader_roll_changed(rolling)

	# Add to the current scene so it persists like other world objects.
	if get_tree() != null and get_tree().current_scene != null:
		# Defer add to avoid tree modification issues during input callbacks.
		get_tree().current_scene.call_deferred("add_child", inst)
	else:
		call_deferred("add_child", inst)


func _debug_fly_tick(delta: float) -> void:
	# Free-fly movement in world-up space (no abilities/accel/turning logic).
	var up: Vector3 = Vector3.UP

	var cam_basis: Basis = global_transform.basis
	if camera != null:
		cam_basis = camera.global_transform.basis
	elif camera_rig is Node3D:
		cam_basis = (camera_rig as Node3D).global_transform.basis

	var forward: Vector3 = -cam_basis.z
	forward -= up * forward.dot(up)
	if forward.length() > 0.001:
		forward = forward.normalized()
	else:
		forward = -Vector3.FORWARD

	var right: Vector3 = cam_basis.x
	right -= up * right.dot(up)
	if right.length() > 0.001:
		right = right.normalized()
	else:
		right = Vector3.RIGHT

	var horiz: Vector3 = right * _move_input.x + forward * _move_input.y
	if horiz.length() > 1.0:
		horiz = horiz.normalized()

	var vert: float = 0.0
	if Input.is_action_pressed("action_0"):
		vert += 1.0
	if Input.is_action_pressed("action_1"):
		vert -= 1.0

	var speed_scale: float = 1.0
	if Input.is_action_pressed("debug_fast"):
		speed_scale *= max(debug_fast_multiplier, 0.0)
	if Input.is_action_pressed("debug_slow"):
		speed_scale *= max(debug_slow_multiplier, 0.0)
	if _walk_input_held:
		speed_scale *= 0.2

	var move: Vector3 = horiz * (debug_move_speed * speed_scale) + up * (vert * debug_vertical_speed * speed_scale)
	global_position += move * max(delta, 0.0)

	velocity = Vector3.ZERO
	attached = false


func set_display_name(value: String) -> void:
	_ensure_modules()
	if _ui_module != null:
		_ui_module.set_display_name(value)

func set_display_color(value: Color) -> void:
	_ensure_modules()
	if _ui_module != null:
		_ui_module.set_display_color(value)

func set_character_colors(primary_color: Color, secondary_color: Color, trail_color: Color = Color(0.2, 0.8, 1.0, 1.0)) -> void:
	_cache_default_character_effect_colors()
	_character_primary_color = primary_color
	_character_secondary_color = secondary_color
	character_tint_enabled = character_visual_profile.tint_enabled if character_visual_profile else true
	var boom_h: float = trail_color.h
	var boom_s: float = minf(trail_color.s, 0.8)
	var boom_v: float = 4.0
	sonic_boom_color = Color.from_hsv(boom_h, boom_s, boom_v, trail_color.a)
	if jump_dash_trail != null and jump_dash_trail.has_method("set_tint"):
		jump_dash_trail.call("set_tint", trail_color)
	_set_jump_ball_tint(trail_color)
	_apply_character_tint()


func clear_character_colors() -> void:
	_cache_default_character_effect_colors()
	character_tint_enabled = false
	_character_primary_color = Color(1, 1, 1, 1)
	_character_secondary_color = Color(1, 1, 1, 1)
	sonic_boom_color = _default_sonic_boom_color
	if jump_dash_trail != null and jump_dash_trail.has_method("set_tint"):
		jump_dash_trail.call("set_tint", _default_jump_dash_trail_tint)
	_set_jump_ball_tint(_default_jump_ball_tint)
	_apply_character_tint()


func _cache_default_character_effect_colors() -> void:
	if _has_default_character_effect_colors:
		return
	_default_sonic_boom_color = sonic_boom_color
	if jump_dash_trail != null:
		var trail_tint: Variant = jump_dash_trail.get("tint")
		if trail_tint is Color:
			_default_jump_dash_trail_tint = trail_tint
	_default_jump_ball_tint = jump_ball_default_color
	if jump_ball != null:
		var ball_tint: Variant = jump_ball.get("tint")
		if ball_tint is Color:
			_default_jump_ball_tint = ball_tint
	_has_default_character_effect_colors = true


func _set_jump_ball_tint(color: Color) -> void:
	var tint_color: Color = color
	tint_color.a = jump_ball_default_color.a
	if jump_ball != null and jump_ball.has_method("set_tint"):
		jump_ball.call("set_tint", tint_color)


func _apply_character_visual_profile() -> void:
	if not character_visual_profile:
		return
	character_tint_enabled = character_visual_profile.tint_enabled
	character_primary_mask = character_visual_profile.primary_mask
	character_secondary_mask = character_visual_profile.secondary_mask
	character_tint_allowed_materials = character_visual_profile.allowed_materials.duplicate()
	character_tint_allowed_material_path_substrings = character_visual_profile.allowed_material_path_substrings
	character_tint_blocked_material_path_substrings = character_visual_profile.blocked_material_path_substrings
	character_tint_allowed_textures = character_visual_profile.allowed_textures.duplicate()
	character_tint_allowed_texture_path_substrings = character_visual_profile.allowed_texture_path_substrings
	character_tint_blocked_texture_path_substrings = character_visual_profile.blocked_texture_path_substrings
	character_tint_primary_materials = character_visual_profile.primary_materials.duplicate()
	character_tint_secondary_materials = character_visual_profile.secondary_materials.duplicate()
	character_tint_primary_material_path_substrings = character_visual_profile.primary_material_path_substrings
	character_tint_secondary_material_path_substrings = character_visual_profile.secondary_material_path_substrings
	character_tint_primary_textures = character_visual_profile.primary_textures.duplicate()
	character_tint_secondary_textures = character_visual_profile.secondary_textures.duplicate()
	character_tint_primary_texture_path_substrings = character_visual_profile.primary_texture_path_substrings
	character_tint_secondary_texture_path_substrings = character_visual_profile.secondary_texture_path_substrings


func _get_character_hue_target() -> float:
	var target: Color = _character_primary_color
	if not (target is Color):
		target = character_hue_fallback_color
	var hue_color: Color = target
	if target.s < 0.01:
		hue_color = character_hue_fallback_color
	return fposmod(hue_color.h, 1.0)

func set_beacon_visible(value: bool) -> void:
	_ensure_modules()
	if _ui_module != null:
		_ui_module.set_beacon_visible(value)

func _update_score(amount: int) -> void:
	if amount <= 0:
		return
	score += amount
	var h = _get_hud_node()
	if h != null and h.has_method("set_score"):
		h.call("set_score", score)

func add_rings(amount: int) -> void:
	if not _network_is_local_authority():
		return
	var a = int(amount)
	if a <= 0:
		return
	rings += a
	_update_rings_hud()


func remove_rings(amount: int) -> int:
	if not _network_is_local_authority():
		return 0
	var a: int = int(amount)
	if a <= 0 or rings <= 0:
		return 0
	var removed: int = min(a, rings)
	rings -= removed
	_update_rings_hud()
	return removed


func reset_rings() -> void:
	if not _network_is_local_authority():
		return
	rings = 0
	_update_rings_hud()


func _update_rings_hud() -> void:
	var h = _get_hud_node()
	if h != null and h.has_method("set_rings"):
		h.call("set_rings", rings)


func set_local_pause_enabled(value: bool) -> void:
	_local_pause_enabled = value
	if value:
		_move_input = Vector2.ZERO
		_move_direction = Vector3.ZERO


func set_ui_input_blocked(value: bool) -> void:
	var was_blocked: bool = _ui_input_blocked
	_ui_input_blocked = value
	if value:
		_move_input = Vector2.ZERO
		_move_direction = Vector3.ZERO
		_clear_action_input_requests()
	elif was_blocked:
		_post_ui_unblock_action_suppress_timer = 0.08

func restore_input_after_pause() -> void:
	# Clear any residual UI-unblock suppression and ensure camera input unlocked after pause/resume.
	_post_ui_unblock_action_suppress_timer = 0.0
	_ui_input_blocked = false
	_set_manual_camera_lock(false)


func is_ui_input_blocked() -> bool:
	return _ui_input_blocked


func is_player_state_locked() -> bool:
	return _player_state_locked


func is_post_ui_action_suppressed() -> bool:
	return _post_ui_unblock_action_suppress_timer > 0.0


func _ensure_name_tag() -> void:
	_ensure_modules()
	if _ui_module != null:
		_ui_module._ensure_name_tag()


func show_chat_bubble(message: String) -> void:
	_ensure_modules()
	if _ui_module != null:
		_ui_module.show_chat_bubble(message)


func show_prompt(message: String, duration: float) -> void:
	_ensure_modules()
	if _ui_module != null:
		_ui_module.show_prompt(message, duration)


func clear_prompt() -> void:
	_ensure_modules()
	if _ui_module != null:
		_ui_module.clear_prompt()


func teleport_near_node(target: Node3D, offset: Vector3 = Vector3(0.0, 1.0, 0.0)) -> void:
	if not _network_is_local_authority():
		return
	if target == null or not is_instance_valid(target):
		return
	var t: Transform3D = global_transform
	t.origin = target.global_position + offset
	_apply_respawn_transform(t, false)
	stop_all_momentum_and_special_movement()


func leave_race(from_respawn: bool) -> void:
	# Leaving the race does not move the player (unless respawn_now does it after this).
	if not _network_is_local_authority():
		return

	_cancel_local_race_start_countdown()

	if not _network_is_active():
		race_session_joined = false
		race_active = false
		race_in_countdown = false
		_restore_autoplay_music()
		_cleanup_race_ui_local()
		_unlock_local_camera_constraints()
		return
	if not race_session_joined:
		return
	var session = null
	if get_tree() != null and get_tree().current_scene != null:
		session = get_tree().current_scene.get_node_or_null("NetworkSession")
	if session != null and session.has_method("leave_race"):
		session.call("leave_race", from_respawn)
	race_session_joined = false
	race_active = false
	race_in_countdown = false
	_cleanup_race_ui_local()
	_unlock_local_camera_constraints()


func force_leave_race_for_scene_change() -> void:
	# Clears any race/queue state before scene transitions.
	if not _network_is_local_authority():
		return
	if _network_is_active():
		var session = null
		if get_tree() != null and get_tree().current_scene != null:
			session = get_tree().current_scene.get_node_or_null("NetworkSession")
		if session != null and session.has_method("leave_race"):
			session.call("leave_race", false)
	race_session_joined = false
	race_active = false
	race_in_countdown = false
	race_finished = false
	_cancel_local_race_start_countdown()
	_cleanup_race_ui_local()
	_unlock_local_camera_constraints()


func _cleanup_race_ui_local() -> void:
	if get_tree() == null:
		return
	for n in get_tree().get_nodes_in_group("RaceUI"):
		if n != null and is_instance_valid(n):
			n.queue_free()
	for n in get_tree().get_nodes_in_group("RaceQueueBanner"):
		if n != null and is_instance_valid(n):
			n.queue_free()


func _restore_autoplay_music() -> void:
	if get_tree() == null:
		return
	var controllers := get_tree().get_nodes_in_group("MusicControllers")
	var autoplay_controller: MusicController = null
	var fallback: MusicController = null
	for node in controllers:
		if node is MusicController:
			var mc: MusicController = node
			if fallback == null:
				fallback = mc
			if mc.autoplay_stream != null and mc.autoplay:
				autoplay_controller = mc
				break
	if autoplay_controller == null:
		autoplay_controller = fallback
	var fade_out: float = 0.5
	if autoplay_controller != null and autoplay_controller.has_method("get"):
		var v = autoplay_controller.get("autoplay_fade_out")
		if v is float:
			fade_out = float(v)
	for node in controllers:
		if node is MusicController:
			(node as MusicController).stop_music(fade_out)
	if autoplay_controller == null:
		return
	if autoplay_controller.has_method("play_autoplay"):
		autoplay_controller.play_autoplay(true, -1.0, fade_out)
	elif autoplay_controller.autoplay_stream != null:
		autoplay_controller.play_music(autoplay_controller.autoplay_stream, autoplay_controller.autoplay_fade_in, fade_out, true)
	for n in get_tree().get_nodes_in_group("RaceFinishBanner"):
		if n != null and is_instance_valid(n):
			n.queue_free()
	for n in get_tree().get_nodes_in_group("RaceDNFBanner"):
		if n != null and is_instance_valid(n):
			n.queue_free()


func _resolve_camera_rig() -> Node:
	var rig: Node = null
	if camera_rig != null and is_instance_valid(camera_rig):
		rig = camera_rig
	elif camera != null and is_instance_valid(camera):
		rig = camera.get_parent()
	if (rig == null or not is_instance_valid(rig)) and get_tree() != null:
		var rigs = get_tree().get_nodes_in_group("CameraRig")
		if rigs != null and rigs.size() > 0:
			rig = rigs[0]
	return rig


func _set_manual_camera_lock(active: bool) -> void:
	if not _network_is_local_authority():
		return
	var rig = _resolve_camera_rig()
	if rig != null and "manual_input_locked" in rig:
		rig.manual_input_locked = active
	
func _unlock_local_camera_constraints() -> void:
	if not _network_is_local_authority():
		return
	var rig = _resolve_camera_rig()
	if rig != null:
		if rig.has_method("reset_camera_effects"):
			rig.call("reset_camera_effects", true)
		elif rig.has_method("clear_camera_constraints"):
			rig.call("clear_camera_constraints", null, true)


func _cancel_local_race_start_countdown() -> void:
	# If we're in a race start countdown (queue setup), cancel it locally so controls restore immediately.
	if get_tree() == null:
		return
	var starts = get_tree().get_nodes_in_group("RaceStart")
	for s in starts:
		if s != null and is_instance_valid(s) and s.has_method("cancel_for_player"):
			s.call("cancel_for_player", self)

