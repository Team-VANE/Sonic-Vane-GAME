	_drift_action.drift_reward_distance_current = _drift_reward_distance_current
	_drift_action.drift_reward_progress = _drift_reward_progress
	_drift_action.drift_speed_bonus_current = _drift_speed_bonus_current

func _sync_spring_state_from_action() -> void:
	if _spring_action == null:
		return
	_spring_movement_lock_timer = _spring_action.movement_lock_timer
	_spring_action_lock_timer = _spring_action.action_lock_timer
	_spring_align_timer = _spring_action.align_timer
	_spring_align_dir = _spring_action.align_dir
	_spring_lock_sideways = _spring_action.lock_sideways
	_spring_sideways_gravity_scale = _spring_action.sideways_gravity_scale
	_spring_cancel_on_ground = _spring_action.cancel_on_ground
	_spring_align_up = _spring_action.align_up
	_spring_align_forward = _spring_action.align_forward
	_spring_clear_move_on_ground = _spring_action.clear_move_on_ground
	_spring_clear_action_on_ground = _spring_action.clear_action_on_ground
	_spring_detached = _spring_action.detached
	_spring_align_model = _spring_action.align_model
	_spring_model_snap_timer = _spring_action.model_snap_timer

func _sync_spring_state_to_action() -> void:
	if _spring_action == null:
		return
	_spring_action.movement_lock_timer = _spring_movement_lock_timer
	_spring_action.action_lock_timer = _spring_action_lock_timer
	_spring_action.align_timer = _spring_align_timer
	_spring_action.align_dir = _spring_align_dir
	_spring_action.lock_sideways = _spring_lock_sideways
	_spring_action.sideways_gravity_scale = _spring_sideways_gravity_scale
	_spring_action.cancel_on_ground = _spring_cancel_on_ground
	_spring_action.align_up = _spring_align_up
	_spring_action.align_forward = _spring_align_forward
	_spring_action.clear_move_on_ground = _spring_clear_move_on_ground
	_spring_action.clear_action_on_ground = _spring_clear_action_on_ground
	_spring_action.detached = _spring_detached
	_spring_action.align_model = _spring_align_model
	_spring_action.model_snap_timer = _spring_model_snap_timer

func _sync_hurt_state_from_action() -> void:
	if _hurt_action == null:
		return
	_hurt_active = _hurt_action.is_active
	_hurt_state_timer = _hurt_action.state_timer
	_hurt_flash_accum = _hurt_action.flash_accum
	_hurt_flash_visible = _hurt_action.flash_visible
	_damage_hit_invuln_timer = _hurt_action.invuln_timer

func _sync_hurt_state_to_action() -> void:
	if _hurt_action == null:
		return
	_hurt_action.is_active = _hurt_active
	_hurt_action.state_timer = _hurt_state_timer
	_hurt_action.flash_accum = _hurt_flash_accum
	_hurt_action.flash_visible = _hurt_flash_visible
	_hurt_action.invuln_timer = _damage_hit_invuln_timer

func _process_action_inputs() -> void:
	if not _network_is_local_authority():
		return
	if _local_pause_enabled:
		return
	if get_tree() != null and get_tree().paused:
		return
	if _ui_input_blocked:
		return
	if _post_ui_unblock_action_suppress_timer > 0.0:
		return
	if _hurt_active:
		if Input.is_action_just_pressed("action_0") and not race_in_countdown:
			queue_jump()
		return
	if _process_carry_action_inputs():
		return
	if _homing_active and Input.is_action_just_pressed("action_1"):
		cancel_homing_attack(false)
		return

	if _rail_active:
		return
	if _automation_lock_actions and _automation_locks_active():
		return

	if _spring_action_lock_timer > 0.0:
		return
	if _spring_movement_lock_timer > 0.0:
		_spring_movement_lock_timer = 0.0
		return

	if Input.is_action_just_pressed("action_1") and _switch_drift_direction_from_action1():
		return

	if Input.is_action_just_pressed("action_0") and _can_consume_coyote_jump():
		if coyote_jump_homing_priority and _can_scan_homing_targets() and has_homing_target_in_range():
			_jump_dash_requested = true
			return
		queue_coyote_jump()
		return

	for action in _actions:
		if action == null:
			continue
		if not (action is CharacterActionType):
			continue
		var a = action
		if not a.enabled:
			continue
		if not _can_execute_action_while_carrying(a):
			continue
		if _active_action != null and a != _active_action and not a.allow_when_inactive:
			continue
		if a.input_action == &"":
			continue
		var consumed: bool = false
		if Input.is_action_just_pressed(String(a.input_action)):
			consumed = a.process_input_event(a.input_action, CharacterActionType.ActionTrigger.JUST_PRESSED)
		elif Input.is_action_pressed(String(a.input_action)):
			consumed = a.process_input_event(a.input_action, CharacterActionType.ActionTrigger.PRESSED)
		elif Input.is_action_just_released(String(a.input_action)):
			consumed = a.process_input_event(a.input_action, CharacterActionType.ActionTrigger.JUST_RELEASED)
		if consumed:
			break

func _update_action_runtime(delta: float) -> void:
	for action in _actions:
		if action != null and is_instance_valid(action) and action.continuous_update and _can_execute_action_while_carrying(action):
			action.continuous_physics_update(delta)
	_update_flight_gauge_ui()
	if _ui_input_blocked:
		_clear_action_input_requests()
		return
	if _active_action == null and not attached and not _lightspeed_dash_active:
		activate_neutral_air_action({"reason": &"airborne_neutral"})
	if _active_action == null:
		return
	if not is_instance_valid(_active_action):
		clear_active_action()
		return
	if not _can_execute_action_while_carrying(_active_action):
		clear_active_action()
		return
	_active_action.physics_update_action(delta)
	if attached and _active_action != null and _active_action == _fall_action:
		clear_active_action()


func activate_action(action, context: Dictionary = {}) -> bool:
	if action == null or not is_instance_valid(action):
		return false
	if action.owner_player != self:
		return false
	if not _can_execute_action_while_carrying(action):
		return false
	if not action.can_execute(context):
		return false
	if _active_action != null and is_instance_valid(_active_action) and _active_action != action:
		_active_action.on_action_exit(action)
	_active_action = action
	_current_action_id = action.action_id
	action.on_action_enter(context)
	if action.has_method("play_activation_voice"):
		action.call("play_activation_voice")
	return true


func clear_active_action() -> void:
	if _active_action != null and is_instance_valid(_active_action):
		_active_action.on_action_exit(null)
	_active_action = null
	_current_action_id = &""


func activate_neutral_air_action(context: Dictionary = {}) -> bool:
	if attached:
		return false
	if _fall_action == null or not is_instance_valid(_fall_action):
		return false
	if _active_action == _fall_action:
		return true
	return activate_action(_fall_action, context)


func force_neutral_action(context: Dictionary = {}) -> bool:
	cancel_homing_attack(false)
	_jump_dash_recent_timer = 0.0
	_homing_post_attack_timer = 0.0
	if attached:
		clear_active_action()
		return true
	return activate_neutral_air_action(context)


func reset_flight_eligibility() -> void:
	for action in _actions:
		if action != null and is_instance_valid(action) and action.has_method("reset_flight_eligibility"):
			action.call("reset_flight_eligibility")


func reset_flight_timer_to_max() -> void:
	for action in _actions:
		if action != null and is_instance_valid(action) and action.has_method("reset_flight_timer_to_max"):
			action.call("reset_flight_timer_to_max")


func add_flight_time(amount: float) -> void:
	for action in _actions:
		if action != null and is_instance_valid(action) and action.has_method("add_flight_time"):
			action.call("add_flight_time", amount)


func _update_flight_gauge_ui() -> void:
	for action in _actions:
		if action == null or not is_instance_valid(action):
			continue
		if not action.has_method("has_flight_gauge"):
			continue
		if not bool(action.call("has_flight_gauge")):
			continue
		var current: float = 0.0
		var max_value: float = 0.0
		if action.has_method("get_flight_gauge_current"):
			current = float(action.call("get_flight_gauge_current"))
		if action.has_method("get_flight_gauge_max"):
			max_value = float(action.call("get_flight_gauge_max"))
		_set_flight_gauge_ui(current, max_value, true)
		return
	_set_flight_gauge_ui(0.0, 1.0, false)


func is_current_action_flight() -> bool:
	if _active_action == null or not is_instance_valid(_active_action):
		return false
	if not _active_action.has_method("is_flight_action"):
		return false
	return bool(_active_action.call("is_flight_action"))


func is_air_acceleration_overridden() -> bool:
	if _active_action == null or not is_instance_valid(_active_action):
		return false
	if not _active_action.has_method("overrides_air_acceleration"):
		return false
	return bool(_active_action.call("overrides_air_acceleration"))


func get_air_acceleration_override(lateral_speed: float, fallback_value: float) -> float:
	if _active_action == null or not is_instance_valid(_active_action):
		return fallback_value
	if not _active_action.has_method("get_air_acceleration_override"):
		return fallback_value
	return float(_active_action.call("get_air_acceleration_override", lateral_speed))


func end_active_flight_for_external_impulse(context: Dictionary = {}) -> bool:
	if not is_current_action_flight():
		return false
	if attached:
		clear_active_action()
		return true
	return _force_neutral_air_action(context)


func _force_neutral_air_action(context: Dictionary = {}) -> bool:
	if attached:
		clear_active_action()
		return true
	if _fall_action == null or not is_instance_valid(_fall_action):
		clear_active_action()
		return false
	if _active_action == _fall_action:
		return true
	if _active_action != null and is_instance_valid(_active_action):
		_active_action.on_action_exit(_fall_action)
	_active_action = _fall_action
	_current_action_id = _fall_action.action_id
	_fall_action.on_action_enter(context)
	if _fall_action.has_method("play_activation_voice"):
		_fall_action.call("play_activation_voice")
	return true


func execute_action_from_path(requester, route_path: NodePath, context: Dictionary = {}) -> bool:
	if requester == null or requester.owner_player != self:
		return false
	if route_path == NodePath():
		return false
	if not requester.has_node(route_path):
		return false
	var target_node: Node = requester.get_node(route_path)
	if not (target_node is CharacterActionType):
		return false
	var target_action = target_node
	if not _can_execute_action_while_carrying(target_action):
		return false
	if not target_action.execute(context):
		return false
	return true


func get_current_action_id() -> StringName:
	return _current_action_id


func is_action_id_active(action_id: StringName) -> bool:
	return _current_action_id == action_id


func is_action_exhausted(action_id: StringName) -> bool:
	if not is_action_id_active(action_id):
		return false
	if _active_action == null or not is_instance_valid(_active_action):
		return false
	if not _active_action.has_method("is_exhausted"):
		return false
	return bool(_active_action.call("is_exhausted"))


func is_propeller_flight_active() -> bool:
	return is_action_id_active(&"propeller_flight")


func is_propeller_flight_exhausted() -> bool:
	return is_action_exhausted(&"propeller_flight")


func has_homing_target_in_range() -> bool:
	if not _can_scan_homing_targets():
		return false
	if attached:
		return false
	var speed_now: float = velocity.length()
	var max_range: float = homing_min_range + speed_now * homing_range_per_speed
	max_range = clamp(max_range, homing_min_range, homing_max_range)
	var t: Node3D = null
	var now_ms: int = Time.get_ticks_msec()
	if _homing_reticle_cached_target != null and is_instance_valid(_homing_reticle_cached_target) and now_ms - _homing_reticle_cached_time_ms < HOMING_RETICLE_CACHE_MS:
		var cached_position: Vector3 = _refresh_homing_candidate_position(_homing_reticle_cached_target, global_position)
		var to_cached: Vector3 = cached_position - global_position
		if to_cached.length_squared() <= max_range * max_range:
			t = _homing_reticle_cached_target
	if t == null:
		t = _select_homing_target(global_position, max_range)
	return t != null


func _get_homing_target_position(target: Node3D, origin: Vector3) -> Vector3:
	if target != null and is_instance_valid(target) and target.has_method("get_homing_target_position"):
		var position: Variant = target.call("get_homing_target_position", origin)
		if position is Vector3:
			return position
	if target != null and is_instance_valid(target):
		return target.global_position
	return origin


func _get_homing_target_position_for_aim(target: Node3D, origin: Vector3, aim_origin: Vector3, aim_dir: Vector3) -> Vector3:
	if target != null and is_instance_valid(target) and target.has_method("get_homing_target_position_for_aim"):
		var position: Variant = target.call("get_homing_target_position_for_aim", aim_origin, aim_dir)
		if position is Vector3:
			return position
	return _get_homing_target_position(target, origin)


func _is_rail_like_homing_target(target: Node) -> bool:
	return target != null and (
		target.has_method("try_start_with_body_proximity")
		or target.has_method("get_closest_point_on_path")
	)


func _set_homing_candidate_position(target: Node3D, position: Vector3) -> void:
	if target == null or not is_instance_valid(target):
		return
	_homing_target_candidate_positions[target.get_instance_id()] = position


func _get_homing_candidate_position(target: Node3D, origin: Vector3) -> Vector3:
	if target != null and is_instance_valid(target):
		var id: int = target.get_instance_id()
		if _homing_target_candidate_positions.has(id):
			var position: Variant = _homing_target_candidate_positions[id]
			if position is Vector3:
				return position
	return _get_homing_target_position(target, origin)


func _refresh_homing_candidate_position(target: Node3D, origin: Vector3) -> Vector3:
	if target == null or not is_instance_valid(target):
		return origin

	var mode: int = SettingsManager.homing_targeting_mode
	var position: Vector3 = target.global_position
	if mode == SettingsManager.HOMING_TARGETING_CAMERA:
		var cam: Camera3D = camera
		if cam == null:
			var vp: Viewport = get_viewport()
			if vp != null:
				cam = vp.get_camera_3d()
		if cam != null:
			var vp_size: Vector2 = cam.get_viewport().get_visible_rect().size
			if vp_size.x > 0.0 and vp_size.y > 0.0:
				var center: Vector2 = vp_size * 0.5
				var offset_t: float = clamp(SettingsManager.reticle_vertical_offset, 0.0, 100.0) / 100.0
				center.y += -0.5 * vp_size.y * offset_t
				var aim_origin: Vector3 = cam.project_ray_origin(center)
				var aim_dir: Vector3 = cam.project_ray_normal(center)
				if aim_dir.length() < 0.001:
					aim_dir = -cam.global_transform.basis.z
				position = _get_homing_target_position_for_aim(target, origin, aim_origin, aim_dir)
			else:
				position = _get_homing_target_position(target, origin)
		else:
			position = _get_homing_target_position(target, origin)
	else:
		var dash_dir: Vector3 = _get_homing_target_direction()
		if dash_dir.length() < 0.001:
			dash_dir = -Vector3.FORWARD
		position = _get_homing_target_position_for_aim(target, origin, origin, dash_dir)

	_set_homing_candidate_position(target, position)
	return position


func get_homing_attack_target_position() -> Vector3:
	if _homing_target_position_valid:
		return _homing_target_position
	if _homing_target != null and is_instance_valid(_homing_target) and _homing_target is Node3D:
		return _get_homing_target_position(_homing_target as Node3D, global_position)
	return global_position


func get_homing_reticle_target_position(target: Node3D) -> Vector3:
	return _get_homing_candidate_position(target, global_position)


func _apply_attack_magnetism(delta: float, physics_up: Vector3, current_velocity: Vector3) -> Vector3:
	_attack_magnetism_target = null
	_attack_magnetism_target_position = Vector3.ZERO
	_attack_magnetism_strength_current = 0.0
	if delta > 0.0:
		_tick_attack_magnetism_bounce_compensation(delta)
	if not _can_apply_attack_magnetism():
		_attack_magnetism_scan_result.clear()
		_attack_magnetism_scan_timer = 0.0
		return current_velocity
	if delta <= 0.0:
		return current_velocity

	var up: Vector3 = physics_up.normalized()
	if up.length() < 0.001:
		up = gravity_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	var heading: Vector3 = _get_attack_magnetism_heading(current_velocity)
	if heading.length() < 0.001:
		return current_velocity

	var result: Dictionary = _get_attack_magnetism_scan_result(delta, heading.normalized(), up, current_velocity)
	if result.is_empty():
		return current_velocity

	var target: Node3D = result.get("target", null) as Node3D
	if target == null:
		return current_velocity

	var target_position: Vector3 = result.get("position", target.global_position)
	var to_target: Vector3 = target_position - global_position
	var dist: float = to_target.length()
	if dist <= 0.001:
		return current_velocity

	var target_dir: Vector3 = to_target / dist
	var min_speed: float = _get_attack_magnetism_setting(target, "attack_magnetism_min_speed", attack_magnetism_min_speed)
	var target_speed: float = max(current_velocity.length(), max(min_speed, 0.0))
	if target_speed <= 0.001:
		return current_velocity

	var strength: float = float(result.get("strength", 0.0))
	if strength <= 0.0:
		return current_velocity

	_attack_magnetism_target = target
	_attack_magnetism_target_position = target_position
	_attack_magnetism_strength_current = strength

	var desired_velocity: Vector3 = target_dir * target_speed
	var adjusted_velocity: Vector3 = current_velocity.move_toward(desired_velocity, strength * delta)
	var previous_descent: float = max(-current_velocity.dot(up), 0.0)
	var adjusted_descent: float = max(-adjusted_velocity.dot(up), 0.0)
	var lost_descent: float = max(previous_descent - adjusted_descent, 0.0)
	if lost_descent > 0.0:
		_store_attack_magnetism_bounce_compensation(lost_descent)
	return adjusted_velocity


func _tick_attack_magnetism_bounce_compensation(delta: float) -> void:
	if _attack_magnetism_bounce_compensation_timer <= 0.0:
		_attack_magnetism_bounce_descent_compensation = 0.0
		return
	_attack_magnetism_bounce_compensation_timer = max(_attack_magnetism_bounce_compensation_timer - delta, 0.0)
	if _attack_magnetism_bounce_compensation_timer <= 0.0:
		_attack_magnetism_bounce_descent_compensation = 0.0


func _store_attack_magnetism_bounce_compensation(lost_descent: float) -> void:
	var gain: float = max(attack_magnetism_bounce_lost_descent_gain, 0.0)
	if gain <= 0.0:
		return
	_attack_magnetism_bounce_descent_compensation += max(lost_descent, 0.0) * gain
	_attack_magnetism_bounce_compensation_timer = max(attack_magnetism_bounce_compensation_time, 0.0)


func _consume_attack_magnetism_bounce_compensation() -> float:
	var compensation: float = _attack_magnetism_bounce_descent_compensation
	_attack_magnetism_bounce_descent_compensation = 0.0
	_attack_magnetism_bounce_compensation_timer = 0.0
	return max(compensation, 0.0)


func _get_attack_magnetism_scan_result(delta: float, heading: Vector3, up: Vector3, current_velocity: Vector3) -> Dictionary:
	var interval: float = 0.0
	if attack_magnetism_target_update_rate_hz > 0.0:
		interval = 1.0 / attack_magnetism_target_update_rate_hz
	_attack_magnetism_scan_timer -= delta

	if _attack_magnetism_scan_timer > 0.0 and _is_attack_magnetism_scan_result_valid():
		return _attack_magnetism_scan_result

	_attack_magnetism_scan_timer = interval
	_attack_magnetism_scan_result = _select_attack_magnetism_target(global_position, heading, up, current_velocity)
	return _attack_magnetism_scan_result


func _is_attack_magnetism_scan_result_valid() -> bool:
	if _attack_magnetism_scan_result.is_empty():
		return false
	var target: Node3D = _attack_magnetism_scan_result.get("target", null) as Node3D
	if target == null or not is_instance_valid(target):
		return false
	return _is_attack_magnetism_target_available(target)


func _can_apply_attack_magnetism() -> bool:
	if not attack_magnetism_enabled:
		return false
	if attack_magnetism_player_controlled_only and not _is_player_controlled_targeting_owner():
		return false
	if attached:
		return false
	if _is_dead or _hurt_active:
		return false
	if _homing_active or _lightspeed_dash_active:
		return false
	if _rail_active or _rail_switch_active or _spline_active:
		return false
	if _spring_align_timer > 0.0 or _spring_movement_lock_timer > 0.0 or _spring_action_lock_timer > 0.0:
		return false
	if _ramp_hold_forward_timer > 0.0 or _ramp_hold_up_timer > 0.0:
		return false
	if _automation_lock_movement and _automation_locks_active():
		return false
	if not _current_action_permits_attack_magnetism():
		return false
	return _is_attack_magnetism_attack_state_active()


func _is_player_controlled_targeting_owner() -> bool:
	if has_meta("is_buddy") and bool(get_meta("is_buddy")):
		return false
	if has_meta("is_rival_actor") and bool(get_meta("is_rival_actor")):
		return false
	return _network_is_local_authority()


func _current_action_permits_attack_magnetism() -> bool:
	if _active_action == null or not is_instance_valid(_active_action):
		return false
	if not (_active_action is CharacterActionType):
		return false
	var permits: Variant = _active_action.get("permits_attack_magnetism")
	return permits is bool and bool(permits)


func _is_attack_magnetism_attack_state_active() -> bool:
	if is_attack_active():
		return true
	if _jumped_from_ground:
		return true
	if rolling:
		return true
	if _jump_dash_recent_timer > 0.0:
		return true
	if _bounce_state != BounceState.NONE:
		return true
	if _enemy_attack_chain_active and not attached:
		return true
	if _active_action != null and is_instance_valid(_active_action):
		if _active_action.has_method("get") and "combat_class" in _active_action:
			return int(_active_action.get("combat_class")) != CombatClass.NEUTRAL
	return false


func _get_attack_magnetism_heading(current_velocity: Vector3) -> Vector3:
	if current_velocity.length() > 0.001:
		return current_velocity.normalized()
	if _move_direction.length() > 0.001:
		return _move_direction.normalized()
	if _model_forward.length() > 0.001:
		return _model_forward.normalized()
	return -global_transform.basis.z


func _select_attack_magnetism_target(origin: Vector3, heading: Vector3, up: Vector3, current_velocity: Vector3) -> Dictionary:
	var player_range: float = _get_attack_magnetism_player_range(current_velocity)
	var query_range: float = max(player_range, attack_magnetism_max_range)
	var candidates: Array = _get_attack_magnetism_candidates(origin, query_range)
	if candidates.is_empty():
		return {}

	var best: Node3D = null
	var best_position: Vector3 = Vector3.ZERO
	var best_score: float = -999999.0
	var best_strength: float = 0.0

	for candidate in candidates:
		if candidate == null or not is_instance_valid(candidate):
			continue
		if not (candidate is Node3D):
			continue
		var target: Node3D = candidate as Node3D
		if not _is_attack_magnetism_target_available(target):
			continue

		var target_range: float = _get_attack_magnetism_setting(target, "attack_magnetism_range", player_range)
		target_range = max(target_range, 0.0)
		if target_range <= 0.0:
			continue
		var target_position: Vector3 = _get_attack_magnetism_target_position(target)
		var to_target: Vector3 = target_position - origin
		var dist: float = to_target.length()
		if dist <= 0.001 or dist > target_range:
			continue

		var target_dir: Vector3 = to_target / dist
		var angle_deg: float = _get_attack_magnetism_setting(target, "attack_magnetism_detection_angle_deg", attack_magnetism_detection_angle_deg)
		angle_deg = clamp(angle_deg, 0.0, 180.0)
		var min_dot: float = cos(deg_to_rad(angle_deg))
		var heading_dot: float = clamp(target_dir.dot(heading), -1.0, 1.0)
		if heading_dot < min_dot:
			continue

		var input_factor: float = _get_attack_magnetism_input_factor(target_dir, up)
		if input_factor <= 0.0:
			continue

		var heading_factor: float = 1.0
		if min_dot < 0.999:
			heading_factor = clamp((heading_dot - min_dot) / (1.0 - min_dot), 0.0, 1.0)
		var descent_factor: float = _get_attack_magnetism_descent_factor(current_velocity, up)
		var distance_factor: float = lerp(1.0, 0.65, clamp(dist / target_range, 0.0, 1.0))
		var base_strength: float = _get_attack_magnetism_setting(target, "attack_magnetism_strength", attack_magnetism_strength)
		var strength_multiplier: float = 1.0
		if _object_has_property(target, "attack_magnetism_strength_multiplier"):
			strength_multiplier = max(float(target.get("attack_magnetism_strength_multiplier")), 0.0)
		var strength: float = max(base_strength, 0.0) * strength_multiplier * heading_factor * input_factor * descent_factor * distance_factor
		if strength <= 0.0:
			continue

		var input_score: float = min(input_factor, 2.0)
		var score: float = heading_factor * 10000.0 + input_score * 100.0 - (dist / target_range) * 10.0
		if score > best_score:
			best_score = score
			best = target
			best_position = target_position
			best_strength = strength

	if best == null:
		return {}
	return {
		"target": best,
		"position": best_position,
		"strength": best_strength,
	}


func _get_attack_magnetism_player_range(current_velocity: Vector3) -> float:
	var min_range: float = max(attack_magnetism_range, 0.0)
	var max_range: float = max(attack_magnetism_max_range, min_range)
	var speed_range: float = min_range + current_velocity.length() * max(attack_magnetism_range_per_speed, 0.0)
	return clamp(speed_range, min_range, max_range)


func _get_attack_magnetism_candidates(origin: Vector3, max_range: float) -> Array:
	var candidates: Array = []
	var seen: Dictionary = {}
	var mgr = get_node_or_null("/root/HomingTargetManager")
	if mgr and mgr.has_method("get_attack_magnetism_targets_in_range"):
		for target in mgr.get_attack_magnetism_targets_in_range(origin, max_range):
			_add_attack_magnetism_candidate(candidates, seen, target)
		return candidates
	var tree: SceneTree = get_tree()
	if tree == null:
		return candidates
	for target in tree.get_nodes_in_group("AttackMagnetismTarget"):
		_add_attack_magnetism_candidate(candidates, seen, target)
	return candidates


func _add_attack_magnetism_candidate(candidates: Array, seen: Dictionary, target: Node) -> void:
	if target == null or not is_instance_valid(target):
		return
	if not (target is Node3D):
		return
	var id: int = target.get_instance_id()
	if seen.has(id):
		return
	seen[id] = true
	candidates.append(target)


func _is_attack_magnetism_target_available(target: Node3D) -> bool:
	if target == null or not is_instance_valid(target):
		return false
	if not target.is_in_group("AttackMagnetismTarget"):
		return false
	if _object_has_property(target, "enabled") and not bool(target.get("enabled")):
		return false
	if _object_has_property(target, "active") and not bool(target.get("active")):
		return false
	if _object_has_property(target, "attack_magnetism_enabled"):
		return bool(target.get("attack_magnetism_enabled"))
	return true


func _get_attack_magnetism_target_position(target: Node3D) -> Vector3:
	if target != null and is_instance_valid(target) and target.has_method("get_attack_magnetism_position"):
		var position: Variant = target.call("get_attack_magnetism_position", self)
		if position is Vector3:
			return position
	return _get_homing_target_position(target, global_position)


func _get_attack_magnetism_setting(target: Node3D, property_name: String, fallback_value: float) -> float:
	if target != null and is_instance_valid(target):
		var override_settings: bool = false
		if _object_has_property(target, "attack_magnetism_override_player_settings"):
			override_settings = bool(target.get("attack_magnetism_override_player_settings"))
		if override_settings and _object_has_property(target, property_name):
			return float(target.get(property_name))
	return fallback_value


func _get_attack_magnetism_input_factor(target_dir: Vector3, up: Vector3) -> float:
	if _move_direction.length() < 0.001:
		return 1.0
	var input_dir: Vector3 = _move_direction - up * _move_direction.dot(up)
	if input_dir.length() < 0.001:
		return 1.0
	input_dir = input_dir.normalized()

	var target_flat: Vector3 = target_dir - up * target_dir.dot(up)
	if target_flat.length() < 0.001:
		return 1.0
	target_flat = target_flat.normalized()

	var input_dot: float = clamp(input_dir.dot(target_flat), -1.0, 1.0)
	if input_dot <= attack_magnetism_input_away_dot:
		return 0.0
	if input_dot >= 0.0:
		return 1.0 + input_dot * max(attack_magnetism_input_toward_bonus, 0.0)
	var input_range: float = max(0.0 - attack_magnetism_input_away_dot, 0.001)
	return lerp(0.25, 1.0, clamp((input_dot - attack_magnetism_input_away_dot) / input_range, 0.0, 1.0))


func _get_attack_magnetism_descent_factor(current_velocity: Vector3, up: Vector3) -> float:
	var descent_speed: float = max(-current_velocity.dot(up), 0.0)
	var no_descent_strength: float = clamp(attack_magnetism_no_descent_strength, 0.0, 1.0)
	var fast_descent_strength: float = clamp(attack_magnetism_fast_descent_strength, 0.0, 1.0)
	var peak_speed: float = max(attack_magnetism_peak_descent_speed, 0.001)
	if descent_speed <= peak_speed:
		return lerp(no_descent_strength, 1.0, clamp(descent_speed / peak_speed, 0.0, 1.0))
	var max_descent_speed: float = max(attack_magnetism_max_descent_speed, peak_speed + 0.001)
	var fast_t: float = clamp((descent_speed - peak_speed) / (max_descent_speed - peak_speed), 0.0, 1.0)
	return lerp(1.0, fast_descent_strength, fast_t)


func _perform_jump_dash(physics_up: Vector3, is_attached: bool, lateral: Vector3) -> Vector3:
	# Respect "air only" flag
	if jump_dash_air_only and is_attached:
		return lateral

	# One dash per airtime, if enabled
	if jump_dash_once_per_air and _jump_dash_used_this_air:
		return lateral

	var up: Vector3 = physics_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	# Base facing direction: model forward
	var forward: Vector3 = _model_forward
	if forward.length() < 0.001:
		# Fallback to lateral movement direction, then a sane default
		if lateral.length() > 0.001:
			forward = lateral.normalized()
		else:
			forward = -Vector3.FORWARD

	# Project forward onto plane perpendicular to up (purely horizontal/along surface)
	var dash_dir: Vector3 = forward - up * forward.dot(up)
	if dash_dir.length() < 0.001:
		dash_dir = forward
	dash_dir = dash_dir.normalized()

	# --- Jump dash impulse scales down as lateral speed approaches the cutoff. ---
	var impulse_stop_speed: float = max(jump_dash_impulse_stop_speed, 0.0)
	var lateral_speed_pre: float = lateral.length()
	var impulse_scale: float = 0.0
	if impulse_stop_speed > 0.0:
		var remaining: float = impulse_stop_speed - lateral_speed_pre
		if remaining > 0.0:
			impulse_scale = clamp(remaining / impulse_stop_speed, 0.0, 1.0)

	if impulse_scale > 0.0:
		var dash_vec: Vector3 = dash_dir * (jump_dash_add_speed * impulse_scale)
		lateral += dash_vec

	# Clamp lateral speed to dash limit / global max
	var max_dash_speed: float = jump_dash_max_lateral_speed
	if max_dash_speed <= 0.0:
		max_dash_speed = max_speed

	var lateral_speed: float = lateral.length()
	if lateral_speed > max_dash_speed and lateral_speed > 0.0:
		lateral = lateral.normalized() * max_dash_speed

	# Always mark the dash as used, even if no impulse was applied due to the cutoff.
	play_jumpdash_sfx()
	_jump_dash_used_this_air = true
	_jump_dash_recent_timer = jump_dash_recent_time
	_trigger_anim_command(&"JUMPDASH")
	return lateral

func _get_homing_target_direction() -> Vector3:
	# SUMMARY: Blend movement direction with horizontal facing for homing targeting.
	# STEPS:
	# - Step 1: Use current velocity (full 3D) as the movement direction.
	# - Step 2: Use model forward projected onto gravity-up as the facing direction.
	# - Step 3: Return the normalized average of both.
	var move_dir: Vector3 = velocity
	if move_dir.length() > 0.001:
		move_dir = move_dir.normalized()
	else:
		move_dir = _model_forward
		if move_dir.length() > 0.001:
			move_dir = move_dir.normalized()
		else:
			move_dir = -Vector3.FORWARD

	var gravity_up_dir: Vector3 = gravity_up.normalized()
	if gravity_up_dir.length() < 0.001:
		gravity_up_dir = Vector3.UP

	var face_flat: Vector3 = _model_forward - gravity_up_dir * _model_forward.dot(gravity_up_dir)
	if face_flat.length() > 0.001:
		face_flat = face_flat.normalized()
	else:
		face_flat = move_dir - gravity_up_dir * move_dir.dot(gravity_up_dir)
		if face_flat.length() > 0.001:
			face_flat = face_flat.normalized()
		else:
			face_flat = move_dir

	var hybrid: Vector3 = move_dir + face_flat
	if hybrid.length() < 0.001:
		return move_dir
	return hybrid.normalized()


func _select_homing_target(origin: Vector3, max_range: float) -> Node3D:
	# SUMMARY: Pick a homing target using the configured targeting mode.
	# STEPS:
	# - Step 1: Use camera-based radius targeting when enabled.
	# - Step 2: Fallback to movement/facing hybrid targeting.
	# - Step 3: Return the live target so homing can track it gradually.
	_homing_target_candidate_positions.clear()
	if not _can_scan_homing_targets():
		return null
	var mode: int = SettingsManager.homing_targeting_mode
	var target: Node3D = null
	if mode == SettingsManager.HOMING_TARGETING_CAMERA:
		target = _find_best_homing_target_camera(origin, max_range)
	else:
		var dash_dir: Vector3 = _get_homing_target_direction()
		if dash_dir.length() < 0.001:
			dash_dir = -Vector3.FORWARD
		target = _find_best_homing_target(origin, dash_dir, max_range)

	return target


func _find_best_homing_target_camera(origin: Vector3, max_range: float) -> Node3D:
	# SUMMARY: Pick the closest target inside a camera-centered radius.
	# STEPS:
	# - Step 1: Resolve camera + viewport and validate radius.
	# - Step 2: Filter targets by range/height and screen-space radius.
	# - Step 3: Score by center priority with slight distance bias.
	if not _can_scan_homing_targets():
		return null
	if max_range <= 0.0:
		return null

	var cam: Camera3D = camera
	if cam == null:
		var vp: Viewport = get_viewport()
		if vp != null:
			cam = vp.get_camera_3d()
	if cam == null:
		return null

	var vp_size: Vector2 = cam.get_viewport().get_visible_rect().size
	if vp_size.x <= 0.0 or vp_size.y <= 0.0:
		return null

	var radius: float = max(SettingsManager.homing_camera_radius, 0.0)
	if radius <= 0.0:
		return null

	var center: Vector2 = vp_size * 0.5
	var offset_t: float = clamp(SettingsManager.reticle_vertical_offset, 0.0, 100.0) / 100.0
	center.y += -0.5 * vp_size.y * offset_t
	var aim_origin: Vector3 = cam.project_ray_origin(center)
	var aim_dir: Vector3 = cam.project_ray_normal(center)
	if aim_dir.length() < 0.001:
		aim_dir = -cam.global_transform.basis.z
	if aim_dir.length() < 0.001:
		aim_dir = Vector3.FORWARD
	aim_dir = aim_dir.normalized()
	var center_radius: float = radius * 0.4
	var up: Vector3 = gravity_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	var best: Node3D = null
	var best_score: float = -999999.0
	var best_in_center: bool = false

	var max_range2: float = max_range * max_range
	var nodes: Array = []
	var mgr = get_node_or_null("/root/HomingTargetManager")
	if mgr and mgr.has_method("get_targets_in_range"):
		nodes = mgr.get_targets_in_range(origin, max_range)
	else:
		nodes = get_tree().get_nodes_in_group("HomingTarget")
	for n in nodes:
		if n == null:
			continue
		if not (n is Node3D):
			continue

		# Optional script flag.
		if _object_has_property(n, "enabled") and not bool(n.get("enabled")):
			continue
		if _object_has_property(n, "active") and not bool(n.get("active")):
			continue

		var target_position: Vector3 = _get_homing_target_position_for_aim(n as Node3D, origin, aim_origin, aim_dir)
		var to: Vector3 = target_position - origin
		var dist2: float = to.length_squared()
		if dist2 <= 0.000001 or dist2 > max_range2:
			continue
		if _is_rail_like_homing_target(n) and _is_rail_path_snap_obstructed(origin, target_position):
			continue
		if homing_target_max_height > 0.0:
			var height_delta: float = to.dot(up)
			if height_delta > homing_target_max_height:
				continue

		if cam.is_position_behind(target_position):
			continue
		var screen_pos: Vector2 = cam.unproject_position(target_position)
		var screen_dist: float = screen_pos.distance_to(center)
		if screen_dist > radius:
			continue

		# Compute exact distance only for surviving candidates.
		var dist: float = sqrt(dist2)
		var center_score: float = 1.0 - (screen_dist / radius)
		var range_score: float = 1.0 - (dist / max_range)
		var score: float = center_score * 100.0 + range_score * 5.0

		var in_center: bool = screen_dist <= center_radius
		if in_center:
			if not best_in_center or score > best_score:
				best_score = score
				best = n as Node3D
				best_in_center = true
				_set_homing_candidate_position(best, target_position)
		else:
			if best_in_center:
				continue
			if score > best_score:
				best_score = score
				best = n as Node3D
				_set_homing_candidate_position(best, target_position)

	return best


func _find_best_homing_target(origin: Vector3, dash_dir: Vector3, max_range: float) -> Node3D:
	if not _can_scan_homing_targets():
		return null
	if max_range <= 0.0:
		return null

	var best = null
	var best_score: float = -999999.0
	var up: Vector3 = gravity_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	var max_range2: float = max_range * max_range
	var min_dot2: float = homing_min_dot * homing_min_dot

	var nodes: Array = []
	var mgr = get_node_or_null("/root/HomingTargetManager")
	if mgr and mgr.has_method("get_targets_in_range"):
		nodes = mgr.get_targets_in_range(origin, max_range)
	else:
		nodes = get_tree().get_nodes_in_group("HomingTarget")
	for n in nodes:
		if n == null:
			continue
		if not (n is Node3D):
			continue

		# Optional script flag.
		if _object_has_property(n, "enabled") and not bool(n.get("enabled")):
			continue
		if _object_has_property(n, "active") and not bool(n.get("active")):
			continue

		var target_position: Vector3 = _get_homing_target_position_for_aim(n as Node3D, origin, origin, dash_dir)
		var to: Vector3 = target_position - origin
		var dist2: float = to.length_squared()
		if dist2 <= 0.000001 or dist2 > max_range2:
			continue
		if _is_rail_like_homing_target(n) and _is_rail_path_snap_obstructed(origin, target_position):
			continue
		if homing_target_max_height > 0.0:
			var height_delta: float = to.dot(up)
			if height_delta > homing_target_max_height:
				continue

		# Use projection to avoid normalizing every candidate.
		var projection: float = to.dot(dash_dir)
		if projection <= 0.0:
			continue
		if projection * projection < min_dot2 * dist2:
			continue

		# Compute exact values for scoring only for remaining candidates.
		var dist: float = sqrt(dist2)
		var dir: Vector3 = to / dist
		var dotv: float = dir.dot(dash_dir)

		# Prefer high dot and closer distance.
		var score: float = dotv * 1000.0 - dist
		if score > best_score:
			best_score = score
			best = n
			_set_homing_candidate_position(n as Node3D, target_position)

	return best

func _get_homing_reticle_target() -> Node3D:
	# Return the cached reticle target when fresh to avoid scanning large groups each frame.
	if not _can_scan_homing_targets():
		return null
	if attached:
		return null
	var speed_now: float = velocity.length()
	var max_range: float = homing_min_range + speed_now * homing_range_per_speed
	max_range = clamp(max_range, homing_min_range, homing_max_range)

	var now_ms: int = Time.get_ticks_msec()
	if _homing_reticle_cached_target != null and is_instance_valid(_homing_reticle_cached_target) and now_ms - _homing_reticle_cached_time_ms < HOMING_RETICLE_CACHE_MS:
		var cached_position: Vector3 = _refresh_homing_candidate_position(_homing_reticle_cached_target, global_position)
		var to_cached: Vector3 = cached_position - global_position
		if to_cached.length_squared() <= max_range * max_range:
			return _homing_reticle_cached_target

	# Fresh selection (may be heavier). Uses HomingTargetManager if available.
	var t: Node3D = _select_homing_target(global_position, max_range)
	_homing_reticle_cached_target = t
	_homing_reticle_cached_time_ms = now_ms
	return t


func _try_handle_homing_hit(target: Node, jump_held: bool) -> bool:
	var n: Node = target
	while n != null:
		if n.has_method("on_homing_hit"):
			var handled = n.call("on_homing_hit", self, jump_held)
			if handled is bool and bool(handled):
				return true
		n = n.get_parent()
	return false


func _end_homing(up: Vector3, jump_held: bool) -> void:
	_homing_active = false
	var retained = Vector3.ZERO
	if homing_retain_speed_if_jump_held and jump_held:
		retained = _homing_saved_velocity
	velocity = retained + up.normalized() * homing_pop_up_speed
	attached = false
	_jump_dash_used_this_air = false
	_tornado_kick_used_this_air = false


func _update_homing(delta: float, up_for_physics: Vector3, is_attached: bool) -> void:
	if not _homing_active:
		return
	_homing_elapsed += delta
	if homing_fail_timeout > 0.0 and _homing_elapsed >= homing_fail_timeout:
		cancel_homing_attack(false)
		return
	if is_attached:
		_homing_active = false
		_homing_target = null
		_homing_target_position = Vector3.ZERO
		_homing_target_position_valid = false
		_homing_elapsed = 0.0
		return

	if _homing_target == null or not is_instance_valid(_homing_target):
		_homing_active = false
		_homing_target = null
		_homing_target_position = Vector3.ZERO
		_homing_target_position_valid = false
		_homing_elapsed = 0.0
		return

	var up = up_for_physics.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	var origin: Vector3 = global_position
	var target_position: Vector3 = get_homing_attack_target_position()
	var to: Vector3 = target_position - origin
	var dist: float = to.length()
	var hit_distance: float = homing_hit_distance
	var homing_target_is_rail: bool = _homing_target is Node and _is_rail_like_homing_target(_homing_target)
	if homing_target_is_rail:
		if _is_rail_path_snap_obstructed(origin, target_position):
			cancel_homing_attack(false)
			return
		hit_distance = max(hit_distance, _get_rail_path_snap_radius())

	if dist <= hit_distance:
		var current_velocity = velocity
		var current_lateral = velocity - up * velocity.dot(up)
		var jump_held = _is_jump_held()

		var homing_dir: Vector3 = to / max(dist, 0.001)
		var homing_spd: float = max(homing_speed, _homing_saved_speed_mag)
		var is_pass_through: bool = _object_has_property(_homing_target, "pass_through") and _homing_target.get("pass_through")

		if _try_handle_homing_hit(_homing_target, jump_held):
			if is_pass_through:
				velocity = homing_dir * homing_spd
				_jump_dash_used_this_air = false
				_tornado_kick_used_this_air = false
			_homing_active = false
			_homing_target = null
			_homing_target_position = Vector3.ZERO
			_homing_target_position_valid = false
			_homing_elapsed = 0.0
			_homing_post_attack_timer = max(homing_post_attack_time, 0.0)
			return
		var pop_speed = homing_pop_up_speed
		if _object_has_property(_homing_target, "pop_up_speed_override"):
			var ov = _homing_target.get("pop_up_speed_override")
			if ov is float and float(ov) > 0.0:
				pop_speed = float(ov)

		_homing_active = false
		var retained = Vector3.ZERO
		if homing_retain_speed_if_jump_held and jump_held:
			if current_velocity.dot(up) < 0.0:
				retained = current_lateral
			elif current_velocity.length() > 0.001:
				retained = current_velocity
			elif current_lateral.length() > 0.001:
				retained = current_lateral
			else:
				retained = _homing_saved_lateral
			_homing_retain_timer = max(homing_retain_disable_air_decel_time, 0.0)
		velocity = retained + up * pop_speed
		attached = false
		_jump_dash_used_this_air = false
		_tornado_kick_used_this_air = false
		_homing_post_attack_timer = max(homing_post_attack_time, 0.0)
		_homing_target = null
		_homing_target_position = Vector3.ZERO
		_homing_target_position_valid = false
		_homing_elapsed = 0.0
		return

	var desired_dir = to / dist
	var spd = max(homing_speed, _homing_saved_speed_mag)
	var current_dir = velocity.normalized()
	if current_dir.length() < 0.001:
		velocity = desired_dir * spd
	else:
		var angle = current_dir.angle_to(desired_dir)
		var max_turn = homing_turn_rate * delta
		if angle > max_turn and angle > 0.001:
			var t = max_turn / angle
			velocity = current_dir.slerp(desired_dir, t) * spd
		else:
			velocity = desired_dir * spd


func cancel_homing_attack(restore_saved_velocity: bool = false) -> void:
	_stop_lightspeed_dash_if_active(false)
	# Optionally restore the pre-homing velocity so downstream effects (springs, etc.)
	# don't inherit the "toward target" homing velocity.
	if restore_saved_velocity and (_homing_active or _homing_target != null):
		if _homing_saved_velocity.length() > 0.001:
			velocity = _homing_saved_velocity

	_homing_active = false
	_homing_target = null
	_homing_target_position = Vector3.ZERO
	_homing_target_position_valid = false
	_homing_saved_velocity = Vector3.ZERO
	_homing_saved_lateral = Vector3.ZERO
	_homing_saved_speed_mag = 0.0
	_homing_retain_timer = 0.0
	_homing_elapsed = 0.0


func _try_start_lightspeed_dash() -> bool:
	if not can_start_lightspeed_dash():
		return false
	var forward_bias: Vector3 = _get_lightspeed_forward_bias()
	var target := _find_best_lightspeed_ring(global_position, lightspeed_dash_start_radius, forward_bias, null)
	if target == null:
		return false
	_stop_lightspeed_dash_if_active(false)
	_lightspeed_dash_active = true
	_lightspeed_dash_target = target
	_lightspeed_dash_prev_ring = null
	_lightspeed_dash_timer = 0.0
	var base_velocity: Vector3 = velocity
	if base_velocity.length() <= 0.01:
		base_velocity = forward_bias
	if base_velocity.length() <= 0.01:
		base_velocity = _model_forward
	if base_velocity.length() <= 0.01:
		base_velocity = -global_transform.basis.z
	var base_dir: Vector3 = base_velocity.normalized() if base_velocity.length() > 0.001 else _get_camera_forward_world_up(gravity_up)
	if base_dir.length() <= 0.001:
		base_dir = Vector3.FORWARD
	var start_speed: float = max(lightspeed_dash_min_speed, max(base_velocity.length(), 0.0))
	if lightspeed_dash_start_additive_speed_enabled:
		start_speed += max(lightspeed_dash_start_additive_speed, 0.0)
	if lightspeed_dash_start_speed_cap > 0.0:
		start_speed = min(start_speed, lightspeed_dash_start_speed_cap)
	_lightspeed_dash_speed = max(start_speed, lightspeed_dash_min_speed)
	if _lightspeed_dash_speed <= 0.0:
		_lightspeed_dash_speed = lightspeed_dash_min_speed
	_lightspeed_dash_release_velocity = base_dir.normalized() * _lightspeed_dash_speed
	var initial_dir: Vector3 = (_lightspeed_dash_target.global_position - global_position)
	if initial_dir.length() > 0.001:
		_lightspeed_dash_last_dir = initial_dir.normalized()
	else:
		_lightspeed_dash_last_dir = base_dir.normalized()
	_bounce_state = BounceState.NONE
	# Cancel homing attack manually without stopping lightspeed dash
	_homing_active = false
	_homing_target = null
	_homing_target_position = Vector3.ZERO
	_homing_target_position_valid = false
	_homing_saved_velocity = Vector3.ZERO
	_homing_saved_lateral = Vector3.ZERO
	_homing_saved_speed_mag = 0.0
	_homing_retain_timer = 0.0
	_homing_elapsed = 0.0
	cancel_spline_spring()
	cancel_rail_grind()
	_reset_spindash_state()
	rolling = false
	_spindash_charging = false
	_jump_dash_requested = false
	_tornado_kick_used_this_air = false
	_jump_dash_used_this_air = true
	attached = false
	_is_jumping = false
	_is_falling = false
	_trigger_anim_command(&"CMD_LIGHTSPEEDDASH")
	# Lock input immediately to prevent normal movement on this frame
	_spring_movement_lock_timer = 0.1
	_spring_action_lock_timer = 0.1
	return true


func _get_lightspeed_forward_bias() -> Vector3:
	var dir: Vector3 = velocity
	if dir.length() > 0.001:
		return dir.normalized()
	if _model_forward.length() > 0.001:
		return _model_forward.normalized()
	var world_up: Vector3 = gravity_up.normalized()
	if world_up.length() < 0.001:
		world_up = Vector3.UP
	var cam_dir: Vector3 = _get_camera_forward_world_up(world_up)
	if cam_dir.length() > 0.001:
		return cam_dir.normalized()
	return Vector3.FORWARD


func _is_ring_available_for_lightspeed(ring: Node) -> bool:
	if ring == null or not is_instance_valid(ring):
		return false
	if ring.has_method("is_light_speed_dash_ready"):
		if not bool(ring.call("is_light_speed_dash_ready")):
			return false
	if _object_has_property(ring, "enabled") and not bool(ring.get("enabled")):
		return false
	if _object_has_property(ring, "allow_light_speed_dash") and not bool(ring.get("allow_light_speed_dash")):
		return false
	return true


func _find_best_lightspeed_ring(origin: Vector3, max_radius: float, forward_bias: Vector3, exclude: Node) -> Node3D:
	# Apply speed-based radius bonus first so the manager query uses the correct range.
	var speed: float = velocity.length()
	var speed_bonus_radius: float = speed * lightspeed_dash_speed_bonus_per_speed
	var effective_radius: float = max_radius + speed_bonus_radius

	var nodes: Array = []
	var mgr = get_node_or_null("/root/HomingTargetManager")
	if mgr and mgr.has_method("get_rings_in_range"):
		nodes = mgr.get_rings_in_range(origin, effective_radius)
	elif get_tree() != null:
		nodes = get_tree().get_nodes_in_group(LIGHTSPEED_RING_GROUP)
	if nodes.is_empty():
		return null
	
	var forward_norm: Vector3 = forward_bias.normalized() if forward_bias.length() > 0.001 else Vector3.ZERO
	var up: Vector3 = gravity_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP
	
	# Get camera direction and screen cursor position for targeting methods
	var camera_forward: Vector3 = _get_camera_forward_world_up(gravity_up)
	var screen_cursor_pos: Vector2 = Vector2.ZERO
	var cam: Camera3D = camera
	if cam == null:
		var vp: Viewport = get_viewport()
		if vp != null:
			cam = vp.get_camera_3d()
	if cam != null:
		screen_cursor_pos = cam.get_viewport().get_mouse_position()
	
	var best: Node3D = null
	var best_score: float = -999999.0
	
	for entry in nodes:
		var ring := entry as Node3D
		if ring == null or not is_instance_valid(ring):
			continue
		if exclude != null and ring == exclude:
			continue
		if not _is_ring_available_for_lightspeed(ring):
			continue
		var to: Vector3 = ring.global_position - origin
		var dist: float = to.length()
		if dist <= 0.001:
			continue
		if effective_radius > 0.0 and dist > effective_radius:
			continue
		if lightspeed_dash_max_height_delta > 0.0:
			var height_delta: float = abs(to.dot(up))
			if height_delta > lightspeed_dash_max_height_delta:
				continue

		# Skip rings obstructed by collision geometry (with raycast caching)
		var ring_rid: RID = (ring as CollisionObject3D).get_rid() if ring is CollisionObject3D else RID()
		var is_obstructed: bool = false
		
		# Check cache first
		var current_time_ms: int = Time.get_ticks_msec()
		if ring_rid.is_valid() and ring_rid in _lightspeed_raycast_cache:
			var cache_entry: Dictionary = _lightspeed_raycast_cache[ring_rid]
			if current_time_ms - cache_entry.time_ms < LIGHTSPEED_RAYCAST_CACHE_MS:
				is_obstructed = cache_entry.obstructed
			else:
				_lightspeed_raycast_cache.erase(ring_rid)
		
		# If not cached, perform raycast
		if not (ring_rid.is_valid() and ring_rid in _lightspeed_raycast_cache):
			var world: World3D = get_world_3d()
			if world != null:
				var ray_from: Vector3 = origin
				var ray_to: Vector3 = ring.global_position
				var ray_params: PhysicsRayQueryParameters3D = PhysicsRayQueryParameters3D.create(ray_from, ray_to)
				var exclude_list: Array[RID] = []
				exclude_list.append(get_rid())
				if ring is CollisionObject3D:
					exclude_list.append(ring_rid)
				ray_params.exclude = exclude_list
				ray_params.collision_mask = collision_mask
				var ray_result: Dictionary = world.direct_space_state.intersect_ray(ray_params)
				if ray_result:
					var hit_pos: Vector3 = ray_result.position
					var dist_to_hit: float = ray_from.distance_to(hit_pos)
					is_obstructed = dist_to_hit < dist - 0.1
				
				# Cache the result
				if ring_rid.is_valid():
					_lightspeed_raycast_cache[ring_rid] = {"time_ms": current_time_ms, "obstructed": is_obstructed}
		
		if is_obstructed:
			continue

		var dir: Vector3 = to / dist

		# Calculate score based on targeting method
		var score: float = 0.0
		
		# For all methods, give extra weight to rings in movement direction
		var movement_bonus: float = 0.0
		if forward_norm.length() > 0.001:
			var movement_dot: float = dir.dot(forward_norm)
			if movement_dot >= lightspeed_dash_min_forward_dot:
				movement_bonus = movement_dot * 2000.0 # Strong bonus for movement direction
		
		var targeting_mode: int = SettingsManager.lightspeed_dash_targeting_mode
		match targeting_mode:
			SettingsManager.LIGHTSPEED_DASH_TARGETING_MOVEMENT:
				# Prefer rings in input direction
				if forward_norm.length() > 0.001:
					var dotv: float = dir.dot(forward_norm)
					if dotv < lightspeed_dash_min_forward_dot:
						continue
					score = dotv * 1000.0 - dist
				else:
					score = -dist
			
			SettingsManager.LIGHTSPEED_DASH_TARGETING_CAMERA:
				# Prefer rings under screen cursor
				var camera_dot: float = dir.dot(camera_forward)
				if camera_dot < lightspeed_dash_min_forward_dot:
					continue
				var cursor_bonus: float = 0.0
				if cam != null:
					var screen_pos = cam.unproject_position(ring.global_position)
					var cursor_dist = screen_pos.distance_to(screen_cursor_pos)
					# Bonus for being close to cursor (in screen space)
					var viewport_size = cam.get_viewport().get_visible_rect().size
					var normalized_cursor_dist = cursor_dist / viewport_size.length()
					cursor_bonus = (1.0 - clamp(normalized_cursor_dist, 0.0, 1.0)) * 500.0
				score = camera_dot * 1000.0 + cursor_bonus - dist
			
			SettingsManager.LIGHTSPEED_DASH_TARGETING_HYBRID:
				# Combine camera and input
				var camera_dot: float = dir.dot(camera_forward)
				var input_dot: float = 0.0
				if forward_norm.length() > 0.001:
					input_dot = dir.dot(forward_norm)
				
				# Determine if input is within camera facing direction
				var hybrid_angle_rad = deg_to_rad(lightspeed_dash_hybrid_angle_deg)
				var camera_input_angle = camera_forward.angle_to(forward_norm) if forward_norm.length() > 0.001 else 0.0
				
				var use_camera = camera_input_angle <= hybrid_angle_rad and camera_dot >= lightspeed_dash_min_forward_dot
				var use_input = forward_norm.length() > 0.001 and input_dot >= lightspeed_dash_min_forward_dot
				
				var cursor_bonus: float = 0.0
				if cam != null:
					var screen_pos = cam.unproject_position(ring.global_position)
					var cursor_dist = screen_pos.distance_to(screen_cursor_pos)
					var viewport_size = cam.get_viewport().get_visible_rect().size
					var normalized_cursor_dist = cursor_dist / viewport_size.length()
					cursor_bonus = (1.0 - clamp(normalized_cursor_dist, 0.0, 1.0)) * 500.0
				
				if use_camera and use_input:
					# Ring is in both directions, use weighted combination
					score = (camera_dot * 0.6 + input_dot * 0.4) * 1000.0 + cursor_bonus - dist
				elif use_camera:
					# Ring is in camera direction but not input
					score = camera_dot * 1000.0 + cursor_bonus - dist
				elif use_input:
					# Ring is in input direction but not camera
					score = input_dot * 1000.0 - dist
				else:
					# Ring is in neither direction
					continue
		
		# Add movement direction bonus to all methods
		score += movement_bonus
		
		if score > best_score:
			best_score = score
			best = ring
	
	return best


func _advance_lightspeed_dash_target() -> bool:
	if _lightspeed_dash_target != null and is_instance_valid(_lightspeed_dash_target):
		_lightspeed_dash_prev_ring = _lightspeed_dash_target
	var origin: Vector3 = global_position
	if _lightspeed_dash_prev_ring != null and is_instance_valid(_lightspeed_dash_prev_ring):
		origin = _lightspeed_dash_prev_ring.global_position
	var bias: Vector3 = _lightspeed_dash_last_dir
	if bias.length() < 0.001:
		bias = _lightspeed_dash_release_velocity
	var next := _find_best_lightspeed_ring(origin, lightspeed_dash_chain_radius, bias, _lightspeed_dash_prev_ring)
	_lightspeed_dash_target = next
	return next != null


func _update_lightspeed_dash(_delta: float, _physics_up: Vector3) -> void:
	if not _lightspeed_dash_active:
		return

	# Check for Action1 cancellation
	if Input.is_action_just_pressed("action_1"):
			_end_lightspeed_dash(true, false)
			return

	# Ensure we have a valid target
	if _lightspeed_dash_target == null or not _is_ring_available_for_lightspeed(_lightspeed_dash_target):
			if not _advance_lightspeed_dash_target():
				_end_lightspeed_dash(true, false)
				return

	var target_pos: Vector3 = _lightspeed_dash_target.global_position
	var to_target: Vector3 = target_pos - global_position
	var dist: float = to_target.length()
	var dir: Vector3
	if dist > 0.001:
		dir = to_target / dist
	else:
		dir = _lightspeed_dash_last_dir
	if dir.length() < 0.001:
		dir = -global_transform.basis.z
	if dir.length() < 0.001:
		dir = Vector3.FORWARD

	# Set velocity for move_and_slide to handle position and collision
	velocity = dir * _lightspeed_dash_speed
	_lightspeed_dash_last_dir = dir
	_lightspeed_dash_release_velocity = velocity

	# Keep state flags consistent
	attached = false
	_is_jumping = false
	_is_falling = false
	_jump_dash_used_this_air = true
	_tornado_kick_used_this_air = false


func _post_move_lightspeed_dash(_delta: float) -> void:
	if not _lightspeed_dash_active:
		return

	# After move_and_slide, check if we reached the current ring
	if _lightspeed_dash_target != null and is_instance_valid(_lightspeed_dash_target):
		var dist := global_position.distance_to(_lightspeed_dash_target.global_position)
		var collect_dist: float = max(lightspeed_dash_collect_distance, 0.05)
		if dist <= collect_dist:
			# Snap to ring position and try to advance
			global_position = _lightspeed_dash_target.global_position
			if not _advance_lightspeed_dash_target():
				_end_lightspeed_dash(true, true)
				return

	# If target is no longer valid, try to advance
	if _lightspeed_dash_target == null or not _is_ring_available_for_lightspeed(_lightspeed_dash_target):
		if not _advance_lightspeed_dash_target():
			_end_lightspeed_dash(true, true)


func _end_lightspeed_dash(apply_release_velocity: bool, try_attach: bool = false) -> void:
	if not _lightspeed_dash_active:
		return
	_lightspeed_dash_active = false
	_lightspeed_dash_target = null
	_lightspeed_dash_prev_ring = null
	_lightspeed_raycast_cache.clear()  # Clear raycast cache when dash ends
	if apply_release_velocity and _lightspeed_dash_release_velocity.length() > 0.001:
		velocity = _lightspeed_dash_release_velocity
	_lightspeed_dash_release_velocity = Vector3.ZERO
	_lightspeed_dash_last_dir = Vector3.ZERO
	_lightspeed_dash_timer = 0.0
	if _current_action_id == &"lightspeed_dash":
		clear_active_action()
	if try_attach and lightspeed_dash_auto_attach_on_end and not attached:
		_attempt_lightspeed_dash_ground_attach()
	if not attached:
		activate_neutral_air_action({"reason": &"lightspeed_dash_end"})


func _attempt_lightspeed_dash_ground_attach() -> void:
	var hit: Dictionary = _find_lightspeed_dash_attach_hit()
	if hit.is_empty():
		print("[LSD-ATTACH] no surface within ", lightspeed_dash_auto_attach_max_distance)
		return

	var hit_position: Vector3 = hit["position"] if hit.has("position") and hit["position"] is Vector3 else global_position
	var hit_normal: Vector3 = hit["normal"] if hit.has("normal") and hit["normal"] is Vector3 else Vector3.UP
	if _is_low_speed_detach_reattach_blocked(hit_normal, gravity_up):
		return
	var surface_kind: String = hit["kind"] if hit.has("kind") and hit["kind"] is String else "surface"
	print("[LSD-ATTACH] hit ", surface_kind, " at ", hit_position, " normal=", hit_normal)
	global_position = hit_position + hit_normal * max(collision_ground_distance, 0.05)
	_apply_grounded_from_downwarp(hit_position, hit_normal)
	_lock_to_surface()


func _find_lightspeed_dash_attach_hit() -> Dictionary:
	var result: Dictionary = {}
	if DEBUG_SKIP_AIR_RAYS:
		return result
	var world: World3D = get_world_3d()
	if world == null:
		return result

	var up: Vector3 = gravity_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	var max_distance: float = max(lightspeed_dash_auto_attach_max_distance, ground_ray_length)
	max_distance = max(max_distance, 0.1)
	var origin: Vector3 = global_position + up * 0.1

	var forward: Vector3 = _get_lightspeed_forward_bias()
	forward = forward - up * forward.dot(up)
	if forward.length() < 0.001:
		forward = -global_transform.basis.z
		forward = forward - up * forward.dot(up)
	if forward.length() < 0.001:
		forward = global_transform.basis.x - up * global_transform.basis.x.dot(up)
	if forward.length() < 0.001:
		forward = Vector3.FORWARD - up * Vector3.FORWARD.dot(up)
	if forward.length() < 0.001:
		forward = Vector3.RIGHT - up * Vector3.RIGHT.dot(up)
	if forward.length() > 0.001:
		forward = forward.normalized()

	var right: Vector3 = up.cross(forward)
	if right.length() < 0.001:
		right = global_transform.basis.x - up * global_transform.basis.x.dot(up)
	if right.length() < 0.001:
		right = global_transform.basis.z - up * global_transform.basis.z.dot(up)
	if right.length() < 0.001:
		right = Vector3.RIGHT - up * Vector3.RIGHT.dot(up)
	if right.length() > 0.001:
		right = right.normalized()

	var directions: Array = []
	directions.append(-up)
	if forward.length() > 0.001:
		directions.append(forward)
		directions.append(-forward)
		directions.append((forward - up).normalized())
		directions.append((-forward - up).normalized())
		directions.append((forward + up).normalized())
		directions.append((-forward + up).normalized())
	if right.length() > 0.001:
		directions.append(right)
		directions.append(-right)
		directions.append((right - up).normalized())
		directions.append((-right - up).normalized())
		directions.append((right + up).normalized())
		directions.append((-right + up).normalized())
	if forward.length() > 0.001 and right.length() > 0.001:
		directions.append((forward + right).normalized())
		directions.append((forward - right).normalized())
		directions.append((-forward + right).normalized())
		directions.append((-forward - right).normalized())
	directions.append(up)

	var mask: int = collision_mask
	if ground_ray != null:
		mask = ground_ray.collision_mask

	var best_floor_hit: bool = false
	var best_floor_distance: float = INF
	var best_floor_point: Vector3 = Vector3.ZERO
	var best_floor_normal: Vector3 = Vector3.UP
	var best_any_hit: bool = false
	var best_any_distance: float = INF
	var best_any_point: Vector3 = Vector3.ZERO
	var best_any_normal: Vector3 = Vector3.UP

	for direction in directions:
		var dir: Vector3 = direction
		if dir.length() < 0.001:
			continue
		dir = dir.normalized()
		var params: PhysicsRayQueryParameters3D = PhysicsRayQueryParameters3D.create(origin, origin + dir * max_distance)
		params.collision_mask = mask
		params.collide_with_areas = false
		params.collide_with_bodies = true
		params.exclude = [self]

		var hit: Dictionary = world.direct_space_state.intersect_ray(params)
		if hit.is_empty():
			continue

		var hit_position: Vector3 = hit["position"] if hit.has("position") and hit["position"] is Vector3 else Vector3.ZERO
		var hit_normal: Vector3 = hit["normal"] if hit.has("normal") and hit["normal"] is Vector3 else Vector3.ZERO
		if hit_normal.length() < 0.001:
			continue

		var hit_distance: float = origin.distance_to(hit_position)
		if hit_distance > max_distance + 0.001:
			continue

		var dot_up: float = clamp(hit_normal.normalized().dot(up), -1.0, 1.0)
		var angle_deg: float = rad_to_deg(acos(dot_up))
		var is_floor_like: bool = dot_up > 0.0 and angle_deg <= floor_like_max_angle_deg

		if is_floor_like:
			if not best_floor_hit or hit_distance < best_floor_distance:
				best_floor_hit = true
				best_floor_distance = hit_distance
				best_floor_point = hit_position
				best_floor_normal = hit_normal.normalized()
		elif lightspeed_dash_auto_attach_allow_wall_fallback:
			if not best_any_hit or hit_distance < best_any_distance:
				best_any_hit = true
				best_any_distance = hit_distance
				best_any_point = hit_position
				best_any_normal = hit_normal.normalized()

	if best_floor_hit:
		result["position"] = best_floor_point
		result["normal"] = best_floor_normal
		result["kind"] = "preferred"
		return result

	if best_any_hit:
		result["position"] = best_any_point
		result["normal"] = best_any_normal
		result["kind"] = "fallback"

	return result


func _stop_lightspeed_dash_if_active(apply_release_velocity: bool = false) -> void:
	if _lightspeed_dash_active:
		_end_lightspeed_dash(apply_release_velocity, false)


func cancel_spline_spring() -> void:
	_spline_active = false
	_spline_path = null
	_spline_distance = 0.0
	_spline_speed = 0.0
	_spline_total_length = 0.0


func cancel_rail_grind(reset_velocity: bool = false) -> void:
	if _rail_grind_action != null:
		_rail_grind_action.cancel_grind(reset_velocity)
	_rail_active = false
	_rail_path = null
	_rail_distance = 0.0
	_rail_total_length = 0.0
	_rail_speed = 0.0
	_rail_travel_sign = 1.0
	_rail_last_tangent = Vector3.FORWARD
	_rail_last_motion_dir = Vector3.FORWARD
	_rail_model_basis_valid = false
	_stop_rail_grind_sfx()
	if reset_velocity:
		velocity = Vector3.ZERO


# SUMMARY: Cache automation spline influence for the next physics frame.
# NOTE: force_surface_adhesion keeps adhesion active even on steep geometry.
# NOTE: lock_controls is legacy; lock_movement/actions/drift provide separate locks.
# NOTE: priority selects the active automation when multiple splines overlap.
func set_timed_max_speed_override(speed: float, duration: float) -> void:
	if not _network_is_local_authority():
		return
	if race_in_countdown:
		clear_timed_max_speed_override()
		return
	var duration_used: float = max(duration, 0.0)
	var speed_used: float = max(speed, 0.0)
	if duration_used <= 0.0:
		clear_timed_max_speed_override()
		return
	_timed_max_speed_override = speed_used
	_timed_max_speed_override_timer = duration_used


func clear_timed_max_speed_override() -> void:
	_functional_max_speed = max(max_speed, 0.0)
	_timed_max_speed_override_timer = 0.0
	_timed_max_speed_override = 0.0


func clear_max_speed_overrides() -> void:
	clear_timed_max_speed_override()
	_automation_max_speed_override_enabled = false
	_automation_max_speed_override = 0.0


func set_automation_spline(
	tangent_dir: Vector3,
	toward_dir: Vector3,
	toward_strength: float,
	max_turn_deg_per_sec: float,
	lock_controls: bool,
	continuous_force: bool,
	align_rotation: bool,
	grounded_only: bool,
	force_surface_adhesion: bool,
	tangent_snap_strength: float,
	along_assist_enabled: bool,
	along_assist_target_speed: float,
	along_assist_accel: float,
	lock_movement: bool = false,
	lock_actions: bool = false,
	lock_drift: bool = false,
	priority: int = 0,
	ignore_water_physics_multipliers: bool = false,
	override_max_speed: bool = false,
	max_speed_override: float = 0.0
) -> void:
	if not _network_is_local_authority():
		return
	var frame_id: int = Engine.get_physics_frames()
	if frame_id != _automation_priority_frame:
		_automation_priority_frame = frame_id
		_automation_priority_current = -9999
	if priority < _automation_priority_current:
		return
	var lock_movement_effective: bool = lock_movement or lock_controls
	var lock_actions_effective: bool = lock_actions or lock_controls
	var lock_drift_effective: bool = lock_drift or lock_controls
	_automation_active = true
	_automation_tangent_dir = tangent_dir
	_automation_toward_dir = toward_dir
	_automation_toward_strength = toward_strength
	_automation_max_turn_deg_per_sec = max_turn_deg_per_sec
	_automation_lock_movement = lock_movement_effective
	_automation_lock_actions = lock_actions_effective
	_automation_lock_drift = lock_drift_effective
	_automation_priority_current = priority
	_automation_continuous_force = continuous_force
	_automation_align_rotation = align_rotation
	_automation_grounded_only = grounded_only
	_automation_force_surface_adhesion = force_surface_adhesion
	_automation_tangent_snap_strength = max(tangent_snap_strength, 0.0)
	_automation_along_assist_enabled = along_assist_enabled
	_automation_along_target_speed = along_assist_target_speed
	_automation_along_accel = along_assist_accel
	_automation_ignore_water_physics = ignore_water_physics_multipliers
	_automation_max_speed_override_enabled = override_max_speed and not race_in_countdown
	_automation_max_speed_override = max(max_speed_override, 0.0)
	_automation_timer = 0.1


func _automation_locks_active() -> bool:
	# Locks follow the same grounded-only gating as automation movement influence.
	if not _automation_active:
		return false
	if _automation_timer <= 0.0:
		return false
	if _automation_grounded_only and not attached:
		return false
	return true


func _object_has_property(obj: Object, property_name: String) -> bool:
	if obj == null:
		return false
	var cache_key: String = _get_property_cache_key(obj)
	if cache_key == "":
		return false
	if not _property_name_cache.has(cache_key):
		var names: Dictionary = {}
		for item in obj.get_property_list():
			if item is Dictionary and item.has("name"):
				names[String(item["name"])] = true
		_property_name_cache[cache_key] = names
	var cached_names: Dictionary = _property_name_cache[cache_key]
	return cached_names.has(property_name)


func _get_property_cache_key(obj: Object) -> String:
	if obj == null:
		return ""
	var script: Variant = obj.get_script()
	if script is Script:
		var script_resource: Script = script
		if script_resource.resource_path != "":
			return "script:%s" % script_resource.resource_path
		return "script_id:%d" % script_resource.get_instance_id()
	return "class:%s" % obj.get_class()

func _do_bounce_landing(v_before: Vector3, landing_normal: Vector3) -> void:
	var n: Vector3 = landing_normal.normalized()
	if n.length() < 0.001:
		return

	var v: Vector3 = v_before

	# Decompose into normal + tangential components relative to the landing surface
	var v_normal: Vector3 = n * v.dot(n)
	var v_tangent: Vector3 = v - v_normal

	v_tangent = _apply_horizontal_speed_penalty(
		v_tangent,
		bounce_land_horizontal_threshold,
		bounce_land_horizontal_subtract
	)

	# Speed into the surface (positive when moving into it)
	var into_speed: float = -v_normal.dot(n)
	if into_speed < 0.0:
		into_speed = 0.0

	# Enforce a minimum impact speed so tiny drops still bounce decently
	if into_speed < bounce_min_impact_speed:
		into_speed = bounce_min_impact_speed

	into_speed = _apply_landing_speed_subtraction(
		into_speed,
		bounce_land_speed_threshold,
		bounce_land_speed_subtract
	)

	# Bounce magnitude = impact speed + additive
	var bounce_speed: float = into_speed + bounce_add_speed
	bounce_speed = clamp(bounce_speed, bounce_min_up_speed, bounce_max_up_speed)

	# Final velocity: keep tangential unchanged, flip normal upwards along the surface
	velocity = v_tangent + n * bounce_speed

	_on_trick_detected(TrickSystem.TrickType.BOUNCE_POGO)

	# We are airborne after the bounce.
	attached = false
	_jump_dash_used_this_air = false
	_airborne_time = 0.0

	# Kill "falling" flag so other logic knows we've just pushed off
	_is_falling = false

	# This is not a normal jump
	_is_jumping = false
	_jump_hang_allowed = false
	_jump_time = 0.0

	# SFX for bounce landing
	_play_sfx(sfx_bounce_land)

	# Bounce state ends after we've been launched upward
	_bounce_state = BounceState.NONE
	reset_flight_eligibility()
	end_active_flight_for_external_impulse({"reason": &"bounce_landing"})

func _apply_landing_speed_subtraction(
	into_speed: float,
	threshold: float,
	subtract: float
) -> float:
	if subtract <= 0.0:
		return into_speed
	if threshold < 0.0:
		threshold = 0.0
	if into_speed <= threshold:
		return into_speed
	return max(into_speed - subtract, threshold)


func _apply_velocity_speed_subtraction(
	velocity_in: Vector3,
	normal: Vector3,
	threshold: float,
	subtract: float
) -> Vector3:
	if subtract <= 0.0:
		return velocity_in

	var n := normal.normalized()
	if n.length() < 0.001:
		return velocity_in

	var v_normal := n * velocity_in.dot(n)
	var into_speed := -v_normal.dot(n)
	if into_speed <= threshold:
		return velocity_in

	var new_speed : float = max(into_speed - subtract, threshold)
	var v_tangent := velocity_in - v_normal
	var new_v_normal : Vector3 = -n * new_speed
	return v_tangent + new_v_normal


func _apply_horizontal_speed_penalty(
	tangent_velocity: Vector3,
	threshold: float,
	subtract: float
) -> Vector3:
	if subtract <= 0.0:
		return tangent_velocity

	var speed := tangent_velocity.length()
	if speed <= threshold or speed <= 0.0001:
		return tangent_velocity

	var new_speed : float = max(speed - subtract, threshold)
	return tangent_velocity.normalized() * new_speed


func _apply_horizontal_velocity_penalty(
	velocity_in: Vector3,
	normal: Vector3,
	threshold: float,
	subtract: float
) -> Vector3:
	if subtract <= 0.0:
		return velocity_in

	var n := normal.normalized()
	if n.length() < 0.001:
		return velocity_in

	var v_normal := n * velocity_in.dot(n)
	var v_tangent := velocity_in - v_normal
	var new_v_tangent := _apply_horizontal_speed_penalty(v_tangent, threshold, subtract)
	return new_v_tangent + v_normal

# ===========================================================
# ABILITY QUEUE
# ===========================================================
func queue_jump() -> bool:
	if _action_input_locked():
		return false
	if _automation_lock_actions and _automation_locks_active():
		return false
	if race_in_countdown:
		return false
	_jump_requested = true
	_notify_buddy_leader_jump_pressed()
	return true


func queue_coyote_jump() -> bool:
	if _action_input_locked():
		return false
	if _automation_lock_actions and _automation_locks_active():
		return false
	if race_in_countdown:
		return false
	_coyote_jump_requested = true
	_jump_requested = true
	_notify_buddy_leader_jump_pressed()
	return true
	
func queue_jump_dash() -> bool:
	if _action_input_locked():
		return false
	if _automation_lock_actions and _automation_locks_active():
		return false
	if race_in_countdown:
		return false
	if jump_dash_air_only and attached:
		return false
	if jump_dash_once_per_air and _jump_dash_used_this_air:
		return false
	if not attached and _can_consume_coyote_jump():
		if coyote_jump_homing_priority and _can_scan_homing_targets() and has_homing_target_in_range():
			_jump_dash_requested = true
			return true
		return queue_coyote_jump()
	_jump_dash_requested = true
	return true


func queue_homing_attack() -> bool:
	if _action_input_locked():
		return false
	if _automation_lock_actions and _automation_locks_active():
		return false
	if race_in_countdown or attached:
		return false
	_jump_dash_requested = true
	return true


func _action_input_locked() -> bool:
	if _local_pause_enabled or _ui_input_blocked or _debug_mode:
		return true
	if get_tree() != null and get_tree().paused:
		return true
	return false


func _clear_action_input_requests() -> void:
	_jump_requested = false
	_coyote_jump_requested = false
	_jump_dash_requested = false


func can_start_lightspeed_dash() -> bool:
	if not lightspeed_dash_enabled:
		return false
	if _lightspeed_dash_active:
		return false
	if _automation_lock_actions and _automation_locks_active():
		return false
	if _local_pause_enabled or _ui_input_blocked or _debug_mode:
		return false
	if race_in_countdown and not race_active:
		return false
	if _is_dead or _hurt_active:
		return false
	if _rail_active or _rail_switch_active or _spline_active:
		return false
	if _spring_align_timer > 0.0 or _spring_movement_lock_timer > 0.0 or _spring_action_lock_timer > 0.0:
		return false
	var forward_bias: Vector3 = _get_lightspeed_forward_bias()
	var target := _find_best_lightspeed_ring(global_position, lightspeed_dash_start_radius, forward_bias, null)
	return target != null


func queue_lightspeed_dash(_context: Dictionary = {}) -> bool:
	if not lightspeed_dash_enabled:
		return false
	return _try_start_lightspeed_dash()


func is_lightspeed_dash_active() -> bool:
	return _lightspeed_dash_active


func should_prioritize_spindash_over_bounce_stomp() -> bool:
	if _spindash_action != null and _spindash_action.is_charging:
		return true
	if _spindash_charging:
		return true
	return _can_claim_midair_spindash_from_current_input()


func _can_claim_midair_spindash_from_current_input() -> bool:
	if attached:
		return false
	if not spindash_enabled:
		return false
	if not Input.is_action_pressed("action_1"):
		return false
	if not Input.is_action_pressed("action_7"):
		return false
	if _spindash_roll_route_lockout_timer > 0.0:
		return false
	if _hurt_active:
		return false
	if _local_pause_enabled or _ui_input_blocked or _debug_mode:
		return false
	if _spline_active or _rail_active:
		return false
	if _automation_lock_actions and _automation_locks_active():
		return false
	if _spring_action_lock_timer > 0.0 or _spring_movement_lock_timer > 0.0:
		return false
	if _spring_align_timer > 0.0:
		return false
	if _homing_active:
		return false
	if _bounce_state != BounceState.NONE:
		return false
	var roll_ready: bool = false
	if _roll_action != null:
		roll_ready = _roll_action.is_rolling or _roll_action._can_start_roll()
	else:
		roll_ready = rolling or _can_start_roll()
	return roll_ready

func queue_bounce_attack() -> void:
	if not bounce_enabled:
		return
	if should_prioritize_spindash_over_bounce_stomp():
		return

	# Only start bounce in the air
	if attached:
		return

	# Already in a bounce/stomp sequence
	if _bounce_state != BounceState.NONE:
		return

	_bounce_state = BounceState.BOUNCE

	var world_up: Vector3 = Vector3.UP
	_trigger_anim_command(&"CMD_BOUNCE")
	_cancel_air_tumble_for_action(world_up)

	# >>> Use WORLD UP for bounce/stomp vertical, not last surface up <<<

	var v: Vector3 = velocity
	var vertical: float = v.dot(world_up)

	# One-shot downward impulse:
	# - If rising: invert + additive.
	# - If already falling: push further down.
	var new_vertical: float
	if vertical > 0.0:
		# Rising → force a fixed downward impulse
		new_vertical = -bounce_down_impulse
	else:
		# Falling → additive push downward
		new_vertical = vertical - bounce_down_impulse

	v += world_up * (new_vertical - vertical)
	velocity = v
	
	# SFX for bounce start
	_play_sfx(sfx_bounce_start)
	
	# Kill normal jump logic while in bounce
	_is_jumping = false
	_jump_hang_allowed = false
	_jump_time = 0.0


func queue_stomp_attack() -> void:
	if should_prioritize_spindash_over_bounce_stomp():
		return
	if attached:
		return
	if _bounce_state == BounceState.STOMP:
		return
	_bounce_state = BounceState.STOMP

	var world_up: Vector3 = Vector3.UP
	_trigger_anim_command(&"CMD_BOUNCE")
	_cancel_air_tumble_for_action(world_up)

	var v: Vector3 = velocity
	var vertical: float = v.dot(world_up)
	var new_vertical: float
	if vertical > 0.0:
		new_vertical = -stomp_down_impulse
	else:
		new_vertical = vertical - stomp_down_impulse
	v += world_up * (new_vertical - vertical)
	velocity = v
	_play_sfx(sfx_stomp_start)
	_is_jumping = false
	_jump_hang_allowed = false
	_jump_time = 0.0


# ===========================================================
# COMBAT
# ===========================================================
func is_attack_active() -> bool:
	return _attack_sources != 0


func is_hurt_active() -> bool:
	return _hurt_active


func is_hurt_invulnerable() -> bool:
	return _damage_hit_invuln_timer > 0.0 or _is_dead or _player_state_locked


func is_airborne() -> bool:
	return not attached


func get_combat_class() -> CombatClass:
	# Prefer explicit combat class declared on the active action node under Abilities.
	if _active_action != null and is_instance_valid(_active_action):
		if _active_action.has_method("get") and "combat_class" in _active_action:
			var declared: int = int(_active_action.get("combat_class"))
			if declared != CombatClass.NEUTRAL:
				return declared as CombatClass
	if not is_attack_active():
		return CombatClass.NEUTRAL
	var sources: int = _attack_sources
	if sources & (AttackSource.ROLL | AttackSource.SPINDASH | AttackSource.BOUNCE | AttackSource.AIR_UNCURL):
		return CombatClass.SCISSORS
	if sources & (AttackSource.JUMP | AttackSource.JUMP_DASH | AttackSource.HOMING):
		return CombatClass.ROCK
	if sources & (AttackSource.SPIN_KICK | AttackSource.MANUAL):
		return CombatClass.PAPER
	return CombatClass.NEUTRAL


static func resolve_combat(attacker: CombatClass, defender: CombatClass) -> CombatOutcome:
	if attacker == CombatClass.NEUTRAL:
		return CombatOutcome.LOSE
	if defender == CombatClass.NEUTRAL:
		return CombatOutcome.WIN
	if attacker == defender:
		return CombatOutcome.DRAW
	if attacker == CombatClass.ROCK and defender == CombatClass.SCISSORS:
		return CombatOutcome.WIN
	if attacker == CombatClass.PAPER and defender == CombatClass.ROCK:
		return CombatOutcome.WIN
	if attacker == CombatClass.SCISSORS and defender == CombatClass.PAPER:
		return CombatOutcome.WIN
	return CombatOutcome.LOSE


func _set_hurt_flash_visible(value: bool) -> void:
	if _hurt_flash_renderers.is_empty():
		_cache_hurt_flash_renderers()
	for renderer in _hurt_flash_renderers:
		if renderer == null:
			continue
		if not is_instance_valid(renderer):
			continue
		renderer.visible = value


func _cache_hurt_flash_renderers() -> void:
	_hurt_flash_renderers.clear()
	if model_root == null:
		return
	if not is_instance_valid(model_root):
		return
	_collect_hurt_flash_renderers(model_root)


func _collect_hurt_flash_renderers(node: Node) -> void:
	if node is GeometryInstance3D:
		_hurt_flash_renderers.append(node as GeometryInstance3D)
	for child in node.get_children():
		if child is Node:
			_collect_hurt_flash_renderers(child as Node)


func _update_hurt_invuln_visual(delta: float) -> void:
	if _hurt_action != null:
		_sync_hurt_state_to_action()
		_hurt_action.update_invuln_visual(delta)
		_sync_hurt_state_from_action()
		return

	_hurt_flash_accum = 0.0
	if not _hurt_flash_visible:
		_hurt_flash_visible = true
		_set_hurt_flash_visible(true)


func set_attack_active(active: bool) -> void:
	_set_attack_source(AttackSource.MANUAL, active)


func note_airborne_roll_uncurl_attack() -> void:
	if attached:
		return
	_set_attack_source(AttackSource.AIR_UNCURL, true)


func _set_attack_source(flag: int, active: bool) -> void:
	if active:
		_attack_sources |= flag
	else:
		_attack_sources &= ~flag


func _update_attack_sources() -> void:
	_set_attack_source(AttackSource.JUMP, _jumped_from_ground)
	_set_attack_source(AttackSource.ROLL, rolling)
	_set_attack_source(AttackSource.SPINDASH, _spindash_charging)
	_set_attack_source(AttackSource.JUMP_DASH, _jump_dash_recent_timer > 0.0)
	_set_attack_source(AttackSource.BOUNCE, _bounce_state != BounceState.NONE)
	_set_attack_source(AttackSource.HOMING, _homing_active or _homing_post_attack_timer > 0.0)
	_set_attack_source(AttackSource.LIGHTSPEED, _lightspeed_dash_active)
	_set_attack_source(AttackSource.ENEMY_CHAIN, _enemy_attack_chain_active and not attached)
	_set_attack_source(AttackSource.AIR_UNCURL, (_attack_sources & AttackSource.AIR_UNCURL) != 0 and not attached)


func apply_enemy_bounce(origin: Vector3, speed: float, source: Node = null) -> void:
	if _enemy_bounce_cooldown_timer > 0.0:
		return

	var was_homing_contact: bool = _homing_contact_matches_source(source)
	var up: Vector3 = _get_homing_contact_up()
	var homing_contact_velocity: Vector3 = velocity
	var homing_contact_lateral: Vector3 = homing_contact_velocity - up * homing_contact_velocity.dot(up)
	var dir: Vector3 = global_position - origin
	if dir.length() < 0.001:
		dir = -global_transform.basis.z
	dir = dir.normalized()

	var bounce_speed: float = max(speed, 0.0)
	if _homing_active or _homing_post_attack_timer > 0.0:
		bounce_speed *= max(homing_bounce_speed_fraction, 0.0)
	bounce_speed = max(bounce_speed, max(enemy_bounce_min_speed, 0.0))
	if not was_homing_contact:
		bounce_speed += _consume_attack_magnetism_bounce_compensation()
	velocity = dir * bounce_speed
	attached = false
	reset_trick_staleness()
	_attachment_immunity = launch_immunity_time
	_airborne_time = 0.0
	_jumped_from_ground = false
	_falling_without_jump = true
	_enemy_bounce_cooldown_timer = ENEMY_BOUNCE_COOLDOWN_SEC
	_tornado_kick_used_this_air = false
	if was_homing_contact:
		_complete_homing_from_enemy_contact(source, homing_contact_velocity, homing_contact_lateral, up, origin)
	_interrupt_skydive_for_enemy_bounce(&"enemy_bounce")
	reset_flight_eligibility()
	end_active_flight_for_external_impulse({"reason": &"enemy_bounce"})


func apply_enemy_attack_bounce(end_bounce_stomp: bool = false, source: Node = null) -> void:
	if _bounce_state == BounceState.STOMP:
		_on_trick_detected(TrickSystem.TrickType.STOMP_DAREHOG)

	var was_homing_contact: bool = _homing_contact_matches_source(source)
	var up: Vector3 = _get_homing_contact_up()

	var v: Vector3 = velocity
	var vertical: float = v.dot(up)
	var lateral: Vector3 = v - up * vertical
	var homing_contact_velocity: Vector3 = v
	var homing_contact_lateral: Vector3 = lateral

	if vertical >= 0.0:
		vertical = vertical + vertical * 0.5
	else:
		vertical = abs(vertical)

	if _homing_active or _homing_post_attack_timer > 0.0:
		vertical *= max(homing_bounce_speed_fraction, 0.0)
	vertical = max(vertical, max(enemy_bounce_min_speed, 0.0))
	if not was_homing_contact:
		vertical += _consume_attack_magnetism_bounce_compensation()

	velocity = lateral + up * vertical
	attached = false
	reset_trick_staleness()
	_attachment_immunity = launch_immunity_time
	_airborne_time = 0.0
	_jump_variable = false
	_jump_hang_allowed = false
	_jump_time = 0.0
	_is_jumping = false
	_enemy_attack_chain_active = true
	_tornado_kick_used_this_air = false
	if end_bounce_stomp and _bounce_state != BounceState.NONE:
		_bounce_state = BounceState.NONE
	if was_homing_contact:
		_complete_homing_from_enemy_contact(source, homing_contact_velocity, homing_contact_lateral, up, global_position)
	_interrupt_skydive_for_enemy_bounce(&"enemy_attack_bounce")
	reset_flight_eligibility()
	end_active_flight_for_external_impulse({"reason": &"enemy_attack_bounce"})


func _homing_contact_matches_source(source: Node) -> bool:
	if not _homing_active:
		return false
	if source == null or not is_instance_valid(source):
		return false
	if _homing_target == null or not is_instance_valid(_homing_target):
		return true
	if source == _homing_target:
		return true
	if source.is_ancestor_of(_homing_target):
		return true
	if _homing_target is Node and (_homing_target as Node).is_ancestor_of(source):
		return true
	return true


func _interrupt_skydive_for_enemy_bounce(reason: StringName) -> void:
	if _current_action_id != &"skydive":
		return
	_skydive_anim_phase = SKYDIVE_ANIM_NONE
	_skydive_anim_exit_timer = 0.0
	_force_neutral_air_action({"reason": reason, "source_action": &"skydive"})


func _get_homing_contact_up() -> Vector3:
	var up: Vector3 = _physics_up_last.normalized()
	if up.length() < 0.001:
		up = gravity_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP
	return up


func _get_homing_contact_direction(source: Node, fallback_velocity: Vector3, fallback_origin: Vector3) -> Vector3:
	var dir: Vector3 = Vector3.ZERO
	if _homing_target != null and is_instance_valid(_homing_target):
		dir = get_homing_attack_target_position() - global_position
	if dir.length() < 0.001 and source != null and is_instance_valid(source) and source is Node3D:
		dir = (source as Node3D).global_position - global_position
	if dir.length() < 0.001:
		dir = global_position - fallback_origin
	if dir.length() < 0.001:
		dir = fallback_velocity
	if dir.length() < 0.001:
		dir = -global_transform.basis.z
	if dir.length() < 0.001:
		dir = Vector3.FORWARD
	return dir.normalized()


func _get_homing_contact_pass_through(source: Node) -> bool:
	if source != null and is_instance_valid(source) and _object_has_property(source, "pass_through") and source.get("pass_through"):
		return true
	if _homing_target != null and is_instance_valid(_homing_target) and _object_has_property(_homing_target, "pass_through") and _homing_target.get("pass_through"):
		return true
	return false


func _get_homing_contact_pop_speed(source: Node) -> float:
	var pop_speed: float = homing_pop_up_speed
	if source != null and is_instance_valid(source) and _object_has_property(source, "pop_up_speed_override"):
		var source_override: Variant = source.get("pop_up_speed_override")
		if source_override is float and float(source_override) > 0.0:
			return float(source_override)
	if _homing_target != null and is_instance_valid(_homing_target) and _object_has_property(_homing_target, "pop_up_speed_override"):
		var target_override: Variant = _homing_target.get("pop_up_speed_override")
		if target_override is float and float(target_override) > 0.0:
			pop_speed = float(target_override)
	return pop_speed


func _complete_homing_from_enemy_contact(source: Node, contact_velocity: Vector3, contact_lateral: Vector3, up: Vector3, fallback_origin: Vector3) -> void:
	var jump_held: bool = _is_jump_held()
	var is_pass_through: bool = _get_homing_contact_pass_through(source)
	var bounce_compensation: float = _consume_attack_magnetism_bounce_compensation()
	if is_pass_through:
		var homing_dir: Vector3 = _get_homing_contact_direction(source, contact_velocity, fallback_origin)
		var homing_spd: float = max(homing_speed, _homing_saved_speed_mag)
		velocity = homing_dir * homing_spd
	else:
		var pop_speed: float = _get_homing_contact_pop_speed(source) + bounce_compensation
		var retained: Vector3 = Vector3.ZERO
		if homing_retain_speed_if_jump_held and jump_held:
			if contact_velocity.dot(up) < 0.0:
				retained = contact_lateral
			elif contact_velocity.length() > 0.001:
				retained = contact_velocity
			elif contact_lateral.length() > 0.001:
				retained = contact_lateral
			else:
				retained = _homing_saved_lateral
			_homing_retain_timer = max(homing_retain_disable_air_decel_time, 0.0)
		else:
			_homing_retain_timer = 0.0
		velocity = retained + up * pop_speed

	attached = false
	_homing_active = false
	_homing_target = null
	_homing_target_position = Vector3.ZERO
	_homing_target_position_valid = false
	_homing_saved_velocity = Vector3.ZERO
	_homing_saved_lateral = Vector3.ZERO
	_homing_saved_speed_mag = 0.0
	_homing_elapsed = 0.0
	_homing_post_attack_timer = max(homing_post_attack_time, 0.0)
	_jump_dash_used_this_air = false
	_tornado_kick_used_this_air = false


func apply_damage(_amount: int = 1, _source: Node = null) -> void:
	if _is_dead or _player_state_locked:
		return
	if _damage_hit_invuln_timer > 0.0:
		return
	_on_player_hurt()
	if _hurt_action != null:
		_sync_hurt_state_to_action()
		_hurt_action.apply_damage(_amount, _source)
		_sync_hurt_state_from_action()
		return
	if not _network_is_local_authority():
		return

	var up: Vector3 = _physics_up_last.normalized()
	if up.length() < 0.001:
		up = gravity_up.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	var hit_dir: Vector3 = Vector3.ZERO
	if _source != null and is_instance_valid(_source) and _source is Node3D:
		hit_dir = global_position - (_source as Node3D).global_position
	else:
		hit_dir = -global_transform.basis.z
	hit_dir -= up * hit_dir.dot(up)
	if hit_dir.length() < 0.001:
		hit_dir = -global_transform.basis.z
		hit_dir -= up * hit_dir.dot(up)
	if hit_dir.length() < 0.001:
		hit_dir = Vector3.FORWARD
	hit_dir = hit_dir.normalized()

	var v: Vector3 = velocity
	var vertical: float = v.dot(up)
	var lateral: Vector3 = v - up * vertical
	var speed: float = lateral.length()
	var hurt_speed_threshold: float = max(damage_trip_speed_threshold, 0.0)
	var moving_hurt: bool = speed >= hurt_speed_threshold

	if speed >= damage_trip_speed_threshold:
		lateral *= clamp(damage_trip_speed_multiplier, 0.0, 1.0)
	else:
		lateral = hit_dir * max(damage_pushback_speed, 0.0)
		if not moving_hurt and _source != null and is_instance_valid(_source) and _source is Node3D:
			var face_dir: Vector3 = (_source as Node3D).global_position - global_position
			face_dir -= up * face_dir.dot(up)
			if face_dir.length() > 0.001:
				face_dir = face_dir.normalized()
				var look_basis: Basis = Basis().looking_at(face_dir, up)
				if model_root != null and is_instance_valid(model_root):
					var mt: Transform3D = model_root.global_transform
					mt.basis = look_basis.orthonormalized()
					model_root.global_transform = mt
				else:
					var gt: Transform3D = global_transform
					gt.basis = look_basis.orthonormalized()
					global_transform = gt

	vertical = max(vertical, max(damage_launch_upward_speed, 0.0))

	velocity = lateral + up * vertical
	attached = false
	_attachment_immunity = launch_immunity_time
	_airborne_time = 0.0
	_jumped_from_ground = false
	_falling_without_jump = true
	_jump_variable = false
	_jump_hang_allowed = false
	_jump_time = 0.0
	_is_jumping = false

	if _homing_active or _homing_target != null:
		cancel_homing_attack(false)
	_stop_lightspeed_dash_if_active(false)
	_cancel_spindash_charge()
	_jump_dashing = false
	_jump_dash_requested = false
	_bounce_state = BounceState.NONE
	rolling = false

	if has_method("cancel_spline_spring"):
		call("cancel_spline_spring")
	if has_method("cancel_rail_grind"):
		call("cancel_rail_grind")

	_hurt_active = true
	_hurt_state_timer = 0.0
	_hurt_flash_accum = 0.0
	_hurt_flash_visible = true
	_set_hurt_flash_visible(true)
	_damage_hit_invuln_timer = max(damage_hit_invuln_time, 0.0)
	if moving_hurt:
		_trigger_anim_command(&"CMD_HURT_MOVING")
	else:
		_trigger_anim_command(&"CMD_HURT")


func apply_death_plane_damage(_source: Node = null) -> void:
	if _is_dead or _player_state_locked:
		return
	_on_player_hurt()
	if _hurt_action != null:
		_sync_hurt_state_to_action()
		_hurt_action.apply_death_plane_damage(_source)
		_sync_hurt_state_from_action()
		return
	set_death_state(true)


# ===========================================================
# ANIMATION
# ===========================================================

func _reset_trick_state() -> void:
	# SUMMARY: Clear transient trick timers to avoid cross-state bleed.
	_trick_retrigger_timer = 0.0
	if _trick_detector != null:
		_trick_detector.reset()
	if _trick_system != null:
		_trick_system.start_airborne_segment()

func _update_trick_detection(delta: float) -> void:
	if _trick_detector == null:
		return
	
	if _rail_active:
		_update_rail_tricks(delta)
		return

	if attached:
		return
	if _spring_align_timer > 0.0 or _spline_active or _rail_active:
		return
	if is_current_action_flight():
		return

	if model_root == null:
		push_warning("_update_trick_detection: model_root missing")
		return

	var current_time: float = Engine.get_process_frames() / 60.0
	var model_basis: Basis = model_root.global_transform.basis
	# push_warning("_update_trick_detection: calling detector with basis")
	_trick_detector.update_trick_detection(model_basis, current_time)

func _finalize_trick_landing() -> void:
	if _trick_system == null:
		push_warning("_finalize_trick_landing: trick system missing")
		return

	if not _trick_system.combo_system_enabled:
		_trick_system.end_airborne_segment()
		_stomp_landing_flag = false
		return

	var was_stomp: bool = _stomp_landing_flag
	_stomp_landing_flag = false
	
	var final_score: float = _trick_system.calculate_final_score()
	_trick_system.end_airborne_segment()
	
	push_warning("trick finalize score=%f" % final_score)
	
	if _barrier_blast_gauge >= 1.0:
		_barrier_blast_deplete_grace_timer = max(_barrier_blast_deplete_grace_timer, trick_finalize_full_gauge_grace_time)

	# Only add bonuses if there was an active combo with scoring tricks
	if final_score > 0.0 or (was_stomp and _trick_system.has_scoring_tricks()):
		var perfect_landing: bool = _is_perfect_landing()
		if was_stomp:
			perfect_landing = true
		
		if perfect_landing:
			final_score *= trick_perfect_landing_multiplier
			_trick_system.play_perfect_landing_sound()

		# Acceleration boost based on final score
		if final_score > 0.0:
			var threshold: float = max(_trick_system.landing_boost_score_threshold, 1.0)
			var max_mult: float = max(_trick_system.landing_boost_max_multiplier, 1.0)
			var boost_mult: float = 1.0 + (final_score / threshold) * (max_mult - 1.0)
			_trick_boost_multiplier = min(boost_mult, max_mult)
			_trick_boost_timer = _trick_system.landing_boost_duration

		_apply_trick_score(final_score, perfect_landing)
		play_landing_combo_voice(final_score)
		_update_score(int(final_score))

func _is_perfect_landing() -> bool:
	var up_dot: float = visual_up.dot(surface_normal.normalized())
	return up_dot > 0.95

func _apply_trick_score(score: float, perfect_landing: bool) -> void:
	var bb_bonus: float = score * (trick_score_to_bb_percent * 0.001)
	_barrier_blast_gauge = clamp(_barrier_blast_gauge + bb_bonus, 0.0, 1.0)

	if _barrier_blast_gauge >= 1.0:
		_barrier_blast_deplete_grace_timer = max(_barrier_blast_deplete_grace_timer, trick_finalize_full_gauge_grace_time)

	if _trick_ui != null:
		if not _trick_system.combo_system_enabled:
			_trick_ui.visible = false
			return
		var trick_list: String = _trick_system.get_trick_list_string()
		if perfect_landing:
			trick_list += " (Perfect Landing!)"
			_trick_ui.bounce_perfect()
		_trick_ui.update_trick_display(score, trick_list)

func _on_player_hurt() -> void:
	if _trick_system != null:
		# Only trigger if there was an active combo
		if not _trick_system.current_air_tricks.is_empty():
			if _trick_ui != null:
				_trick_ui.hurt_jitter()
			_trick_system.cancel_combo()

func set_death_state(dead: bool) -> void:
	_is_dead = dead
	if dead:
		_on_player_hurt()
	else:
		# If we were dead and are now being resurrected (e.g. race restart),
		# make sure we clear the input block if it was set by the death sequence.
		if _ui_input_blocked:
			set_ui_input_blocked(false)
		_player_state_locked = false

		# Ensure combo system is in a clean state
		if _trick_system != null:
			_trick_system.cancel_combo()
			_trick_system.reset_air_trick_staleness()

func reset_trick_staleness() -> void:
	if _trick_system != null:
		_trick_system.reset_air_trick_staleness()

func reset_score() -> void:
	score = 0

func _is_anim_in_trick_state() -> bool:
	# SUMMARY: True when the AnimationTree is in a trick state or command state.
	if anim_state == null:
		return false
	
	# If we are currently transitioning, anim_state.get_current_node() might return 
	# the 'from' node. Check if we have a travel path to a trick.
	var path = anim_state.get_travel_path()
	if not path.is_empty():
		for p in path:
			if str(p).begins_with("Trick_"):
				return true

	var current: StringName = anim_state.get_current_node()
	if str(current).begins_with("Trick_"):
		return true
	return false


func _get_trick_cmd_from_angular_velocity(omega_world: Vector3) -> StringName:
	# SUMMARY: Choose the trick command based on dominant torque axis.
	# NOTES:
	# - omega_world is in world space; convert to model space for pitch/yaw/roll.
	# - The model forward axis is -basis.z, consistent with _model_forward.
	# - Sign mapping uses right-hand rotation about local axes.
	var basis: Basis = global_transform.basis
	if model_root != null:
		basis = model_root.global_transform.basis
	basis = basis.orthonormalized()

	var right: Vector3 = basis.x
	if right.length() < 0.001:
		right = Vector3.RIGHT
	else:
		right = right.normalized()

	var up: Vector3 = basis.y
	if up.length() < 0.001:
		up = Vector3.UP
	else:
		up = up.normalized()

	var forward: Vector3 = -basis.z
	if forward.length() < 0.001:
		forward = _model_forward
	if forward.length() < 0.001:
		forward = -Vector3.FORWARD
	forward = forward.normalized()

	var pitch_rate: float = omega_world.dot(right)
	var yaw_rate: float = omega_world.dot(up)
	var roll_rate: float = omega_world.dot(forward)

	var abs_p: float = abs(pitch_rate)
	var abs_y: float = abs(yaw_rate)
	var abs_r: float = abs(roll_rate)

	var best_rate: float = pitch_rate
	var best_axis: int = 0 # 0=Pitch, 1=Yaw, 2=Roll

	# Diagonal detection for animation: if Pitch and Yaw are similar, use Roll animation.
	var is_diagonal_torque: bool = false
	var avg_rate: float = 0.0
	if abs_p > 0.1 and abs_y > 0.1:
		var diff: float = abs(abs_p - abs_y)
		avg_rate = (abs_p + abs_y) * 0.5
		if diff < avg_rate: # More same than different
			is_diagonal_torque = true

	if is_diagonal_torque:
		best_axis = 2
		# Use the sign of yaw_rate to determine roll direction for diagonal torque
		best_rate = avg_rate if yaw_rate > 0 else -avg_rate
	else:
		if abs_y > abs(best_rate):
			best_rate = yaw_rate
			best_axis = 1
		if abs_r > abs(best_rate):
			best_rate = roll_rate
			best_axis = 2

	var min_deg: float = max(trick_torque_min_speed_deg, 0.0)
	if min_deg > 0.0:
		var min_rad: float = deg_to_rad(min_deg)
		if abs(best_rate) < min_rad:
			return &""
	else:
		if abs(best_rate) <= 0.0001:
			return &""

	var cmd: StringName = &""
	if best_axis == 0:
		# Pitch: positive = pitch back, negative = pitch forward.
		if best_rate < 0.0:
		#	cmd = &"CMD_TRICK_PITCH_FORWARD"
			cmd = &"Trick_Pitch_Forward"
		else:
		#	cmd = &"CMD_TRICK_PITCH_BACK"
			cmd = &"Trick_Pitch_Back"
	elif best_axis == 1:
		# Yaw: positive = yaw left, negative = yaw right (forward is -Z).
		if best_rate < 0.0:
		#	cmd = &"CMD_TRICK_YAW_RIGHT"
			cmd = &"Trick_Yaw_Right"
		else:
		#	cmd = &"CMD_TRICK_YAW_LEFT"
			cmd = &"Trick_Yaw_Left"
	else:
		# Roll: positive = roll right, negative = roll left (forward is -Z).
		if best_rate < 0.0:
		#	cmd = &"CMD_TRICK_ROLL_LEFT"
			cmd = &"Trick_Roll_Left"
		else:
		#	cmd = &"CMD_TRICK_ROLL_RIGHT"
			cmd = &"Trick_Roll_Right"

	return cmd


func _update_air_trick_animation() -> void:
	# SUMMARY: Trigger trick animations from airborne torque when rotation is fast enough.
	# NOTES:
	# - Only runs on local authority to avoid double-net triggers.
	# - Blocks while in other forced alignment states (rails/splines/springs).
	if not _network_is_local_authority():
		return
	if anim_state == null:
		return
	if _pending_anim_command != &"":
		return
	if attached:
		return
	if _spring_align_timer > 0.0 or _spline_active or _rail_active or _rail_switch_active or _bounce_state != BounceState.NONE:
		return
	if is_current_action_flight():
		return
	if _homing_active:
		return
	
	var tricks_allowed: bool = trick_animations_enabled
	if _manual_airborne_torque_active and manual_airborne_torque_tricks_enabled:
		tricks_allowed = true
		
	if not tricks_allowed:
		return
	if not airborne_torque_enabled:
		return
	if not _air_torque_segment_allowed:
		return
	if _trick_retrigger_timer > 0.0:
		return
	var omega_world: Vector3 = _air_torque_angular_velocity
	if omega_world.length() < 0.0001:
		return

	var cmd: StringName = _get_trick_cmd_from_angular_velocity(omega_world)
	if cmd == &"":
		return

	# Allow interruption of an existing trick if the new command is different.
	# If it's the same trick, we skip to avoid jittering the animation loop.
	if _is_anim_in_trick_state() and anim_state.get_current_node() == cmd:
		return

	_trigger_anim_command(cmd, true, trick_anim_crossfade)

	var delay: float = max(trick_retrigger_delay, 0.0)
	if delay > 0.0:
		_trick_retrigger_timer = delay

func _get_lateral_speed_for_anim() -> float:
	# Single canonical definition of "movement speed" for animation.
	# Uses the last physics-up to strip vertical component and return
	# ground/loop lateral speed in units/sec.
	var up := _physics_up_last.normalized()
	if up.length() < 0.001:
		up = Vector3.UP

	var v := velocity
	var vertical := v.dot(up)
	var lateral := v - up * vertical
	return lateral.length()

func _update_animation(delta: float) -> void:
	_ensure_modules()
	if _anim_module != null:
		_anim_module._update_animation(delta)
	_apply_anim_command()
	_update_carry_animation(delta)
	_update_pending_carry_put_down_release()
	_update_pending_carry_throw_release()
	_update_carry_command_animation_exit()

func _trigger_anim_command(cmd: StringName, send_net: bool = true, crossfade: float = -1.0) -> void:
	var allow := true
	if cmd != &"CMD_SPRING" and _pending_anim_command == &"CMD_SPRING":
		allow = false
	if not allow:
		return
	_pending_anim_command = cmd
	_pending_anim_crossfade = crossfade
	if send_net and _network_is_active() and network_replication_enabled and is_multiplayer_authority():
		rpc("_net_anim_command", cmd)


func play_action_command_if_exists(action_name: StringName, send_net: bool = true) -> bool:
	if action_name == &"":
		return false
	var cmd: StringName = StringName("CMD_%s" % String(action_name).to_upper())
	if anim_tree == null:
		return false
	var root = anim_tree.tree_root
	if root is AnimationNodeStateMachine:
		var sm: AnimationNodeStateMachine = root
		if sm.has_node(cmd):
			_trigger_anim_command(cmd, send_net)
			return true
	elif root is AnimationNodeBlendTree:
		var bt: AnimationNodeBlendTree = root
		var sm_node_name: String = PlayerAnimation.SM_BASE.replace("parameters/", "")
		if bt.has_node(sm_node_name):
			var nested_sm: AnimationNodeStateMachine = bt.get_node(sm_node_name) as AnimationNodeStateMachine
			if nested_sm != null and nested_sm.has_node(cmd):
				_trigger_anim_command(cmd, send_net)
				return true
	if not _missing_anim_command_logged.has(cmd):
		_missing_anim_command_logged[cmd] = true
		push_warning("Missing AnimationTree state '%s'" % String(cmd))
	return false


func request_skydive_animation_state(state_name: StringName) -> void:
	if state_name == &"Skydive_Enter" or state_name == &"Skydive_Dive" or state_name == &"Skydive_Glide_To_Dive":
		_skydive_anim_phase = SKYDIVE_ANIM_DIVE
		_skydive_anim_exit_timer = 0.0
	elif state_name == &"Skydive_Dive_To_Glide" or state_name == &"Skydive_Glide":
		_skydive_anim_phase = SKYDIVE_ANIM_GLIDE
		_skydive_anim_exit_timer = 0.0
	elif state_name == &"Skydive_Cancel":
		_skydive_anim_phase = SKYDIVE_ANIM_CANCEL
		_skydive_anim_exit_timer = 2.0
	elif state_name == &"Skydive_Exit":
		_skydive_anim_phase = SKYDIVE_ANIM_EXIT
		_skydive_anim_exit_timer = 2.0


func _is_skydive_anim_active() -> bool:
	return _current_action_id == &"skydive" or not _is_skydive_anim_finished()


func _is_skydive_anim_diving() -> bool:
	return _current_action_id == &"skydive" and _skydive_anim_phase == SKYDIVE_ANIM_DIVE


func _is_skydive_anim_gliding() -> bool:
	return _current_action_id == &"skydive" and _skydive_anim_phase == SKYDIVE_ANIM_GLIDE


func _is_skydive_anim_canceling() -> bool:
	return _skydive_anim_phase == SKYDIVE_ANIM_CANCEL and not _is_skydive_terminal_complete(&"Skydive_Cancel")


func _is_skydive_anim_exiting() -> bool:
	return _skydive_anim_phase == SKYDIVE_ANIM_EXIT and not _is_skydive_terminal_complete(&"Skydive_Exit")


func _is_skydive_anim_cancel_complete() -> bool:
	return _skydive_anim_phase == SKYDIVE_ANIM_CANCEL and _is_skydive_terminal_complete(&"Skydive_Cancel")


func _is_skydive_anim_exit_complete() -> bool:
	return _skydive_anim_phase == SKYDIVE_ANIM_EXIT and _is_skydive_terminal_complete(&"Skydive_Exit")


func _is_skydive_anim_finished() -> bool:
	if _skydive_anim_phase == SKYDIVE_ANIM_NONE:
		return true
	if _skydive_anim_phase == SKYDIVE_ANIM_CANCEL:
		return _is_skydive_terminal_complete(&"Skydive_Cancel")
	if _skydive_anim_phase == SKYDIVE_ANIM_EXIT:
		return _is_skydive_terminal_complete(&"Skydive_Exit")
	return false


func _is_skydive_terminal_complete(state_name: StringName) -> bool:
	if _current_action_id == &"skydive":
		return false
	if anim_tree == null:
		return _skydive_anim_exit_timer <= 0.0
	var skydive_state: AnimationNodeStateMachinePlayback = anim_tree.get("parameters/StateMachine/SKYDIVE_MACHINE/playback") as AnimationNodeStateMachinePlayback
	if skydive_state == null:
		return _skydive_anim_exit_timer <= 0.0
	var current_node: StringName = skydive_state.get_current_node()
	if current_node == &"End":
		return true
	if current_node != state_name:
		return false
	var length: float = skydive_state.get_current_length()
	if length <= 0.001:
		return _skydive_anim_exit_timer <= 0.0
	return skydive_state.get_current_play_position() >= length - 0.02


func _apply_anim_command() -> void:
	if _pending_anim_command == &"":
		return
	if anim_state == null:
		return
	
	var cmd := _pending_anim_command
	var xfade := _pending_anim_crossfade
	
	if cmd == &"CMD_SPRING" and anim_state.has_method("start"):
		anim_state.start(cmd)
	else:
		if xfade >= 0.0:
			# In Godot 4 State Machines, crossfade time is a property of the Transition resource.
			# We must find the actual StateMachine resource to modify its transitions.
			var sm: AnimationNodeStateMachine = null
			if anim_tree.tree_root is AnimationNodeStateMachine:
				sm = anim_tree.tree_root
			elif anim_tree.tree_root is AnimationNodeBlendTree:
				var bt = anim_tree.tree_root as AnimationNodeBlendTree
				# Use the node name from SM_BASE (typically "StateMachine")
				var sm_node_name = PlayerAnimation.SM_BASE.replace("parameters/", "")
				if bt.has_node(sm_node_name):
					sm = bt.get_node(sm_node_name) as AnimationNodeStateMachine
			
			if sm != null:
				var from = anim_state.get_current_node()
				var found_transition := false
				
				# Update existing transitions leading to the target command.
				for i in sm.get_transition_count():
					if sm.get_transition_to(i) == cmd:
						if from == &"" or sm.get_transition_from(i) == from:
							var trans = sm.get_transition(i)
							if trans:
								trans.xfade_time = xfade
								found_transition = true
				
				# If no transition exists, travel() will snap immediately.
				# We can try to add a temporary one from the current state if it's missing.
				if not found_transition and from != &"" and from != cmd:
					var new_trans = AnimationNodeStateMachineTransition.new()
					new_trans.xfade_time = xfade
					new_trans.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_IMMEDIATE
					new_trans.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_ENABLED
					sm.add_transition(from, cmd, new_trans)
		
		anim_state.travel(cmd)
	
	_pending_anim_command = &""
	_pending_anim_crossfade = -1.0
	

func _update_carry_animation(delta: float) -> void:
	if carry_hold_blend_parameter == "":
		return
	_update_carry_overlay_state()
	var target_blend: float = 0.0
	if _has_carried_object() and not _carry_throw_pending_release:
		target_blend = 1.0
	var blend_speed: float = max(carry_hold_blend_speed, 0.0)
	if blend_speed <= 0.0 or delta <= 0.0:
		_carry_hold_blend_value = target_blend
	else:
		_carry_hold_blend_value = move_toward(_carry_hold_blend_value, target_blend, blend_speed * delta)
	_safe_set_anim_param(carry_hold_blend_parameter, _carry_hold_blend_value)


func _force_carry_overlay_blend_visible() -> void:
	_carry_hold_blend_value = 1.0
	if carry_hold_blend_parameter != "":
		_safe_set_anim_param(carry_hold_blend_parameter, _carry_hold_blend_value)


func _request_carry_pickup_animation() -> void:
	_carry_pickup_pending_overlay = carry_pickup_overlay_state != &""
	_carry_pickup_overlay_started = false
	_force_carry_overlay_blend_visible()
	if _play_carry_overlay_state(carry_pickup_overlay_state):
		_carry_pickup_overlay_started = true
		return
	if carry_pickup_request_parameter != "":
		_request_anim_oneshot(carry_pickup_request_parameter)
	if carry_pickup_anim_command != &"":
		_trigger_anim_command(carry_pickup_anim_command)


func _initialize_carry_overlay_animation() -> void:
	_carry_hold_blend_value = 0.0
	if anim_tree != null and carry_hold_blend_parameter != "" and _anim_param_exists(carry_hold_blend_parameter):
		anim_tree.set(carry_hold_blend_parameter, 0.0)
	if _carry_overlay_state != null and carry_hold_overlay_state != &"":
		if _carry_overlay_state.has_method("start"):
			_carry_overlay_state.start(carry_hold_overlay_state)
		else:
			_carry_overlay_state.travel(carry_hold_overlay_state)


func _update_carry_overlay_state() -> void:
	if _carry_overlay_state == null:
		return
	if not _has_carried_object() or _carry_throw_pending_release:
		return
	if _carry_put_down_pending_release:
		var put_down_node: StringName = _carry_overlay_state.get_current_node()
		if put_down_node != carry_put_down_overlay_state:
			_play_carry_overlay_state(carry_put_down_overlay_state)
		return
	var current_node: StringName = _carry_overlay_state.get_current_node()
	if _carry_pickup_pending_overlay:
		if current_node != carry_pickup_overlay_state:
			if _play_carry_overlay_state(carry_pickup_overlay_state):
				_carry_pickup_overlay_started = true
			return
		_carry_pickup_overlay_started = true
		if _is_anim_playback_finished(_carry_overlay_state, carry_command_exit_time_margin):
			_carry_pickup_pending_overlay = false
			_carry_pickup_overlay_started = false
			_play_carry_overlay_state(carry_hold_overlay_state)
		return
	if current_node == carry_pickup_overlay_state:
		if _is_anim_playback_finished(_carry_overlay_state, carry_command_exit_time_margin):
			_play_carry_overlay_state(carry_hold_overlay_state)
		return
	if current_node != carry_hold_overlay_state:
		_play_carry_overlay_state(carry_hold_overlay_state)


func _play_carry_overlay_state(state_name: StringName) -> bool:
	if state_name == &"":
		return false
	if _carry_overlay_state == null:
		return false
	if _carry_overlay_state.has_method("start"):
		_carry_overlay_state.start(state_name)
	else:
		_carry_overlay_state.travel(state_name)
	return true


func _configure_carry_overlay_filter() -> void:
	if anim_tree == null:
		return
	if carry_hold_blend_parameter == "":
		return
	var root = anim_tree.tree_root
	if not (root is AnimationNodeBlendTree):
		return
	var blend_tree: AnimationNodeBlendTree = root
	var overlay_node_name: StringName = _get_blend_tree_node_name_from_parameter(carry_hold_blend_parameter)
	if overlay_node_name == &"":
		return
	if not blend_tree.has_node(overlay_node_name):
		return
	var overlay_node: AnimationNode = blend_tree.get_node(overlay_node_name)
	if overlay_node == null:
		return
	overlay_node.set("filter_enabled", true)
	for bone_name: StringName in carry_overlay_filter_bones:
		if bone_name == &"":
			continue
		var filter_path: NodePath = NodePath("%s:%s" % [String(carry_overlay_skeleton_filter_path), String(bone_name)])
		overlay_node.set_filter_path(filter_path, true)


func _get_blend_tree_node_name_from_parameter(parameter_path: String) -> StringName:
	var node_path: String = parameter_path
	var parameters_prefix: String = "parameters/"
	if node_path.begins_with(parameters_prefix):
		node_path = node_path.substr(parameters_prefix.length())
	var slash_index: int = node_path.find("/")
	if slash_index >= 0:
		node_path = node_path.substr(0, slash_index)
	return StringName(node_path)


func is_carry_animation_locked() -> bool:
	if _carry_put_down_pending_release:
		return true
	if _carry_throw_pending_release:
		return true
	if anim_state == null:
		return false
	var current_node: StringName = anim_state.get_current_node()
	if carry_throw_anim_command != &"" and current_node == carry_throw_anim_command:
		return true
	if carry_pickup_anim_command != &"" and current_node == carry_pickup_anim_command:
		return true
	if carry_put_down_anim_command != &"" and current_node == carry_put_down_anim_command:
		return true
	return false


func _request_anim_oneshot(parameter_path: String) -> void:
	if parameter_path == "":
		return
	if anim_tree == null:
		return
	var path: String = parameter_path
	if not path.begins_with("parameters/"):
		path = "parameters/" + path
	if _anim_param_exists(path):
		anim_tree.set(path, AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE)


func _update_pending_carry_put_down_release() -> void:
	if not _carry_put_down_pending_release:
		return
	if carry_put_down_overlay_state != &"" and _carry_overlay_state != null:
		var overlay_node: StringName = _carry_overlay_state.get_current_node()
		if overlay_node == carry_put_down_overlay_state:
			_carry_put_down_anim_started = true
			_carry_put_down_release_wait_frames = 0
			if _is_anim_playback_finished(_carry_overlay_state, carry_command_exit_time_margin):
				release_carried_object_from_put_down_animation()
			return
		if not _carry_put_down_anim_started:
			if _carry_put_down_release_wait_frames > 0:
				_carry_put_down_release_wait_frames -= 1
				return
			release_carried_object_from_put_down_animation()
			return
		release_carried_object_from_put_down_animation()
		return
	if carry_put_down_anim_command == &"":
		release_carried_object_from_put_down_animation()
		return
	if anim_state == null:
		release_carried_object_from_put_down_animation()
		return
	var current_node: StringName = anim_state.get_current_node()
	if current_node == carry_put_down_anim_command:
		_carry_put_down_anim_started = true
		_carry_put_down_release_wait_frames = 0
		return
	if not _carry_put_down_anim_started and _is_anim_traveling_to(carry_put_down_anim_command):
		_carry_put_down_release_wait_frames = 0
		return
	if _carry_put_down_release_wait_frames > 0:
		_carry_put_down_release_wait_frames -= 1
		return
	if _carry_put_down_anim_started:
		release_carried_object_from_put_down_animation()
		return
	release_carried_object_from_put_down_animation()


func _update_pending_carry_throw_release() -> void:
	if not _carry_throw_pending_release:
		return
	if carry_throw_anim_command == &"":
		release_carried_object_from_throw_animation()
		return
	if anim_state == null:
		release_carried_object_from_throw_animation()
		return
	var current_node: StringName = anim_state.get_current_node()
	if current_node == carry_throw_anim_command:
		_carry_throw_anim_started = true
		_carry_throw_release_wait_frames = 0
		return
	if not _carry_throw_anim_started and _is_anim_traveling_to(carry_throw_anim_command):
		_carry_throw_release_wait_frames = 0
		return
	if _carry_throw_release_wait_frames > 0:
		_carry_throw_release_wait_frames -= 1
		return
	if _carry_throw_anim_started:
		release_carried_object_from_throw_animation()
		return
	release_carried_object_from_throw_animation()


func _update_carry_command_animation_exit() -> void:
	if anim_state == null:
		return
	var current_node: StringName = anim_state.get_current_node()
	var should_return: bool = false
	if carry_throw_anim_command != &"" and current_node == carry_throw_anim_command:
		if _is_current_anim_state_finished(carry_command_exit_time_margin):
			if _carry_throw_pending_release:
				release_carried_object_from_throw_animation()
			should_return = true
	elif carry_pickup_anim_command != &"" and current_node == carry_pickup_anim_command:
		should_return = _is_current_anim_state_finished(carry_command_exit_time_margin)
	elif carry_put_down_anim_command != &"" and current_node == carry_put_down_anim_command:
		if _is_current_anim_state_finished(carry_command_exit_time_margin):
			if _carry_put_down_pending_release:
				release_carried_object_from_put_down_animation()
			should_return = true
	if should_return:
		var return_crossfade: float = 0.0
		if carry_throw_anim_command != &"" and current_node == carry_throw_anim_command:
			return_crossfade = carry_throw_return_crossfade
		_travel_to_carry_animation_return_state(return_crossfade)


func _is_current_anim_state_finished(exit_margin: float) -> bool:
	if anim_state == null:
		return false
	return _is_anim_playback_finished(anim_state, exit_margin)


func _is_anim_playback_finished(playback: AnimationNodeStateMachinePlayback, exit_margin: float) -> bool:
	if playback == null:
		return false
	var length: float = playback.get_current_length()
	if length <= 0.001:
		return false
	var play_position: float = playback.get_current_play_position()
	return play_position >= length - max(exit_margin, 0.0)


func _travel_to_carry_animation_return_state(crossfade: float = 0.0) -> void:
	if anim_state == null:
		return
	var return_state: StringName = _get_respawn_animation_start_node()
	if return_state == &"":
		return
	if anim_state.get_current_node() == return_state:
		return
	_travel_anim_state_with_crossfade(return_state, crossfade)


func _travel_anim_state_with_crossfade(target_state: StringName, crossfade: float) -> void:
	if anim_state == null:
		return
	if crossfade <= 0.0:
		anim_state.travel(target_state)
		return
	var sm: AnimationNodeStateMachine = _get_main_animation_state_machine()
	if sm == null:
		anim_state.travel(target_state)
		return
	var current_state: StringName = anim_state.get_current_node()
	var found_transition: bool = false
	for i in sm.get_transition_count():
		if sm.get_transition_to(i) != target_state:
			continue
		if current_state != &"" and sm.get_transition_from(i) != current_state:
			continue
		var transition: AnimationNodeStateMachineTransition = sm.get_transition(i)
		if transition:
			transition.xfade_time = max(crossfade, 0.0)
			found_transition = true
	if not found_transition and current_state != &"" and current_state != target_state:
		var new_transition: AnimationNodeStateMachineTransition = AnimationNodeStateMachineTransition.new()
		new_transition.xfade_time = max(crossfade, 0.0)
		new_transition.switch_mode = AnimationNodeStateMachineTransition.SWITCH_MODE_IMMEDIATE
		new_transition.advance_mode = AnimationNodeStateMachineTransition.ADVANCE_MODE_ENABLED
		sm.add_transition(current_state, target_state, new_transition)
	anim_state.travel(target_state)


func _clear_pending_carry_throw() -> void:
	_carry_pickup_pending_overlay = false
	_carry_pickup_overlay_started = false
	_carry_throw_pending_release = false
	_carry_throw_anim_started = false
	_carry_throw_release_wait_frames = 0
	_carry_throw_release_transform = Transform3D.IDENTITY
	_carry_throw_release_velocity = Vector3.ZERO


func _is_anim_traveling_to(state_name: StringName) -> bool:
	if anim_state == null:
		return false
	var travel_path = anim_state.get_travel_path()
	for path_node in travel_path:
		if StringName(path_node) == state_name:
			return true
	return false


func _safe_set_anim_param(path: String, value) -> void:
	_ensure_modules()
	if _anim_module != null:
		_anim_module._safe_set_anim_param(path, value)


func _update_locomotion_anim(delta: float) -> void:
	_ensure_modules()
	if _anim_module != null:
		_anim_module._update_locomotion_anim(delta)

func _get_turn_amount_for_anim() -> float:
	_ensure_modules()
	if _anim_module != null:
		return _anim_module._get_turn_amount_for_anim()
	return 0.0

func _set_anim_bool_param(rel_path: String, value: bool) -> void:
	_ensure_modules()
	if _anim_module != null:
		_anim_module._set_anim_bool_param(rel_path, value)

