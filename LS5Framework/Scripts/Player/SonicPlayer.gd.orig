	_drift_back_input_current = _drift_action.back_input_current
	_drift_same_input_current = _drift_action.same_input_current
	_drift_turn_entry_timer = _drift_action.turn_entry_timer
	_drift_exit_turn_deg_per_sec_current = _drift_action.exit_turn_deg_per_sec_current
	_drift_exit_turn_deg_per_sec_start = _drift_action.exit_turn_deg_per_sec_start
	_drift_exit_elapsed = _drift_action.exit_elapsed
	_drift_exit_blend = _drift_action.exit_blend
