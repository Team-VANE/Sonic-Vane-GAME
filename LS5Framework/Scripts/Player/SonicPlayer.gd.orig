func _sync_roll_state_from_action() -> void:
	if _roll_action == null:
		rolling = false
		return
	rolling = _roll_action.is_rolling

func _sync_spindash_state_from_action() -> void:
	if _spindash_action == null:
		return
	_spindash_charging = _spindash_action.is_charging
	_spindash_charge_time = _spindash_action.charge_time
	_spindash_charge_full_played = _spindash_action.charge_full_played
	_spindash_release_requested = _spindash_action.release_requested
	_spindash_release_with_jump = _spindash_action.release_with_jump
	_spindash_release_speed = _spindash_action.release_speed
	_spindash_pending_release = _spindash_action.pending_release
	_spindash_pending_release_speed = _spindash_action.pending_release_speed
	_spindash_turn_free_timer = max(_spindash_turn_free_timer, _spindash_action.turn_free_timer)
	_spindash_action.turn_free_timer = _spindash_turn_free_timer
	_spindash_entry_speed = _spindash_action.entry_speed
	_spindash_ground_hold_timer = _spindash_action.ground_hold_timer
	_spindash_roll_held = _spindash_action.roll_held

func _sync_spindash_state_to_action() -> void:
	if _spindash_action == null:
		return
	_spindash_action.is_charging = _spindash_charging
	_spindash_action.charge_time = _spindash_charge_time
	_spindash_action.charge_full_played = _spindash_charge_full_played
	_spindash_action.release_requested = _spindash_release_requested
	_spindash_action.release_with_jump = _spindash_release_with_jump
	_spindash_action.release_speed = _spindash_release_speed
	_spindash_action.pending_release = _spindash_pending_release
	_spindash_action.pending_release_speed = _spindash_pending_release_speed
	_spindash_action.turn_free_timer = _spindash_turn_free_timer
	_spindash_action.entry_speed = _spindash_entry_speed
	_spindash_action.ground_hold_timer = _spindash_ground_hold_timer
	_spindash_action.roll_held = _spindash_roll_held

func _sync_drift_state_from_action() -> void:
	if _drift_action == null:
		return
	_drift_active = _drift_action.is_active
	_drift_exit_active = _drift_action.exit_active
	_drift_exit_pending = _drift_action.exit_pending
	_drift_exit_locked = _drift_action.exit_locked
	_drift_turn_deg_per_sec_current = _drift_action.turn_deg_per_sec_current
