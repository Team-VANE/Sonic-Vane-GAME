	_drift_reward_progress = _drift_action.drift_reward_progress
	_drift_speed_bonus_current = _drift_action.drift_speed_bonus_current
	if abs(_drift_turn_speed_last) <= 0.0001:
		_drift_turn_speed_memory_timer = 0.0

