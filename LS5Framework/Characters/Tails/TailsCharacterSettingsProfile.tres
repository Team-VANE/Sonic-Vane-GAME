profile_version = 7
selection_category = "Work In Progress"
ability_catalog = Array[Dictionary]([{
"ability_id": &"uppercut_kick",
"description": "Press Spin Kick and Jump together to trade horizontal speed for an upward kick. Ground launch is stronger; the air use refreshes on landing or bounce.",
"display_name": "Uppercut Kick",
"supported_gestures": Array[StringName]([&"press"])
}, {
"ability_id": &"insta_shield",
"description": "Press and hold the Dive and Parkour inputs together to parry, block, and brake momentum.",
"display_name": "Insta-Shield",
"supported_gestures": Array[StringName]([&"press"])
}, {
"ability_id": &"parkour",
"description": "Hold to run or slide along walls. Press Jump to kick away while preserving momentum.",
"display_name": "Parkour",
"supported_gestures": Array[StringName]([&"press"])
}, {
"ability_id": &"jump",
"description": "Jump from the ground and use Tails' jump chain in the air.",
"display_name": "Jump",
"supported_gestures": Array[StringName]([&"press"])
}, {
"ability_id": &"propeller_flight",
"description": "Begin and maintain Propeller Flight while airborne.",
"display_name": "Propeller Flight",
"supported_gestures": Array[StringName]([&"press"])
}, {
"ability_id": &"skydive",
"description": "Dive while held and transition into a glide on release.",
"display_name": "Dive",
"supported_gestures": Array[StringName]([&"press", &"hold"])
}, {
"ability_id": &"stomp",
"description": "Drop rapidly toward the ground.",
"display_name": "Stomp",
"supported_gestures": Array[StringName]([&"release", &"tap", &"press"])
}, {
"ability_id": &"spin_kick",
"description": "Perform Spin Kick on the ground or Tornado Kick in the air.",
"display_name": "Spin Kick",
"supported_gestures": Array[StringName]([&"tap", &"press"])
}, {
"ability_id": &"spindash",
"description": "Charge a Spindash until the assigned slot is released.",
"display_name": "Spindash",
"supported_gestures": Array[StringName]([&"hold", &"press"])
}, {
"ability_id": &"roll",
"description": "Enter or maintain Tails' rolling state.",
"display_name": "Roll",
"supported_gestures": Array[StringName]([&"press"])
}, {
"ability_id": &"drift",
"description": "Enter a drift while the assigned slot is held.",
"display_name": "Drift",
"supported_gestures": Array[StringName]([&"press"])
}])
