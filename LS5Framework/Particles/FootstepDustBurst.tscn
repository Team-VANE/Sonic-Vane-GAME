[sub_resource type="Shader" id="Shader_dust"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, unshaded, shadows_disabled;

uniform sampler2D edge_texture : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D noise_texture : filter_linear_mipmap, repeat_enable;
uniform vec4 dust_tint : source_color = vec4(0.82, 0.76, 0.64, 0.58);
uniform float noise_scale = 2.35;
uniform float noise_strength = 0.42;
uniform vec2 noise_velocity = vec2(0.18, -0.11);

void vertex() {
	vec3 scale = vec3(length(MODEL_MATRIX[0].xyz), length(MODEL_MATRIX[1].xyz), length(MODEL_MATRIX[2].xyz));
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
		vec4(INV_VIEW_MATRIX[0].xyz * scale.x, 0.0),
		vec4(INV_VIEW_MATRIX[1].xyz * scale.y, 0.0),
		vec4(INV_VIEW_MATRIX[2].xyz * scale.z, 0.0),
		MODEL_MATRIX[3]
	);
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
}

void fragment() {
	vec4 edge = texture(edge_texture, UV);
	vec2 noise_uv_a = UV * noise_scale + TIME * noise_velocity;
	vec2 noise_uv_b = UV * (noise_scale * 1.85) - TIME * noise_velocity.yx * 0.7;
	float noise_a = texture(noise_texture, noise_uv_a).r;
	float noise_b = texture(noise_texture, noise_uv_b).r;
	float noise_mix = mix(noise_a, noise_b, 0.45);
	float body = mix(1.0 - noise_strength, 1.0, noise_mix);
	ALBEDO = edge.rgb * dust_tint.rgb * body * COLOR.rgb;
	ALPHA = edge.a * dust_tint.a * COLOR.a * body;
}"

