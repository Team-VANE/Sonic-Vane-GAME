[sub_resource type="Resource" id="Resource_frg01"]
script = ExtResource("1_lcxsh")
type = "frustum"
bindings = {
"color": "frustum_color",
"far": "far_plane",
"fov": "fov",
"near": "near_plane"
}

[sub_resource type="Resource" id="Resource_frp01"]
script = ExtResource("2_w65yt")
name = "fov"
type = "float"
