[sub_resource type="Resource" id="Resource_cng01"]
script = ExtResource("1_hnery")
type = "cone"
style = "solid"
alpha = "0.15"
bindings = {
"angle": "cone_angle",
"color": "cone_color",
"length": "cone_length"
}

[sub_resource type="Resource" id="Resource_cnp01"]
