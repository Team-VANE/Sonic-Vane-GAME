; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="LS5Engine3"
run/main_scene="res://LS5Framework/Scenes/MainMenu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://dldaeeorfxp8e"

[autoload]

DebugDraw3d="*res://LS5Framework/Scripts/Debug/DebugDraw3d.gd"
Settings="*res://LS5Framework/Scripts/Settings/Settings.gd"
SettingsManager="*res://LS5Framework/Scripts/Settings/SettingsManager.gd"
NetworkManager="*res://LS5Framework/Scripts/Net/NetworkManager.gd"
HomingTargetManager="*res://LS5Framework/Scripts/Managers/HomingTargetManager.gd"
EnvironmentWeatherState="*res://LS5Framework/Scripts/Managers/EnvironmentWeatherState.gd"
LevelPreparationManager="*res://LS5Framework/Scripts/Managers/LevelPreparationManager.gd"
NetworkTime="*uid://cnqdxyjptkfvp"
NetworkTimeSynchronizer="*uid://5rmn2ik3kjo8"
NetworkRollback="*uid://gas743comroj"
NetworkEvents="*uid://bdmobxxptryj0"
NetworkPerformance="*uid://cqgf7aqmjfoa3"
Noray="*uid://gu4bv4tgms3x"
PacketHandshake="*uid://tt3j25a05n7c"
CharacterProfileManager="*res://LS5Framework/Scripts/Settings/CharacterProfileManager.gd"
EmoteWheel="*res://LS5Framework/Scenes/UI/EmoteWheel.tscn"

[display]

window/size/viewport_width=3400
window/size/viewport_height=1300
window/hdr/request_hdr_output=true
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="New Game Project"

[editor_plugins]

enabled=PackedStringArray("res://addons/ls5_lipsync/plugin.cfg", "res://addons/ls5_surface_attach_import/plugin.cfg", "res://addons/netfox.internals/plugin.cfg", "res://addons/netfox.noray/plugin.cfg", "res://addons/netfox/plugin.cfg")

[global_group]

LevelObjectProxy=""
player=""
level=""
navmesh=""
water=""

