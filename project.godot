[layer_names]

3d_physics/layer_7="No Player Alignment"
3d_physics/layer_8="Attack Pass-Through Objects"
3d_physics/layer_9="Movement Correction"

[liminal_editor]

general/entity_directories=["res://addons/liminal_editor/resources/builtin_entities"]
general/workspace_folder="res://_blender"
general/material_directories=["res://addons/liminal_editor/resources/materials"]
general/geometry_tags=[]
internal/setup_complete=true
profiling/timings_enabled=false

[ls5]

loading/preparation_cache_enabled=false

[physics]

common/physics_jitter_fix=0.0
jolt_physics_3d/simulation/continuous_cd_max_penetration=0.15
jolt_physics_3d/queries/use_enhanced_internal_edge_removal=true
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
rendering_device/driver.ios="vulkan"
rendering_device/driver.macos="vulkan"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
global_illumination/gi/use_half_resolution=true
camera/depth_of_field/depth_of_field_bokeh_quality=2
viewport/hdr_2d=true
global_illumination/sdfgi/frames_to_converge=4
global_illumination/sdfgi/frames_to_update_lights=3
mesh_lod/lod_change/threshold_pixels=0.2

[shader_globals]

water_displacement_enabled={
"type": "bool",
"value": true
}
water_refraction_enabled={
"type": "bool",
"value": true
}
water_normal_maps_enabled={
"type": "bool",
"value": true
}
water_depth_effects_enabled={
"type": "bool",
"value": true
}
water_ssr_enabled={
"type": "bool",
"value": true
}
water_camera_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
